import { ensureEnv, bridgeHealth, startBridgeDaemon, openInspectPage, findChrome } from '../app/ensure-env.mjs';
import { yesterdayPacific, monthStart, PLG_CAMPAIGNS, RC_RANGES, ACTIVE_TYPES, ORDER_TYPES, ORDER_RANGES, PRIORITY_TYPES, PRIORITY_CAMPAIGNS, PRIORITY_DEFAULT_IDS } from '../app/config.mjs';
import { dataDirState, dashboardMode } from '../app/publish.mjs';
import { scanGaps, pacificToday } from '../app/scan-gaps.mjs';
import { catalogSnapshot } from '../app/reports.mjs';
import { SHOP, shopSummary, configFilePath, saveConfigPatch } from '../app/shop-config.mjs';
import { planGapFill, tailSteps, waitBeforeStep, clampGapSec, GAP_DEFAULT_SEC } from './gap-plan.mjs';

const here = dirname(fileURLToPath(import.meta.url));
const APP_DIR = join(here, '..', 'app');
const NODE = process.execPath;
const PORT = Number(process.env.CONSOLE_PORT || SHOP.consolePort);
let OUT_DIR = process.env.REPORT_OUT_DIR || SHOP.runsDir;
const LOG_FILE = join(here, 'console.log');
const DASHBOARD_URL = process.env.DASHBOARD_URL || SHOP.dashboardUrl;

// 新装（或换机器）时「数据」「下载结果」两个目录还不存在：先建好，
// 否则补缺 / 归档会在 scandir 上抛 ENOENT（已踩过一次）。
for (const dir of [OUT_DIR, SHOP.dataDir]) {
  try { mkdirSync(dir, { recursive: true }); } catch { /* 忽略：真写不进去会在下载时报更明确的错 */ }
}

// 活动列表可在运行中热更新（点「刷新活动列表」跑完自动扫描后不用重启控制台）：
// 空数组 = 报表中心后台默认的全部活动，这是默认状态，完全不需要配置。
let plgList = PLG_CAMPAIGNS;
let priorityList = PRIORITY_CAMPAIGNS;
let priorityDefault = PRIORITY_DEFAULT_IDS;
let shopMeta = { shopName: SHOP.shopName, sellerName: SHOP.sellerName || '' };
// null = 还没扫过；true/false = 下载结果目录里有没有 CSV（决定要不要显示「首次使用」引导）
let runsCsvSeen = null;
let runsCsvCheckedAt = 0;

function readJsonFile(path) {
  try { return JSON.parse(readFileSync(path, 'utf8').replace(/^\uFEFF/, '')); } catch { return null; }
}

// 从磁盘重读活动配置：my-shop.json（PLP/PLG + 店铺名）+ app/priority-campaigns.json（活动名池）
function reloadCampaigns() {
  const config = readJsonFile(configFilePath()) || {};
  const normalize = list => (Array.isArray(list) ? list : [])
    .map(c => typeof c === 'string' ? { id: c, name: c } : { id: String(c?.id || ''), name: String(c?.name || c?.id || '') })
    .filter(c => c.id);
  plgList = normalize(config.plgCampaigns);
  const plpIds = (Array.isArray(config.plpCampaigns) ? config.plpCampaigns : []).map(String).filter(Boolean);
  const snapshot = readJsonFile(join(APP_DIR, 'priority-campaigns.json'));
  const owner = String(config.sellerName || shopMeta.sellerName || shopMeta.shopName || '').trim();
  const snapshotOwner = snapshot?.seller || snapshot?.shopName;
  const pool = snapshot && (!snapshotOwner || !owner || snapshotOwner === owner)
    ? normalize(snapshot.campaigns)
        .map(c => ({ ...c, plp: plpIds.includes(c.id) }))
    : plpIds.map(id => ({ id, name: id, plp: true }));
  priorityList = pool;
  priorityDefault = Array.isArray(config.priorityDefaultCampaigns)
    ? config.priorityDefaultCampaigns.map(String)
    : plpIds.filter(id => pool.some(c => c.id === id));
  shopMeta = {
    shopName: String(config.shopName || '').trim() || SHOP.shopName,
    sellerName: String(config.sellerName || shopMeta.sellerName || '').trim()
  };
  return { plgList, priorityList, priorityDefault, shopMeta };
}


// ---------- 运行态 ----------
let child = null;
let scanChild = null;                                // 活动扫描子进程（只读，不影响下载）
let runInfo = null;                                  // { startedAt, args, lines }
// 逐天串行队列：一键补齐全天跑完一天 → 等一会儿 → 再跑下一天（同一天重复提交容易被 eBay 拒）
let seq = null;                                      // { steps, i, gapMs, label, timer }
// 两路并行：流量一路、广告一路（报表中心按「请求行名」排队，PLG 与优先促刊行名相同，
// 这两类并发会互相认领文件，所以广告必须自己串行；流量行名不同，可以和广告同时跑）
let par = null;                                      // { label, queues, runDirs, procs }
let buffer = [];                                     // 最近日志行，供新连接补屏
const clients = new Set();                           // SSE 连接

const j = obj => JSON.stringify(obj);
const say = text => {
  const line = String(text);
  buffer.push(line);
  if (buffer.length > 3000) buffer.shift();
  for (const res of clients) res.write(`data: ${j({ line })}\n\n`);
  try { appendFileSync(LOG_FILE, line + '\n'); } catch { /* 忽略 */ }
};

function broadcast(event, payload) {
  for (const res of clients) res.write(`event: ${event}\ndata: ${j(payload)}\n\n`);
}

// 只读识别店铺名（跑 auto-scan.mjs --seller-only，约 5~10 秒）。成功返回卖家名。
function runSellerScan() {
  return new Promise((resolve, reject) => {
    const proc = spawn(NODE, [join(APP_DIR, 'auto-scan.mjs'), '--seller-only', '--json', '--quiet'], {
      cwd: dirname(APP_DIR), windowsHide: true
    });
    scanChild = proc;
    let out = '';
    proc.stdout.on('data', chunk => { out += String(chunk); });
    proc.stderr.on('data', chunk => { out += String(chunk); });
    const timer = setTimeout(() => {
      try { proc.kill(); } catch { /* 忽略 */ }
      reject(new Error('读取超时：浏览器没有响应，重新打开浏览器再试'));
    }, 60000);
    proc.on('close', () => {
      clearTimeout(timer);
      scanChild = null;
      reloadCampaigns();
      broadcast('shop', { name: shopMeta.shopName, seller: shopMeta.sellerName });
      const line = out.split(/\r?\n/).reverse().find(l => l.startsWith('@@result:'));
      let result = null;
      try { result = line ? JSON.parse(line.slice('@@result:'.length)) : null; } catch { /* 忽略 */ }
      if (result?.ok && result.seller) resolve(result.seller);
      else reject(new Error(result?.error || '没读到卖家名：确认浏览器已登录 eBay 卖家后台'));
    });
  });
}

// ---------- 首次初始化：一次把能拿到的历史数据都下下来，看板一打开就有内容 ----------
// 口径（2026-11-09 实测修正）：eBay 报表中心「按日」粒度只给 今天/昨天/本周/上周，
// 所以**广告数据最多只能按日回溯两周**（上月/自定义必须用 SUMMARY 汇总，没有逐日行）。
// 因此：流量逐日 N 天（能拿满 30 天）；PLG 和优先促刊各下「上周 + 本周」两份按日数据。
function shiftDays(iso, days) {
  const d = new Date(`${iso}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
}

// 返回两路队列：流量·在售 一路，广告 一路（广告内部必须串行：PLG 与优先促刊行名相同）
function firstRunPlan(days = 30) {
  const end = yesterdayPacific();
  const start = shiftDays(end, -(days - 1));
  const base = ['run-download.mjs', '--out', OUT_DIR, '--max-tabs', '10'];
  const traffic = {
    day: `Traffic ${start}~${end}`,
    title: `流量报表（${start} ~ ${end}，逐日 ${days} 份）`,
    // 只跑「逐日」：`--only traffic` 会同时开一条累计报表任务，两条 traffic 请求并行更容易被 eBay 限速。
    // 看板用的是逐日数据；累计报表要的话在控制台单独下载一份就行。
    args: [...base, '--only', 'trafficDaily', '--dates', `${start}..${end}`, '--date', end]
  };
  const active = {
    day: '在售名单',
    title: '在售商品名单（1 份，用于产品/机型归属）',
    args: [...base, '--only', 'active', '--date', end, '--active-type', 'active']
  };
  const plgLast = {
    day: 'PLG 上周',
    title: 'PLG 链接广告（上周，按日）',
    args: [...base, '--only', 'plg', '--date', end, '--plg-unit', 'DAILY', '--plg-range', 'LASTWEEK']
  };
  const plgThis = {
    day: 'PLG 本周',
    title: 'PLG 链接广告（本周，按日）',
    args: [...base, '--only', 'plg', '--date', end, '--plg-unit', 'DAILY', '--plg-range', 'CURRENTWEEK']
  };
  const prLast = {
    day: '优先促刊 上周',
    title: '优先促销刊登（上周，按日：物品刊登 / 关键词 / 活动 / 搜索词）',
    args: [...base, '--only', 'priority', '--date', end,
      '--priority-types', 'listing,keyword,campaign,search',
      '--priority-unit', 'DAILY', '--priority-range', 'LASTWEEK']
  };
  const prThis = {
    day: '优先促刊 本周',
    title: '优先促销刊登（本周，按日：物品刊登 / 关键词 / 活动 / 搜索词）',
    args: [...base, '--only', 'priority', '--date', end,
      '--priority-types', 'listing,keyword,campaign,search',
      '--priority-unit', 'DAILY', '--priority-range', 'CURRENTWEEK']
  };
  const queues = [
    { label: '流量', steps: [traffic, active] },
    { label: '广告', steps: [plgLast, plgThis, prLast, prThis] }
  ];
  const steps = queues.flatMap(q => q.steps);
  return { steps, queues, start, end, days };
}

// 下载结果目录里有没有 CSV：新用户装完第一次打开时用来判断「要不要引导初始化」
function runsCsvCount() {
  let count = 0;
  const walk = dir => {
    if (count > 500) return;
    let entries = [];
    try { entries = readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const entry of entries) {
      if (entry.isDirectory()) walk(join(dir, entry.name));
      else if (entry.name.toLowerCase().endsWith('.csv')) count++;
    }
  };
  if (existsSync(OUT_DIR)) walk(OUT_DIR);
  return count;
}

// ---------- 环境体检 ----------
// 只问常驻桥（毫秒级），不再每次做 8 秒的 WS 握手探测；
// 桥不在就顺手拉起守护，用户不用关心进程在不在。
let lastDaemonTry = 0;
async function envState() {
  let h = await bridgeHealth();
  if (!h && Date.now() - lastDaemonTry > 10000) {
    lastDaemonTry = Date.now();
    startBridgeDaemon();
  }
  // 有没有下载过 CSV：15 秒最多扫一次目录，避免每次轮询都遍历几千个文件
  if (runsCsvSeen === null || (!runsCsvSeen && Date.now() - runsCsvCheckedAt > 15000)) {
    runsCsvSeen = runsCsvCount() > 0;
    runsCsvCheckedAt = Date.now();
  }
  const connected = !!h?.connected;
  return {
    chrome: {
      ok: connected,
      browser: connected ? 'Chrome（常驻连接已在线）' : null,
      reason: connected ? null : (h?.hint || '常驻桥未启动')
    },
    bridge: {
      ok: connected,
      online: !!h,
      phase: h?.phase || (h ? 'reconnecting' : 'offline'),
      needsAuth: !!h?.needsAuth,
      uptimeSec: h?.uptimeSec || 0,
      reconnectTries: h?.reconnectTries || 0,
      hint: h?.hint || '常驻桥未启动'
    },
    running: !!child || !!seq || !!par,
    mode: runInfo?.mode || null,
    runStartedAt: runInfo?.startedAt || null,
    outDir: OUT_DIR,
    dashboard: DASHBOARD_URL,
    // 'online' = 维护者本机（有看板仓库，能推线上）；'local' = 发给运营的包（数据只留本机）
    dashboardMode: dashboardMode(),
    dataState: dataDirState(),
    // 新用户第一次打开：下载结果目录里还没有任何 CSV，就在页面上引导「自动下载最近 30 天」
    firstRun: { needed: !runsCsvSeen, days: 30, outDir: OUT_DIR },
    shop: {
      name: shopMeta.shopName,
      seller: shopMeta.sellerName,
      // 还没识别出店铺名（新装用户）——界面会提示「点一下自动识别」
      placeholder: !shopMeta.shopName || shopMeta.shopName === '我的店铺',
      configFile: configFilePath(),
      // 0 个活动不是错：代表「报表中心后台默认全部活动」，也是最省事的默认状态
      plgCount: plgList.length,
      priorityCount: priorityList.length,
      campaignsMode: (plgList.length || priorityList.length) ? '指定活动' : '后台全部活动'
    },
    defaults: defaultForm(),
    last: lastSummary()
  };
}

function defaultForm() {
  const date = yesterdayPacific();
  return {
    date,
    rangeStart: monthStart(date),
    rangeEnd: date,
    // 空数组不是「没选」：空 = 报表中心后台默认的全部活动，下载侧不传活动参数
    plgCampaigns: plgList.map(c => c.id),
    plgCampaignList: plgList,
    ranges: RC_RANGES,
    activeTypes: Object.entries(ACTIVE_TYPES).map(([key, v]) => ({ key, label: v.label })),
    orderTypes: ORDER_TYPES.map(t => ({ key: t.key, label: t.label, mvp: t.mvp })),
    orderRanges: ORDER_RANGES,
    priorityTypes: PRIORITY_TYPES.map(t => ({ key: t.key, label: t.label, mvp: t.mvp })),
    priorityCampaignList: priorityList,
    priorityDefaultCampaigns: priorityDefault,
    outDir: OUT_DIR
  };
}

function runDirsNewestFirst() {
  if (!existsSync(OUT_DIR)) return [];
  return readdirSync(OUT_DIR)
    .filter(name => /^\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}$/.test(name))
    .map(name => ({ name, at: statSync(join(OUT_DIR, name)).mtimeMs }))
    .sort((a, b) => b.at - a.at)
    .map(item => join(OUT_DIR, item.name));
}

function newestRunDir() {
  return runDirsNewestFirst()[0] || null;
}

function readSummary(dir) {
  const file = join(dir, '结果.json');
  if (!existsSync(file)) return null;
  try {
    const s = JSON.parse(readFileSync(file, 'utf8'));
    return {
      runDir: dir,
      runId: s.runId,
      totalMs: s.totalMs,
      date: s.date,
      rangeStart: s.rangeStart,
      plpStart: s.plpStart,
      plpEnd: s.plpEnd,
      counts: s.counts,
      warnings: s.warnings || [],
      errors: s.errors || [],
      files: (s.files || []).map(f => ({
        name: f.name, kind: f.kind, label: f.label, task: f.task,
        rowCount: f.rowCount, size: f.size, valid: f.valid, problem: f.problem || null,
        folder: (f.path || '').split(/[\\/]/).slice(-2, -1)[0] || ''
      }))
    };
  } catch { return null; }
}

// 只认本次：控制台这次启动后跑出来的结果。服务重开就是空白，不再回退历史目录，
// 免得把上一次的旧文件当成这次的产出。
function lastSummary() {
  if (!runInfo?.runDir) return null;
  return readSummary(runInfo.runDir);
}

// 最近的运行目录（带 结果.json 的），给「补做归档 + 更新看板」下拉框用
function recentRuns(limit = 20) {
  if (!existsSync(OUT_DIR)) return [];
  const out = [];
  for (const entry of readdirSync(OUT_DIR, { withFileTypes: true })) {
    if (!entry.isDirectory()) continue;
    const dir = join(OUT_DIR, entry.name);
    const file = join(dir, '结果.json');
    if (!existsSync(file)) continue;
    try {
      const s = JSON.parse(readFileSync(file, 'utf8'));
      const files = (s.files || []).filter(f => f && f.path && f.valid !== false && !f.problem);
      out.push({
        name: entry.name, dir,
        startedAt: s.startedAt || '',
        only: Array.isArray(s.only) ? s.only : [],
        total: (s.counts?.total ?? (s.files || []).length),
        valid: (s.counts?.valid ?? files.length),
        archived: !!s.apply,
        published: !!s.publish,
        filesReady: files.filter(f => existsSync(f.path)).length
      });
    } catch { /* 坏的 结果.json 跳过 */ }
  }
  return out.sort((a, b) => (a.name < b.name ? 1 : -1)).slice(0, limit);
}

// ---------- 参数拼装 ----------
function buildArgs(form) {
  const out = String(form.outDir || '').trim();
  if (out && !isAbsolute(out)) throw new Error('结果目录要填 Windows 绝对路径');
  if (out.includes('..')) throw new Error('结果目录不能包含 ..');
  const args = ['run-download.mjs', '--out', out || OUT_DIR];
  const only = [];
  const tm = form.trafficMode || 'daily';
  if (tm === 'daily') only.push('trafficDaily');
  if (tm === 'range') only.push('trafficRange');
  if (tm === 'both') only.push('traffic');
  if (tm === 'batch') only.push('trafficDaily');
  if (form.plg) only.push('plg');
  if (form.active) only.push('active');
  if (form.orders) only.push('orders');
  if (form.priority) only.push('priority');
  if (!only.length) throw new Error('至少要选一份报表');

  args.push('--only', only.join(','));
  const maxTabs = Number(form.maxTabs || 4);
  if (Number.isFinite(maxTabs) && maxTabs >= 1 && maxTabs <= 10) args.push('--max-tabs', String(Math.round(maxTabs)));
  args.push('--date', form.date || yesterdayPacific());
  if (tm === 'batch') {
    const dates = String(form.batchDates || '').trim();
    if (!dates) throw new Error('批量模式需要填日期，如 2026-11-01..2026-11-05');
    args.push('--dates', dates);
  }
  if (tm === 'range' || tm === 'both') {
    args.push('--range-start', form.rangeStart);
    if (form.rangeEnd) args.push('--range-end', form.rangeEnd);
  }

  if (form.plg) {
    args.push('--plg-unit', form.plgUnit || 'DAILY');
    if (form.plgRange) args.push('--plg-range', form.plgRange);
    if (form.plgRange === 'CUSTOM') {
      if (!form.plgCustomStart || !form.plgCustomEnd) throw new Error('自定义区间要填起止日期');
      if (form.plgCustomStart > form.plgCustomEnd) throw new Error('自定义区间起始日晚于结束日');
      args.push('--plg-custom-start', form.plgCustomStart, '--plg-custom-end', form.plgCustomEnd);
    }
    // 活动列表：空 = 不传参数 = 报表中心后台默认的全部活动（推荐路径，运营不用管）。
    // 只有明确挑了「一部分活动」才传，用来缩小报表范围。
    const plgPicked = (form.plgCampaigns || []).filter(Boolean);
    if (plgPicked.length && plgList.length && plgPicked.length < plgList.length) {
      args.push('--plg-campaigns', plgPicked.join(','));
    }
  }
  if (form.active) args.push('--active-type', form.activeType || 'active');

  if (form.orders) {
    args.push('--order-type', form.orderType || 'all');
    args.push('--order-range', form.orderRange || 'LAST90D');
    if (form.orderRange === 'CUSTOM') {
      if (!form.orderCustomStart || !form.orderCustomEnd) throw new Error('订单自定义区间要填起止日期');
      if (form.orderCustomStart > form.orderCustomEnd) throw new Error('订单区间起始日晚于结束日');
      args.push('--order-custom-start', form.orderCustomStart, '--order-custom-end', form.orderCustomEnd);
    }
  }

  if (form.priority) {
    const ptypes = (form.priorityTypes || []).filter(Boolean);
    if (!ptypes.length) throw new Error('优先促销刊登至少要选一种报表类型');
    const bad = ptypes.filter(k => !PRIORITY_TYPES.some(t => t.key === k));
    if (bad.length) throw new Error(`优先促销刊登类型不支持：${bad.join(',')}`);
    args.push('--priority-types', ptypes.join(','));
    args.push('--priority-unit', form.priorityUnit || 'DAILY');
    if (form.priorityRange) args.push('--priority-range', form.priorityRange);
    if (form.priorityRange === 'CUSTOM') {
      if (!form.priorityCustomStart || !form.priorityCustomEnd) throw new Error('优先促刊自定义区间要填起止日期');
      if (form.priorityCustomStart > form.priorityCustomEnd) throw new Error('优先促刊区间起始日晚于结束日');
      args.push('--priority-custom-start', form.priorityCustomStart, '--priority-custom-end', form.priorityCustomEnd);
    }
    const pc = (form.priorityCampaigns || []).filter(Boolean);
    const known = new Set(priorityList.map(c => c.id));
    const unknown = pc.filter(id => !known.has(id));
    if (unknown.length) throw new Error(`优先促销刊登活动不在列表里：${unknown.join(',')}`);
    if (pc.length && pc.length < priorityList.length) args.push('--priority-campaigns', pc.join(','));
    else if (priorityList.length && pc.length === priorityList.length) args.push('--priority-campaigns', 'all');
  }
  if (form.keepTabs) args.push('--keep');
  if (form.publish) args.push('--publish');
  else if (form.apply) args.push('--apply');
  return args;
}

// ---------- 一键补齐：扫描缺口 → 组参 → 下载 → 自动归档 + 更新看板 ----------
const dayList = (s, e) => {
  const out = [];
  for (let t = Date.parse(`${s}T00:00:00Z`); t <= Date.parse(`${e}T00:00:00Z`); t += 86400000) {
    out.push(new Date(t).toISOString().slice(0, 10));
  }
  return out;
};
// 报表中心「按日」粒度只给四个预设（实测 2026-11-08）：挑能整体盖住缺口的最小那个
function presetFor(days) {
  if (!days.length) return null;
  const fmt = x => x.toISOString().slice(0, 10);
  const shift = (x, n) => { const y = new Date(x); y.setUTCDate(y.getUTCDate() + n); return y; };
  const t0 = new Date(`${pacificToday()}T00:00:00Z`);
  const w0 = shift(t0, -(((t0.getUTCDay() + 6) % 7)));
  const presets = [
    ['TODAY', fmt(t0), fmt(t0)],
    ['YESTERDAY', fmt(shift(t0, -1)), fmt(shift(t0, -1))],
    ['CURRENTWEEK', fmt(w0), fmt(shift(w0, 6))],
    ['LASTWEEK', fmt(shift(w0, -7)), fmt(shift(w0, -1))]
  ];
  const lo = days[0];
  const hi = days[days.length - 1];
  const hit = presets.find(([, a, b]) => lo >= a && hi <= b);
  return hit ? hit[0] : null;
}

// 等同双击「打开看板.cmd」：交给 open-dashboard.mjs 开浏览器并打印数据位置。
// 之所以不在服务里直接读文件，是因为看板是纯前端 + 浏览器 IndexedDB，只能由浏览器打开。
function openLocalDashboard() {
