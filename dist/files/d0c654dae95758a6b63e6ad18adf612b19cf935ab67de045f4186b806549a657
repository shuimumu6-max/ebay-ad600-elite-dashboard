// 店铺 / 机器配置：迁移到另一家店铺或另一台电脑，只改这一个文件，主链路代码不用动。
//
// 设计原则（2026-11-09 定）：**能自动的一律不要让运营填**。
//   - 店铺名：可空，空着显示「我的店铺」，界面上随时能改；
//   - PLP / PLG 活动：可空，空着就是「报表中心后台默认的全部活动」——
//     报表 CSV 里本来就带 Campaign 列，看板直接读报表，不需要先知道活动 ID；
//   - 只有三个目录（dataDir / runsDir / downloadsDir）必须落盘，安装器已经自动填好。
//
// 两种方式（任选其一）：
//   1. 直接改下面 DEFAULTS 里的值；
//   2. 程序目录放一份 my-shop.json（安装器会自动生成），或用环境变量
//      EBAY_SHOP_CONFIG=C:\path\to\my-shop.json 指向它。
import { readFileSync, existsSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const HERE = dirname(fileURLToPath(import.meta.url));
export const PROJECT_ROOT = dirname(HERE);

// 优先促销刊登的活动池：来自后台 Campaigns 卡片实采快照（只读探查，不是猜的）。
// 没有快照也不影响使用——控制台活动留空就等于「后台默认全部活动」，
// 快照只是让下拉框能显示活动名、方便只挑主力活动。
function readPriorityCampaigns(expectedShop, expectedSeller) {
  try {
    const path = join(HERE, 'priority-campaigns.json');
    if (!existsSync(path)) return [];
    const data = JSON.parse(readFileSync(path, 'utf8'));
    // 迁移到新店铺时不能沿用上一家店的活动：快照带店铺归属，不匹配就忽略。
    // 优先比卖家账号（稳定），没有 seller 字段时才比店铺名。
    const snapshotOwner = data.seller || data.shopName;
    const currentOwner = expectedSeller || expectedShop;
    if (snapshotOwner && currentOwner && snapshotOwner !== currentOwner) {
      console.warn(`[店铺配置] 活动快照属于「${snapshotOwner}」，当前是「${currentOwner}」，已忽略；需要活动名就重跑 node app\\auto-scan.mjs`);
      return [];
    }
    return normalizeCampaigns(data.campaigns);
  } catch { return []; }
}

function normalizeCampaigns(list) {
  return (Array.isArray(list) ? list : [])
    .map(c => typeof c === 'string' ? { id: c, name: c } : { id: String(c?.id || ''), name: String(c?.name || c?.id || '') })
    .filter(c => c.id);
}

