// 当前实际生效的配置文件路径（改名、自动扫描都写回这里）
let activeConfigPath = '';

function readOverride() {
  // 优先级：环境变量 EBAY_SHOP_CONFIG → 程序目录下的 my-shop.json → 内置默认值。
  // 第二个入口专为「不懂环境变量」的运营准备：安装目录里放一个 my-shop.json 就生效。
  const envPath = process.env.EBAY_SHOP_CONFIG;
  const localPath = join(PROJECT_ROOT, 'my-shop.json');
  if (!activeConfigPath) activeConfigPath = envPath || localPath;
  const candidates = envPath ? [envPath, localPath] : [localPath];
  for (const path of candidates) {
    if (!existsSync(path)) {
      if (path === envPath) console.warn(`[店铺配置] EBAY_SHOP_CONFIG 指向的文件不存在：${path}，继续找安装目录的 my-shop.json`);
      continue;
    }
    try {
      const data = JSON.parse(readFileSync(path, 'utf8').replace(/^\uFEFF/, ''));
      activeConfigPath = path;
      console.log(`[店铺配置] 已读取：${path}`);
      return data;
    } catch (error) {
      console.warn(`[店铺配置] 读取失败（${error.message}）：${path}`);
    }
  }
  return {};
}

export const configFilePath = () => activeConfigPath || join(PROJECT_ROOT, 'my-shop.json');

// 改一项配置就写回配置文件（控制台里改店铺名、自动扫描填活动都走这里）。
// 手写 JSON 不用 ConvertTo-Json 之类的工具：那类工具会带 BOM，Node 读回会直接报错。
export function saveConfigPatch(patch) {
  const path = configFilePath();
  let current = {};
  if (existsSync(path)) {
    try { current = JSON.parse(readFileSync(path, 'utf8').replace(/^\uFEFF/, '')); } catch { current = {}; }
  }
  const next = { ...current, ...patch };
  writeFileSync(path, JSON.stringify(next, null, 2) + '\n', 'utf8');
  return path;
}

const override = readOverride();
const shopName = override.shopName === undefined
  ? DEFAULTS.shopName
  : (String(override.shopName).trim() || '我的店铺');
const sellerName = String(override.sellerName || '').trim();

export const SHOP = {
  ...DEFAULTS,
  ...override,
  shopName,
  sellerName,
  // 数组类字段不做浅合并，避免半份旧店铺活动混进新店铺。
  // 空数组是**有效值**，意思是「后台默认的全部活动」——不要回退成 DEFAULTS 里的固定几个。
  plpCampaigns: override.plpCampaigns ?? DEFAULTS.plpCampaigns,
  plgCampaigns: override.plgCampaigns ?? DEFAULTS.plgCampaigns,
  priorityCampaigns: Array.isArray(override.priorityCampaigns)
    ? normalizeCampaigns(override.priorityCampaigns)
    : readPriorityCampaigns(shopName, sellerName),
  // 优先促刊默认勾选：没配就走 plpCampaigns（空 = 后台默认全部）
  priorityDefaultCampaigns: override.priorityDefaultCampaigns ?? (override.plpCampaigns ?? DEFAULTS.plpCampaigns)
};

