export const DASHBOARD_URL = SHOP.dashboardUrl;
export const PLP_CAMPAIGNS = SHOP.plpCampaigns;
export const PLG_CAMPAIGNS = SHOP.plgCampaigns;

// 优先促销刊登活动：快照缺省时退回 PLP 三个，保证控制台不会因为没跑探针而空白
const priorityList = SHOP.priorityCampaigns.length
  ? SHOP.priorityCampaigns
  : SHOP.plpCampaigns.map(id => ({ id, name: id }));
export const PRIORITY_CAMPAIGNS = priorityList.map(c => ({
  id: c.id,
  name: c.name || c.id,
  plp: SHOP.plpCampaigns.includes(c.id)
}));
export const PRIORITY_DEFAULT_IDS = SHOP.priorityDefaultCampaigns
  .filter(id => PRIORITY_CAMPAIGNS.some(c => c.id === id));

export const CONSOLE_PORT = SHOP.consolePort;
export const BRIDGE_PORT = SHOP.bridgePort;

// 启动体检：把生效配置打出来，迁移时一眼看出有没有读对文件
export function shopSummary() {
  return {
    shopName: SHOP.shopName,
    sellerName: SHOP.sellerName,
    configFile: configFilePath(),
    dataDir: DATA_DIR,
    runsDir: RUNS_DIR,
    dashboardUrl: DASHBOARD_URL,
    // 0 不是错：0 表示「后台默认全部活动」，控制台和下载侧都按全部处理
    plpCampaigns: PLP_CAMPAIGNS.length,
    plgCampaigns: PLG_CAMPAIGNS.length,
    priorityCampaigns: PRIORITY_CAMPAIGNS.length,
    priorityDefaultCampaigns: PRIORITY_DEFAULT_IDS.length,
    campaignsMode: (PLP_CAMPAIGNS.length || PLG_CAMPAIGNS.length) ? '指定活动' : '后台全部活动'
  };
}
