// ---------- 以下三种报表类型都从 reports.mjs 派生，不再各写一份 ----------
const byId = id => {
  const r = getReport(id);
  if (!r) throw new Error(`报表注册表缺少 ${id}`);
  return r;
};

const listingReports = REPORTS.filter(r => r.group === 'listings');
const orderReports = REPORTS.filter(r => r.group === 'orders');
// 按报表中心 Type 卡片里的实际顺序排列，页面上的选项顺序与后台一致
const PRIORITY_ORDER = ['KEYWORD', 'LISTING', 'CAMPAIGN', 'SEARCH_QUERY'];
const priorityReports = REPORTS
  .filter(r => r.strategy === 'PL_P')
  .sort((a, b) => PRIORITY_ORDER.indexOf(a.type) - PRIORITY_ORDER.indexOf(b.type));

// 在售 / 非在售 / 预定：键名沿用原来的 active / unsold / scheduled
export const ACTIVE_TYPES = Object.fromEntries(listingReports.map(r => [r.key, {
  type: r.type,
  label: r.label,
  folder: r.folder,
  rowMatch: new RegExp(r.rowMatch, 'i'),
  fileStem: r.fileStem,
  reportId: r.id
}]));

// 订单报表 9 种
export const ORDER_TYPES = orderReports.map(r => ({
