}));

// 优先促销刊登 4 种
export const PRIORITY_TYPES = priorityReports.map(r => ({
  key: r.id.split('.').pop(),
  label: r.label,
  type: r.type,
  hasCampaigns: r.hasCampaigns,
  reportId: r.id,
  mvp: r.implemented !== false
}));

// 报表中心：按卡片顺序逐级选择（Source → 策略/类型 → 活动 → 粒度 → 区间）
function stepsOf(r) {
  const steps = [{ card: 'Source', fragment: `"SOURCE":"${r.sourceId}"` }];
  if (r.strategy) steps.push({ card: 'Campaign strategy', fragment: `"CAMPAIGN_TYPE":"${r.strategy}"` });
  if (r.type) steps.push({ card: 'Type', fragment: `"TYPE":"${r.type}"` });
  if (r.hasCampaigns) steps.push({ card: 'Campaigns' });   // 只在选部分活动时才操作，默认保持全选
  if (r.timeUnit) steps.push({ card: 'Time unit', fragment: '"CAMPAIGN_TIME_UNIT":"DAILY"' });
  if (r.rangeKind === 'orders') steps.push({ card: 'Date range', fragment: '"DATE_RANGE":"LAST90D"' });
  else if (r.rangeKind === 'marketing') steps.push({ card: 'Date range', fragment: '"DATE_RANGE":"CURRENTWEEK"' });
  return steps;
}

const requestOf = id => {
  const r = byId(id);
  return { label: r.label, rowMatch: new RegExp(r.rowMatch, 'i'), steps: stepsOf(r), reportId: r.id };
};

