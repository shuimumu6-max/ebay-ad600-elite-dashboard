// 统一启动后台任务：下载（download.mjs）与只更新看板（publish-only.mjs）共用日志流
function startJob(args, mode, label, onExit) {
  buffer = [];
  runInfo = { startedAt: Date.now(), args, runDir: null, mode };
  say(`[控制台] ${label}：${[NODE, ...args].join(' ')}`);
  broadcast('run', { phase: 'start', args, mode });

  child = spawn(NODE, args, { cwd: APP_DIR, windowsHide: true });
  let tail = '';
  const onData = chunk => {
    tail += chunk.toString('utf8');
    const parts = tail.split(/\r?\n/);
    tail = parts.pop() ?? '';
    for (const line of parts) {
      if (!line.trim()) continue;
      say(line);
      const m = /结果目录：(.*)$/.exec(line);
      if (m && runInfo) runInfo.runDir = m[1].trim();
    }
  };
  child.stdout.on('data', onData);
  child.stderr.on('data', onData);
  child.on('exit', code => {
    if (tail.trim()) say(tail.trim());
    // 只认本次自己报出来的结果目录；失败没报就是没有，不去抓历史目录充数
    const dir = runInfo?.runDir || null;
    if (runInfo) runInfo.runDir = dir;
    say(`[控制台] ${mode === 'publish' ? '看板更新' : mode === 'seller' ? '店铺识别' : '下载'}结束，退出码 ${code}`);
    // 本地看板模式：没有线上看板可推，归档完就是「看板可用」，把下一步说清楚。
    // 只在最后一步说一次——每归档一批就说一遍，日志会刷得人看不见重点。
    if (mode === 'publish' && code === 0 && dashboardMode() === 'local' && (!seq || seq.i + 1 >= seq.total)) {
      say('[控制台] 数据已归档到本机「数据」目录：点右上角「打开看板」就能看，报表会自动加载，不用手动选文件');
    }
    const summary = mode === 'publish' ? null : lastSummary();
    child = null;
    const queueMore = !!seq && (seq.i + 1 < seq.total || seq.thenArchive);
    broadcast('run', {
      phase: 'end', code, mode, summary, dashboard: DASHBOARD_URL,
      dataState: dataDirState(),
      queue: seq ? { index: seq.i + 1, total: seq.total, more: queueMore } : null
    });
    if (onExit) onExit(code);
  });
}

// 逐天串行：每一天跑完等 gapMs，再跑下一天；中间的空档也算「运行中」
// opts.thenArchive：所有下载步骤跑完后，自动补「逐个归档 → 推看板」
function startSequence(steps, label, gapMs, opts = {}) {
  if (!steps.length) return;
  seq = {
    steps, i: 0, gapMs, label, timer: null, total: steps.length,
    runDirs: [], failures: [], thenArchive: !!opts.thenArchive
  };
  say(`[控制台] ${label}：共 ${steps.length} 步串行，步与步之间停 ${Math.round(gapMs / 1000)} 秒`);
  runSeqStep();
}

function runSeqStep() {
  if (!seq) return;
  const step = seq.steps[seq.i];
  const tag = step.title || `第 ${seq.i + 1}/${seq.total} 天（${step.day}）`;
  startJob(step.args, step.mode, `${seq.label} · ${tag}`, code => {
    if (!seq) return;                       // 已被手动停止
    // 店铺识别步骤：把新读到的卖家名 / 活动列表刷进界面（失败不拦后面的下载）
    if (step.mode === 'seller') {
      reloadCampaigns();
      broadcast('shop', { name: shopMeta.shopName, seller: shopMeta.sellerName });
      if (code === 0) say(`[控制台] 店铺已识别：${shopMeta.shopName}`);
    }
    if (step.mode === 'download') {
      const dir = runInfo?.runDir || null;
      if (dir) seq.runDirs.push(dir);
      if (code !== 0) seq.failures.push(`${step.day}（退出码 ${code}）`);
    }
    seq.i++;

    // 下载都跑完了：把「逐个归档 + 推看板」的步骤补到队尾（运行目录要跑完才知道）
    if (seq.i >= seq.total && seq.thenArchive) {
      seq.thenArchive = false;
      const tail = tailSteps(seq.runDirs);
      seq.steps.push(...tail);
      seq.total = seq.steps.length;
      if (!seq.runDirs.length) say('[控制台] 这次没有任何下载成功，直接更新看板');
    }

    if (seq.i >= seq.total) {
      const fails = seq.failures;
      say(`[控制台] ${seq.label} 全部结束：共 ${seq.total} 步`
        + (fails.length ? `，失败 ${fails.length} 步：${fails.join('、')}` : '，全部成功'));
      // 多步任务最后一步是「更新看板」，它没有下载 summary，所以失败明细要在这里单独推给前端，
      // 否则用户只看到进度条走完、不知道该不该再补一次。
      broadcast('run', { phase: 'seq-end', label: seq.label, failures: fails, total: seq.total });
      seq = null;
      return;
    }

    // 等一下步：下载步骤之间要留间隔；归档 / 推看板不用等，跑完立刻接上
    const next = seq.steps[seq.i];
    const waitMs = waitBeforeStep(step, next, seq.gapMs);
    if (waitMs >= 1000) {
      say(`[控制台] ${tag} 结束，等 ${Math.round(waitMs / 1000)} 秒再跑下一步（${next.title || next.day}）…`);
      broadcast('run', { phase: 'gap', waitMs, next: next.title || next.day, index: seq.i + 1, total: seq.total });
      seq.timer = setTimeout(() => { if (seq) { seq.timer = null; runSeqStep(); } }, waitMs);
    } else {
      runSeqStep();
    }
  });
}

function stopSequence() {
  if (!seq) return false;
  if (seq.timer) clearTimeout(seq.timer);
  seq = null;
  return true;
}

// ---------- 两路并行（首次初始化用） ----------
// 收益：2 周的流量报表是最慢的一段（逐日 14 份、串行提交），把广告那几份放到另一路同时跑，
// 总时长就从「流量 + 广告」降到「流量」。
function startParallel(label, queues) {
  buffer = [];
  runInfo = { startedAt: Date.now(), args: [], runDir: null, mode: 'parallel' };
  par = {
    label, startedAt: Date.now(), runDirs: [], procs: new Set(),
    queues: queues.map(q => ({ label: q.label, steps: q.steps, i: 0, running: false, failures: [] }))
  };
  say(`[控制台] ${label}：${queues.length} 路并行（${queues.map(q => q.label).join(' / ')}）；同一路内部仍然串行，避免报表中心认错文件`);
  broadcast('run', { phase: 'start', mode: 'parallel' });
  pumpParallel();
}

function pumpParallel() {
  if (!par) return;
  for (const q of par.queues) {
    if (!q.running && q.i < q.steps.length) spawnQueueStep(q);
  }
  if (par.queues.every(q => !q.running && q.i >= q.steps.length)) finishParallel();
}

function spawnQueueStep(q) {
  const step = q.steps[q.i];
  q.running = true;
  say(`[控制台] [${q.label}] 开始：${step.title || step.day}`);
  const proc = spawn(NODE, step.args, {
    cwd: APP_DIR,
    windowsHide: true,
    // 并行时两路共用同一个浏览器窗口，谁都不许清「历史 /sh 页」，否则会把另一路的页面关掉
    env: { ...process.env, EBAY_KEEP_TABS: '1' }
  });
  par.procs.add(proc);
  let tail = '';
  const onData = chunk => {
    tail += chunk.toString('utf8');
    const parts = tail.split(/\r?\n/);
    tail = parts.pop() ?? '';
    for (const line of parts) {
      if (!line.trim()) continue;
      say(`[${q.label}] ${line}`);
      const m = /结果目录：(.*)$/.exec(line);
      if (m && par) par.runDirs.push(m[1].trim());
    }
  };
  proc.stdout.on('data', onData);
  proc.stderr.on('data', onData);
  proc.on('exit', code => {
    if (tail.trim()) say(`[${q.label}] ${tail.trim()}`);
    par?.procs.delete(proc);
    q.running = false;
    if (code !== 0) q.failures.push(`${step.title || step.day}（退出码 ${code}）`);
    q.i++;
    pumpParallel();
  });
}

function finishParallel() {
  if (!par) return;
  const { label, queues, runDirs, startedAt } = par;
  const fails = queues.flatMap(q => q.failures);
  const mins = Math.round((Date.now() - startedAt) / 60000 * 10) / 10;
  say(`[控制台] ${label} 全部结束：用时 ${mins} 分钟，得到 ${runDirs.length} 个结果目录`
    + (fails.length ? `，失败 ${fails.length} 步：${fails.join('、')}` : '，全部成功'));
  par = null;
  runInfo = null;
  broadcast('run', { phase: 'end', code: fails.length ? 1 : 0, mode: 'parallel', summary: lastSummary(), dashboard: DASHBOARD_URL, dataState: dataDirState() });
}

function stopParallel() {
  if (!par) return false;
  for (const proc of par.procs) { try { proc.kill(); } catch { /* 忽略 */ } }
  par = null;
  runInfo = null;
  return true;
}

// ---------- HTTP ----------
function send(res, code, body, type = 'application/json; charset=utf-8') {
  res.writeHead(code, { 'Content-Type': type, 'Cache-Control': 'no-store' });
  res.end(typeof body === 'string' ? body : j(body));
}

function readBody(req) {
  return new Promise((resolve, reject) => {
    let data = '';
    req.on('data', chunk => { data += chunk; if (data.length > 1e6) reject(new Error('请求过大')); });
    req.on('end', () => { try { resolve(data ? JSON.parse(data) : {}); } catch { reject(new Error('请求不是合法 JSON')); } });
    req.on('error', reject);
  });
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, 'http://127.0.0.1');
  const path = url.pathname;

  try {
    if (path === '/' || path === '/index.html') {
      const file = join(here, 'index.html');
      return send(res, 200, readFileSync(file, 'utf8'), 'text/html; charset=utf-8');
    }
    if (path === '/api/state') return send(res, 200, await envState());

    // 改店铺名：名字只是个标签，界面上随手改，写回 my-shop.json
    if (path === '/api/shop-name' && req.method === 'POST') {
      const body = await readBody(req);
      const name = String(body.name || '').trim().slice(0, 40);
      try {
        const saved = saveConfigPatch({ shopName: name });
        shopMeta.shopName = name || SHOP.shopName;
        broadcast('shop', { name: shopMeta.shopName });
        say(`[控制台] 店铺名已改为「${shopMeta.shopName}」（写入 ${saved}）`);
        return send(res, 200, { ok: true, name: shopMeta.shopName, file: saved });
      } catch (error) {
        return send(res, 500, { ok: false, error: `保存失败：${error.message}` });
      }
    }

    // 识别店铺名：只读浏览器里的卖家账号，几秒完成，不碰活动列表、不下载。
    // 新装用户第一次点「识别 / 改名」就走这里，不需要手填店铺名。
    if (path === '/api/detect-shop' && req.method === 'POST') {
      if (child || seq || scanChild || par) return send(res, 409, { ok: false, error: '有任务在跑，等它结束再识别' });
      const state = await bridgeHealth().catch(() => null);
      if (!state?.connected) {
        return send(res, 200, { ok: false, error: '浏览器还没连上：先点页面顶部的「去开开关」，再点一次识别' });
      }
      try {
        const name = await runSellerScan();
        say(`[控制台] 店铺已识别：${name}`);
        return send(res, 200, { ok: true, name, seller: shopMeta.sellerName });
      } catch (error) {
        return send(res, 200, { ok: false, error: error.message });
      }
    }

    // 刷新活动列表（可选功能）：只读扫描报表中心的 Campaigns 卡片，把活动名填进下拉框。
    // 不点也完全能用——活动留空就是「后台默认全部活动」。
    if (path === '/api/auto-scan' && req.method === 'POST') {
      if (scanChild || child || seq || par) return send(res, 409, { ok: false, error: '有任务在跑，等它结束再刷新活动列表' });
      say('[控制台] 开始扫描报表中心的活动列表（只读，不提交任何下载）…');
      const proc = spawn(NODE, [join(APP_DIR, 'auto-scan.mjs'), '--json'], { cwd: dirname(APP_DIR), windowsHide: true });
      scanChild = proc;
      let out = '';
      const onData = chunk => {
        const text = String(chunk);
        out += text;
        for (const line of text.split(/\r?\n/)) {
          if (!line.trim() || line.startsWith('@@')) continue;
          say(line);
        }
      };
      proc.stdout.on('data', onData);
      proc.stderr.on('data', onData);
      proc.on('close', code => {
        scanChild = null;
        const lists = reloadCampaigns();
        const payload = { ok: code === 0, ...lists };
        const resultLine = out.split(/\r?\n/).reverse().find(l => l.startsWith('@@result:'));
        if (resultLine) {
          try { payload.result = JSON.parse(resultLine.slice('@@result:'.length)); } catch { /* 忽略 */ }
        }
        say(code === 0
          ? `[控制台] 活动列表已刷新：PLG ${lists.plgList.length} 个 / 优先促刊 ${lists.priorityList.length} 个`
          : '[控制台] 活动扫描没成功，不影响使用：留空就是后台全部活动，直接下载即可');
        broadcast('scan-done', payload);
        broadcast('shop', { name: shopMeta.shopName });
      });
      return send(res, 200, { ok: true, started: true });
    }

    // 需要授权时：拉起守护 + 在浏览器里打开开关页面，用户拨一次即可
    if (path === '/api/fix-env' && req.method === 'POST') {
      if (!findChrome()) return send(res, 500, { ok: false, error: '没找到 Chrome 安装路径' });
      startBridgeDaemon();
      const opened = openInspectPage();
      say(opened
        ? '[控制台] 已打开 chrome://inspect 开关页面：把 Allow remote debugging 拨到开，之后就不用再管了'
        : '[控制台] 请在浏览器地址栏打开 chrome://inspect/#remote-debugging 并拨开开关');
      return send(res, 200, { ok: opened, needsAuth: true });
    }

    if (path === '/api/preview' && req.method === 'POST') {
      const form = await readBody(req);
      try { return send(res, 200, { ok: true, command: [NODE, ...buildArgs(form)].join(' ') }); }
      catch (error) { return send(res, 200, { ok: false, error: error.message }); }
    }

    if (path === '/api/logs') {
      res.writeHead(200, {
        'Content-Type': 'text/event-stream; charset=utf-8',
        'Cache-Control': 'no-store',
        Connection: 'keep-alive'
      });
      res.write('retry: 2000\n\n');
      res.write(`event: snapshot\ndata: ${j({ lines: buffer.slice(-400) })}\n\n`);
      clients.add(res);
      const ping = setInterval(() => res.write(': ping\n\n'), 20000);
      req.on('close', () => { clearInterval(ping); clients.delete(res); });
      return;
    }

    // 首次初始化：一键下载「上周 + 本周」（Traffic 逐日 + PLG 上周/本周 + 优先促刊 + 在售名单）。
    // 目的是让新装的人打开看板就有数据，不用先研究「该下哪些报表、什么粒度」。
    if (path === '/api/first-run' && req.method === 'POST') {
      if (child || seq || scanChild || par) return send(res, 409, { ok: false, error: '已有任务在跑，先等它结束' });
      const body = await readBody(req).catch(() => ({}));
      const plan = firstRunPlan();
      if (body.dryRun) {
        return send(res, 200, {
          ok: true, dryRun: true, start: plan.start, end: plan.end,
          queues: plan.queues.map(q => ({ label: q.label, steps: q.steps.map(s => ({ day: s.day, title: s.title })) })),
          steps: plan.steps.map(s => ({ day: s.day, title: s.title, args: s.args }))
        });
      }
      // 第 1 步永远是「跟店铺后台连上」：连不上就直接说，不要让人等半小时才发现
      const state = await bridgeHealth().catch(() => null);
      if (!state?.connected) {
        return send(res, 409, { ok: false, needsConnect: true, error: CONNECT_FIRST });
      }
      say(`[控制台] 首次初始化：流量 ${plan.days} 天（${plan.start} ~ ${plan.end}，上周 + 本周）+ 在售名单 + 广告（上周/本周），多入口并行下载；全程只读，不改动任何已有数据`);
      // 先把店铺名读出来（只读，几秒），读不到也不拦着下载
      try { await runSellerScan(); } catch (error) { say(`[控制台] 店铺名没读到（不影响下载）：${error.message}`); }
      // 一步一步来：实测两路并行时，两个进程抢同一个浏览器窗口和同一个下载目录，
      // 流量那一摞会大量失败（7 天只拿到 3 天）——宁可控场慢一点，也不要下不全。
      // thenArchive：下完自动归档进「数据」，不用再让用户找「归档」按钮（小白最容易卡在这一步）。
      startSequence(plan.steps.map(step => ({ ...step, mode: 'download' })), `首次初始化（${plan.start} ~ ${plan.end}）`, 0, { thenArchive: true });
      return send(res, 200, {
        ok: true, started: true, start: plan.start, end: plan.end, days: plan.days,
        queues: plan.queues.map(q => ({ label: q.label, steps: q.steps.map(s => ({ day: s.day, title: s.title })) }))
      });
    }

    // 一键补齐：扫描正式目录的缺口 → 只下载缺的那些 → 归档 → 更新看板
    // 口径（2026-11-08 定）：看板日更 = 流量单日 + PLG 链接广告 + PLP 链接广告（走 campaign 页）
    if (path === '/api/gap-fill' && req.method === 'POST') {
      if (child || seq || par) return send(res, 409, { ok: false, error: '已有任务在跑，先等它结束' });
      if (!(await requireBrowser(res))) return;
      // 补齐范围和界面上「体检区间」保持一致：看到的是「上周 + 本周」，补的也只补这个区间，
      // 不会因为你选了个短区间，后台反而去补几个月的窟窿。
      const form = await readBody(req).catch(() => ({}));
      const scanRange = clampScanRange(form.range !== undefined ? form.range : form.days);
      let scanned;
      try { scanned = await scanGaps({ dashboardUrl: DASHBOARD_URL, range: scanRange }); }
      catch (error) { return send(res, 500, { ok: false, error: `扫描失败：${error.message}` }); }
      const byKey = Object.fromEntries(scanned.rows.map(r => [r.key, r]));
      const winStart = scanned.windowStart;
      const winEnd = scanned.windowEnd;
      // dryRun：只回「打算怎么补」，不真的下载（自检与 AI 安装说明用，避免误跑十几分钟）
      const dryRun = !!form.dryRun;
      const reply = (payload) => {
        if (!dryRun) return send(res, 200, payload);
        return send(res, 200, {
          ok: true, dryRun: true, started: false,
          mode: payload.mode || (payload.started ? 'gap' : 'none'),
          message: payload.message || null,
          scanRange, windowStart: winStart, windowEnd: winEnd,
          days: payload.days || [], start: payload.start, end: payload.end,
          steps: (payload.steps || []).map(x => ({ day: x.day, title: x.title || null }))
        });
      };

      // 情形一：一条数据都没有（全新安装 / 换电脑）→ 等价于「首次初始化」。
      // 下载结果里已经有上次跑出来的报表时先归档那批，别让人白下一遍。
      if (scanned.allEmpty) {
        const pending = newestRunDir();
        const pendingCsv = pending ? countCsv(pending) : 0;
        if (pendingCsv > 0) {
          say(`[控制台] 正式目录还没有数据，但下载结果里有现成的（${basename(pending)}，${pendingCsv} 份 CSV）：先归档它并更新看板`);
          if (!dryRun) startSequence(tailSteps([pending]), '归档 + 更新看板', 0);
          return reply({
            ok: true, started: true, mode: 'archive',
            scanRange, windowStart: winStart, windowEnd: winEnd,
            message: `下载结果里有 ${pendingCsv} 份现成报表，已开始归档并更新看板；回来看还缺就再点一次`
          });
        }
        const plan = firstRunPlan();
        say(`[控制台] 体检发现正式目录一条数据都没有：按首次初始化下载「上周 + 本周」（${plan.start} ~ ${plan.end}，流量逐日 + 在售名单 + 广告），跑完自动归档并更新看板`);
        try { await runSellerScan(); } catch (error) { say(`[控制台] 店铺名没读到（不影响下载）：${error.message}`); }
        if (!dryRun) startSequence(plan.steps.map(step => ({ ...step, mode: 'download' })), `首次初始化（${plan.start} ~ ${plan.end}）`, 0, { thenArchive: true });
        return reply({
          ok: true, started: true, mode: 'first-run', days: plan.days, start: plan.start, end: plan.end,
          scanRange, windowStart: winStart, windowEnd: winEnd,
          message: `还没有任何数据，已按首次初始化开始下载「上周 + 本周」（${plan.start} ~ ${plan.end}），跑完自动归档并更新看板`
        });
      }

      // 情形二：有数据但存在缺口 → 逐天补齐（某类从零开始的话，整个区间都要下）
      const daysOf = key => {
        const r = byKey[key];
        if (!r) return [];
        if (r.nothingYet) return dayList(r.windowStart, r.windowEnd);
        return (r.missingRanges || []).flatMap(x => dayList(x.start, x.end));
      };
      const trafficDays = daysOf('trafficDaily');
      const plgDays = daysOf('plg');
      // PLG 按日只有 今天/昨天/本周/上周：缺口跨两周就拆成两步，超出上周的日子只能跳过并说明
      const { groups: plgGroups, unfillable: plgUnfillable } = groupPlgByPreset(plgDays, pacificToday());
      const plgFillable = plgDays.filter(d => !plgUnfillable.includes(d));
      if (plgUnfillable.length) {
        say(`[控制台] PLG 有 ${plgUnfillable.length} 天（${plgUnfillable[0]} ~ ${plgUnfillable[plgUnfillable.length - 1]}）超出 eBay「按日」可选范围（最早只到上周），这几天补不了，先补能补的`);
      }
      // PLP 走 campaign 页通道，必须知道具体活动；活动留空（= 后台全部）时这一路补不了，
      // 直接跳过 PLP、只补流量和 PLG，不让用户卡在一个他没法填的配置项上。
      // 只补物品列表（Listing）：关键词 / 搜索词默认不下载，体检里只是「仅提醒」，不参与补齐
      const plpDaysRaw = [...new Set(daysOf('plpListing'))].sort();
      const plpDays = priorityDefault.length ? plpDaysRaw : [];
      if (!priorityDefault.length && plpDaysRaw.length) {
        say(`[控制台] 跳过 PLP 补齐：当前没指定活动（${plpDaysRaw.length} 天缺口）。PLP 报表需要具体活动，需要补就在「优先促刊」里勾几个活动。`);
      }

      if (!trafficDays.length && !plgGroups.length && !plpDays.length) {
        return reply({
          ok: true, started: false,
          message: plgUnfillable.length
            ? `只剩 ${plgUnfillable.length} 天 PLG 超出 eBay 可选范围，补不了；可以直接「只更新看板」`
            : '没有缺口，直接更新看板就行'
        });
      }

      const allDays = [...new Set([...trafficDays, ...plpDays])].sort();
      // 步与步之间停几秒（默认 8 秒）：现在一个进程里批量跑，步骤只剩「流量+PLP / PLG 上周 / PLG 本周」三步左右，
      // 不同报表类型之间不需要等一分半；真被限速时下载脚本自己会放慢并止损
      const gapSec = clampGapSec(form.gapSec);
      const { steps } = planGapFill({
        trafficDays, plgDays: plgFillable, plpDays, plgGroups,
        outDir: OUT_DIR, campaigns: priorityDefault, gapSec
      });
      if (!dryRun) startSequence(steps, '一键补齐缺口', gapSec * 1000, { thenArchive: true });
      return reply({
        ok: true, started: true, gapSec,
        scanRange, windowStart: winStart, windowEnd: winEnd,
        days: allDays,
        steps: steps.map(s => ({ day: s.day, args: s.args })),
        plan: {
          trafficDays,
          plgDays: plgFillable,
          plgUnfillable,
          plgPreset: plgGroups.length === 1 ? plgGroups[0].preset : (plgGroups.map(g => g.preset).join(' + ') || null),
          plpDays,
          plpRange: plpDays.length ? [plpDays[0], plpDays[plpDays.length - 1]] : null
        }
      });
    }

    if (path === '/api/run' && req.method === 'POST') {
      if (child || seq || par) return send(res, 409, { ok: false, error: '已经有一次下载在跑，先停止或等它结束' });
      if (!(await requireBrowser(res))) return;
      const form = await readBody(req);
      let args;
      try { args = buildArgs(form); } catch (error) { return send(res, 400, { ok: false, error: error.message }); }
      const customOut = String(form.outDir || '').trim();
      if (customOut) OUT_DIR = customOut;
      startJob(args, 'download', '开始下载');
      return send(res, 200, { ok: true, args });
    }

    // 只更新看板：拿正式目录里已归档的数据重新生成 data.js 并推送 GitHub Pages
    if (path === '/api/publish' && req.method === 'POST') {
      if (child || seq || par) return send(res, 409, { ok: false, error: '正在跑别的任务，等它结束再更新看板' });
      // 本地看板模式（运营的机器）没有线上看板可推：数据归档完看板就有了，直接把看板打开
      if (dashboardMode() === 'local') {
        openLocalDashboard();
        return send(res, 200, { ok: true, local: true, message: '数据已在本机，已帮你打开看板' });
      }
      startJob(['publish-only.mjs'], 'publish', '只更新看板（不下载）');
      return send(res, 200, { ok: true });
    }

    // 打开本地看板（本地模式专用）
    if (path === '/api/open-dashboard' && req.method === 'POST') {
      if (!existsSync(join(APP_DIR, 'open-dashboard.mjs'))) return send(res, 404, { ok: false, error: '这个版本的包里没有看板启动器' });
      openLocalDashboard();
      return send(res, 200, { ok: true });
    }

    // 最近几次运行：给「补做归档 + 更新看板」用
    if (path === '/api/runs') return send(res, 200, { ok: true, runs: recentRuns() });

    // 对已完成的运行补做「归档 + 更新看板」：不重新下载，直接按 结果.json 归档再推看板
    if (path === '/api/archive-publish' && req.method === 'POST') {
      if (child || seq || par) return send(res, 409, { ok: false, error: '正在跑别的任务，等它结束再归档' });
      const form = await readBody(req);
      const runDir = String(form.runDir || '').trim();
      if (runDir && !isAbsolute(runDir)) return send(res, 400, { ok: false, error: '运行目录要填绝对路径' });
      const args = ['archive-publish.mjs'];
      if (runDir) args.push('--run', runDir);
      const tag = runDir ? runDir.split(/[\\/]/).filter(Boolean).pop() : '最近一次运行';
      startJob(args, 'publish', `归档 + 更新看板（${tag}）`);
      return send(res, 200, { ok: true });
    }

    if (path === '/api/data-state') return send(res, 200, { ok: true, state: dataDirState(), dashboard: DASHBOARD_URL });

    // 报表注册表 + 字段字典：控制台「字段」页用，静态数据，直接从 reports.mjs 读
    if (path === '/api/catalog') return send(res, 200, { ok: true, ...catalogSnapshot() });

    // 看板数据体检：正式目录里每类报表哪天有、哪天缺（今天与上架前不算缺）
    if (path === '/api/scan') {
      const scanRange = clampScanRange(url.searchParams.get('range') !== null
        ? url.searchParams.get('range')
        : url.searchParams.get('days'));
      const report = await scanGaps({ dashboardUrl: `${DASHBOARD_URL}data.js`, range: scanRange });
      say(`[控制台] 体检完成：${report.rows.length} 类报表，区间 ${report.windowStart} ~ ${report.windowEnd}`
        + `（${report.windowDays} 天），共缺 ${report.totalMissing} 天`);
      return send(res, 200, report);
    }

    if (path === '/api/stop' && req.method === 'POST') {
      const hadSeq = stopSequence();
      const hadPar = stopParallel();
      if (!child) {
        if (hadSeq) say('[控制台] 已停止逐天补齐队列（等待中的下一步不再执行）');
        if (hadPar) say('[控制台] 已停止两路并行下载（流量 / 广告都停了）');
        return send(res, 200, { ok: true, stopped: hadSeq || hadPar });
      }
      child.kill();
      say(hadSeq
        ? '[控制台] 已请求停止当前下载，逐天队列一并取消'
        : '[控制台] 已请求停止当前下载');
      return send(res, 200, { ok: true, stopped: true });
    }

    if (path === '/api/last') return send(res, 200, { ok: true, summary: lastSummary() });

    if (path === '/api/open' && req.method === 'POST') {
      const dir = (lastSummary()?.runDir) || newestRunDir() || OUT_DIR;
      spawn('explorer.exe', [dir], { detached: true, stdio: 'ignore' }).unref();
      return send(res, 200, { ok: true, dir });
    }

    return send(res, 404, { ok: false, error: '没有这个接口' });
  } catch (error) {
    return send(res, 500, { ok: false, error: error.message });
  }
});

const URL_SELF = `http://127.0.0.1:${PORT}`;
function openBrowser() {
  try {
    spawn('cmd.exe', ['/c', 'start', '', URL_SELF], { detached: true, stdio: 'ignore', windowsHide: true }).unref();
  } catch { /* 打不开就让用户手动点 */ }
}

server.on('error', error => {
  if (error.code === 'EADDRINUSE') {
    console.log('[控制台] 已经在运行了，直接帮你打开页面');
    openBrowser();
    setTimeout(() => process.exit(0), 600);
    return;
  }
  console.error('[控制台] 启动失败：' + error.message);
  process.exit(1);
});

server.listen(PORT, '127.0.0.1', () => {
  console.log(`[控制台] 已启动： ${URL_SELF}`);
  console.log(`[控制台] 店铺配置：${JSON.stringify(shopSummary())}`);
  console.log(`[控制台] 输出目录：${OUT_DIR}`);
  console.log('[控制台] 这个窗口保持开着就行，可以最小化；关掉窗口服务就停了（下载与常驻桥不受影响）。');
  if (!process.env.NO_OPEN) openBrowser();

  // 后台把常驻桥拉起来。连不上才提示，正常情况这里悄无声息。
  ensureEnv({
    openInspect: false,
    waitAuthMs: 0,
    onLog: text => say('[控制台] ' + text)
  }).then(r => {
    if (r.ok) {
      say('[控制台] 常驻连接已在线，本次及以后都不需要再点允许');
    } else if (r.needsAuth) {
      say('[控制台] 浏览器调试开关是关的：需要拨一次开关。点页面右上角「去开开关」即可，拨好后不用重启任何东西');
      broadcast('env', { needsAuth: true });
    } else if (r.reason) {
      say('[控制台] ' + r.reason);
    }
  }).catch(error => say('[控制台] 环境检查失败：' + error.message));
});
