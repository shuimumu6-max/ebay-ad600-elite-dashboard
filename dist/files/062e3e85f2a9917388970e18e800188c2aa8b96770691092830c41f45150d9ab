- 线上发布、正式分发目录、报表下载均未执行。
`;
const reportTargets = [join(DRILL, '迁移演练报告.md'), join(ROOT, 'docs', '迁移演练报告.md')];
let reportPath = '';
for (const target of reportTargets) {
  try {
    mkdirSync(dirname(target), { recursive: true });
    writeFileSync(target, report, 'utf8');
    reportPath = target;
    break;
  } catch { /* 试下一个落点 */ }
}

console.log(`\n演练结果：${passed}/${checks.length} 通过${failed ? `，失败 ${failed} 项` : '，全绿'}`);
console.log(reportPath ? `报告：${reportPath}` : '报告：无法落盘（只读环境），以上断言结果即全部结论。');
