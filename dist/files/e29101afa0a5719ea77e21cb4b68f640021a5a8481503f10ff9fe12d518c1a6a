// eBay AD600 Elite 报表一键下载（固定脚本）
// 用法：node download.mjs --date 2026-11-05 [--range-start 2026-11-01] [--only traffic,plg,active,plp]
//                        [--latest] [--apply] [--publish] [--keep] [--max-tabs N] [--help]
// 结构：任务数不限，同一时刻最多 MAX_TABS（≤10）个标签页在跑，其余任务排队。
// 报表中心是账号级请求队列，PLG / 优先促刊 / 名单 / 订单这几类统一串行提交，避免认错文件；
// Traffic 与 PLP 不共享该队列，仍可并行。
// 默认：把选中的报表下载到独立 runs/<时间>/ 目录并校验，不写正式目录、不更新看板。
import { spawn } from 'node:child_process';
import { copyFileSync, existsSync, mkdirSync, readdirSync, unlinkSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';
import {
  RUNS_DIR, FOLDERS, FAST, PLP_POLL, RC_POLL, CAMPAIGNS, RC_REQUESTS, ACTIVE_TYPES, PLG_CAMPAIGNS,
  ORDER_TYPES, ORDER_RANGES, PRIORITY_TYPES, PRIORITY_DEFAULT_IDS,
  TRAFFIC_URL, REPORTS_URL, CAMPAIGN_URL, DEFAULT_DOWNLOAD_DIR,
  yesterdayPacific, monthStart, toUsPeriodStart
} from './config.mjs';
import {
  health, ensureBridge, evaluate, cdp, setDownloadDir, waitForNewFiles, sleep, completedDownload, withDownloadLock,
  probe, markFatal, fatalReason
} from './cdp.mjs';
import { openTab } from './pages.mjs';
import { retry, recoverIfBlocked, clickDownload, discard, assertLoggedIn, BlockedError, isBlocked, isBlockedError } from './engine.mjs';
import { inspectCsv, checkExpected, sha256File } from './inspect.mjs';
import { applyFiles, publishDashboard, dataDirState } from './publish.mjs';
import { getReport } from './reports.mjs';

// ---------- 参数 ----------
const raw = process.argv.slice(2);
const flag = name => raw.includes(`--${name}`);
const value = (name, fallback) => {
  const i = raw.indexOf(`--${name}`);
  return i >= 0 && raw[i + 1] && !raw[i + 1].startsWith('--') ? raw[i + 1] : fallback;
};
if (flag('help')) {
  console.log(`eBay AD600 Elite 报表一键下载
  node download.mjs --date 2026-11-05 [--range-start 2026-11-01]
  --date          目标统计日，默认按太平洋时间取昨天
  --range-start   累计 Traffic 起始日，默认目标月 1 日
  --range-end     累计 Traffic 结束日，默认等于 --date
  --only          只跑指定任务：traffic,trafficDaily,trafficRange,plg,active,orders,priority,plp（控制台默认 trafficDaily,priority；plp 仅 CLI 保留）
  --active-type   名单类型：active 全部在售（默认）/ unsold 非在售 / scheduled 预定
  --order-type    订单报表类型：all（默认）/ unpaid / unshipped / overdue / due24h / express / paidShipped / paidNoFeedback / shippedNoFeedback
  --order-range   订单日期范围：TODAY/YESTERDAY/CURRENTWEEK/LASTWEEK/CURRENTMONTH/PREVIOUSMONTH/CURRENTYEAR/PREVIOUSYEAR/LAST90D/CUSTOM
  --order-custom-start / --order-custom-end  订单自定义区间起止日
  --priority-types 优先促销刊登类型，可多选（逗号分隔）：keyword,listing,campaign,search（默认 keyword）
  --priority-type 兼容别名：只接受单值，--priority-types 优先
  --priority-unit 优先促刊时间粒度：DAILY（默认）或 SUMMARY
  --priority-range 优先促刊日期范围（同 --plg-range 的 8 个值；支持逗号分隔多预设）
  --priority-custom-start / --priority-custom-end  优先促刊自定义区间起止日
  --priority-campaigns 优先促刊活动 ID（逗号分隔，默认 PLP 3 个；传 all = 全部 31 个活动）
  --latest        报表中心不新提交请求，直接下载最新一条已完成请求（最快）
  --dates         批量单日 Traffic：--dates 2026-11-01..2026-11-05 或 2026-11-01,2026-11-03
  --plp-start     PLP 报表起始日（默认等于 --date）
  --plp-end       PLP 报表结束日（默认等于起始日；不等于起始日即按区间生成）
  --plp-days      PLP 按日逐个出：逗号分隔的日期（campaign 页没有「按日」粒度，只能起止=同一天）
  --plp-types     PLP 报表类型，逗号分隔：listing,keyword,search（默认三类全要）
  --plg-unit      PLG 链接广告时间粒度：DAILY（默认）或 SUMMARY
  --plg-range     PLG 日期范围：TODAY/YESTERDAY/CURRENTWEEK/LASTWEEK/CURRENTMONTH/PREVIOUSMONTH/LAST90D/CUSTOM（支持逗号分隔多预设，如 LASTWEEK,CURRENTWEEK）
  --plg-custom-start / --plg-custom-end  --plg-range CUSTOM 时的起止日
  --plg-campaigns 只跑指定活动，逗号分隔（活动 ID 各店铺不同，从控制台活动列表里看），默认全部活动
  --campaigns     只跑指定 campaign（PLP 用，逗号分隔，默认配置里那三个）
  --plp-serial    PLP 三个 campaign 改为逐个跑（排查问题时用，默认并发更快）
  --apply         把校验通过的 CSV 复制进正式目录 90-待处理
  --publish       在 --apply 之后运行看板更新并 git push（GitHub Pages）
  --keep          结束后保留任务标签页（调试用；默认自动关闭，只留一个空白页保住调试授权）
  --help          显示本说明
  一个标签页只做一个报表任务，全部开在同一窗口；依赖已登录的 Chrome。`);
  process.exit(0);
}

const date = value('date', yesterdayPacific());
const rangeStart = value('range-start', monthStart(date));
const rangeEnd = value('range-end', date);
// 参数类错误不走 stack trace：控制台会把 stdout 原样显示给用户，
// 一屏 at async ... 只会让人以为程序崩了。统一打一行中文并把退出码置 1。
const abort = message => {
  console.error(`[错误] ${message}`);
  process.exit(1);
};

if (!/^\d{4}-\d{2}-\d{2}$/.test(date) || !/^\d{4}-\d{2}-\d{2}$/.test(rangeStart) || !/^\d{4}-\d{2}-\d{2}$/.test(rangeEnd)) {
  abort('日期格式必须为 YYYY-MM-DD');
}
if (rangeEnd < rangeStart) abort(`累计结束日 ${rangeEnd} 早于起始日 ${rangeStart}`);
const latest = flag('latest');
// 默认保留所有任务标签页：关掉后再开容易触发 Chrome 重新授权
const keepWindows = flag('keep');   // 默认关掉本轮任务标签页；--keep 才保留（调试用）
const shouldApply = flag('apply') || flag('publish');
const shouldPublish = flag('publish');
const onlyArg = value('only', 'traffic,plg,active,plp');
const only = new Set(onlyArg.split(',').map(x => x.trim()).filter(Boolean));

// ---------- 报表级选项（控制台传入；全部有安全默认值，命令行直接跑与以前行为一致） ----------
const isIso = s => /^\d{4}-\d{2}-\d{2}$/.test(s);
const plpStart = value('plp-start', date);
const plpEnd = value('plp-end', plpStart);
if (!isIso(plpStart) || !isIso(plpEnd)) throw new Error('PLP 日期格式必须为 YYYY-MM-DD');
if (plpStart > plpEnd) throw new Error(`PLP 起始日 ${plpStart} 晚于结束日 ${plpEnd}`);
// campaign 页的 Generate report 只有「时间段」没有粒度：想要日度数据只能起止取同一天。
// --plp-days 就是这种用法：每天一份，交给服务端在缺口补齐里用。
const plpDays = (value('plp-days', '') || '')
  .split(',').map(x => x.trim()).filter(Boolean);
if (plpDays.some(d => !isIso(d))) throw new Error(`--plp-days 日期格式必须为 YYYY-MM-DD，收到：${plpDays.join(',')}`);
const PLP_TYPE_SET = new Set(['listing', 'keyword', 'search']);
const plpTypes = (value('plp-types', 'listing,keyword,search') || '')
  .split(',').map(x => x.trim().toLowerCase()).filter(Boolean);
if (!plpTypes.length || plpTypes.some(t => !PLP_TYPE_SET.has(t))) {
  throw new Error(`--plp-types 只接受 listing,keyword,search，收到：${plpTypes.join(',') || '空'}`);
}
const plgUnit = (value('plg-unit', 'DAILY') || 'DAILY').toUpperCase();
if (!['DAILY', 'SUMMARY'].includes(plgUnit)) throw new Error(`--plg-unit 只接受 DAILY 或 SUMMARY，收到 ${plgUnit}`);
const PLG_RANGE_SET = new Set(['', 'TODAY', 'YESTERDAY', 'CURRENTWEEK', 'LASTWEEK', 'CURRENTMONTH', 'PREVIOUSMONTH', 'LAST90D', 'CUSTOM']);
// 实测 2026-11-08：报表中心「按日」粒度只给 今天/昨天/本周/上周 四个范围，
// 本月/上月/过去 90 天/自定义 只在「汇总」粒度下才出现（选不到就会被判成 no custom radio）。
const DAILY_RANGE_SET = new Set(['', 'TODAY', 'YESTERDAY', 'CURRENTWEEK', 'LASTWEEK']);
function assertRangeForUnit(unit, range, flag) {
  if (unit === 'DAILY' && !DAILY_RANGE_SET.has(range)) {
    throw new Error(`${flag} ${range || '默认'} 在「按日」粒度下不可用：eBay 只提供 今天/昨天/本周/上周，`
      + `按月/自定义请改用对应 --*-unit SUMMARY`);
  }
}
// 日期范围支持逗号分隔多预设（--plg-range LASTWEEK,CURRENTWEEK）：多个预设进报表中心
// 的串行队列依次提交，同一个进程内完成——省掉「一个预设一个进程」的启动开销和步间隔。
// CUSTOM 只能单独传（一次只能一个自定义区间）。
const plgRangeList = (value('plg-range', '') || '').toUpperCase().split(',').map(x => x.trim()).filter(Boolean);
if (!plgRangeList.length) plgRangeList.push('');
for (const r of plgRangeList) {
  if (!PLG_RANGE_SET.has(r)) throw new Error(`--plg-range 不支持 ${r}`);
  if (plgRangeList.length > 1 && r === 'CUSTOM') throw new Error('--plg-range 传多个预设时不能包含 CUSTOM');
  assertRangeForUnit(plgUnit, r, '--plg-range');
}
const plgRange = plgRangeList[0];   // 兼容旧引用（CUSTOM 校验等）；多预设时它只是第一个
const plgCustomStart = value('plg-custom-start', '');
const plgCustomEnd = value('plg-custom-end', '');
if (plgRange === 'CUSTOM') {
  if (!isIso(plgCustomStart) || !isIso(plgCustomEnd)) {
    throw new Error('自定义区间需要同时给出 --plg-custom-start 与 --plg-custom-end');
  }
  if (plgCustomStart > plgCustomEnd) throw new Error(`自定义区间起始日 ${plgCustomStart} 晚于结束日 ${plgCustomEnd}`);
}
// 只跑部分活动时传 ID 列表；不传=保持报表中心默认全选
const plgCampaignIds = (value('plg-campaigns', '') || '').split(',').map(x => x.trim()).filter(Boolean);
const unknownPlg = plgCampaignIds.filter(id => !PLG_CAMPAIGNS.some(c => c.id === id));
if (unknownPlg.length) throw new Error(`--plg-campaigns 有未知活动：${unknownPlg.join(',')}`);
const activeType = (value('active-type', 'active') || 'active').toLowerCase();
if (!ACTIVE_TYPES[activeType]) {
  throw new Error(`--active-type 只接受 ${Object.keys(ACTIVE_TYPES).join(' / ')}，收到 ${activeType}`);
}

// ---------- 订单报表 ----------
const orderTypeKey = value('order-type', 'all');
const orderTypeDef = ORDER_TYPES.find(t => t.key === orderTypeKey);
if (!orderTypeDef) throw new Error(`--order-type 只接受 ${ORDER_TYPES.map(t => t.key).join(' / ')}`);
const ORDER_RANGE_SET = new Set(ORDER_RANGES.map(r => r.value));
const orderRange = (value('order-range', 'LAST90D') || 'LAST90D').toUpperCase();
if (!ORDER_RANGE_SET.has(orderRange)) throw new Error(`--order-range 不支持 ${orderRange}`);
const orderCustomStart = value('order-custom-start', '');
const orderCustomEnd = value('order-custom-end', '');
if (orderRange === 'CUSTOM') {
  if (!isIso(orderCustomStart) || !isIso(orderCustomEnd)) throw new Error('订单自定义区间需要起止日期');
  if (orderCustomStart > orderCustomEnd) throw new Error(`订单区间起始日 ${orderCustomStart} 晚于结束日 ${orderCustomEnd}`);
}

// ---------- 优先促销刊登 ----------
// 一次可多选报表类型：每种作为独立任务进入报表中心串行队列，任务数不受标签页上限约束。
// --priority-type 保留为单值兼容别名；两者都传时以 --priority-types 为准。
const priorityTypeRaw = value('priority-types', value('priority-type', 'keyword'));
const priorityTypeKeys = [...new Set(String(priorityTypeRaw).split(',').map(x => x.trim()).filter(Boolean))];
if (!priorityTypeKeys.length) throw new Error('优先促销刊登至少要选一种报表类型');
const badPriorityTypes = priorityTypeKeys.filter(k => !PRIORITY_TYPES.some(t => t.key === k));
if (badPriorityTypes.length) {
  throw new Error(`--priority-types 只接受 ${PRIORITY_TYPES.map(t => t.key).join(' / ')}，收到 ${badPriorityTypes.join(',')}`);
}
const priorityTypeDefs = priorityTypeKeys.map(k => PRIORITY_TYPES.find(t => t.key === k));
const priorityTypeDef = priorityTypeDefs[0];
const priorityUnit = (value('priority-unit', 'DAILY') || 'DAILY').toUpperCase();
if (!['DAILY', 'SUMMARY'].includes(priorityUnit)) throw new Error(`--priority-unit 只接受 DAILY 或 SUMMARY`);
// 同 --plg-range：支持逗号分隔多预设，多个预设进报表中心串行队列
const priorityRangeList = (value('priority-range', '') || '').toUpperCase().split(',').map(x => x.trim()).filter(Boolean);
if (!priorityRangeList.length) priorityRangeList.push('');
for (const r of priorityRangeList) {
  if (!PLG_RANGE_SET.has(r)) throw new Error(`--priority-range 不支持 ${r}`);
  if (priorityRangeList.length > 1 && r === 'CUSTOM') throw new Error('--priority-range 传多个预设时不能包含 CUSTOM');
  assertRangeForUnit(priorityUnit, r, '--priority-range');
}
const priorityRange = priorityRangeList[0];   // 兼容旧引用；多预设时它只是第一个
const priorityCustomStart = value('priority-custom-start', '');
const priorityCustomEnd = value('priority-custom-end', '');
if (priorityRange === 'CUSTOM') {
  if (!isIso(priorityCustomStart) || !isIso(priorityCustomEnd)) throw new Error('优先促刊自定义区间需要起止日期');
  if (priorityCustomStart > priorityCustomEnd) throw new Error('优先促刊区间起始日晚于结束日');
}
// 活动默认与控制台一致：只跑 PLP 那 3 个；传 'all' 或留「全部活动」时保持后台全选 31 个
const priorityCampaignRaw = value('priority-campaigns', PRIORITY_DEFAULT_IDS.join(','));
const priorityCampaignIds = String(priorityCampaignRaw).toLowerCase() === 'all'
  ? []
  : String(priorityCampaignRaw).split(',').map(x => x.trim()).filter(Boolean);
const targetCampaigns = (value('campaigns', '') || '').split(',').map(x => x.trim()).filter(Boolean);
const campaigns = targetCampaigns.length ? targetCampaigns : CAMPAIGNS;

// PLP 任务表：默认「起止区间」一份；给了 --plp-days 就按天拆成多份（每天×每个 campaign 一个任务）
const plpRanges = plpDays.length
  ? plpDays.map(d => ({ start: d, end: d, tag: d }))
  : [{ start: plpStart, end: plpEnd, tag: plpEnd === plpStart ? plpStart : `${plpStart}~${plpEnd}` }];
const plpTasks = plpRanges.flatMap(r => campaigns.map(id => ({
  id, start: r.start, end: r.end,
  key: plpRanges.length === 1 ? `plp_${id}` : `plp_${id}_${r.start}`,
  label: plpRanges.length === 1 ? id : `${id} ${r.start}`
})));

// 批量日期：--dates 2026-11-01..2026-11-05 / --dates 2026-11-01,2026-11-03
function parseDates(spec) {
  if (!spec) return [];
  const out = [];
  for (const part of String(spec).split(',').map(x => x.trim()).filter(Boolean)) {
    const range = /^(\d{4}-\d{2}-\d{2})\s*\.\.\s*(\d{4}-\d{2}-\d{2})$/.exec(part);
    if (range) {
      const cursor = new Date(`${range[1]}T00:00:00Z`);
      const end = new Date(`${range[2]}T00:00:00Z`);
      while (cursor <= end) { out.push(cursor.toISOString().slice(0, 10)); cursor.setUTCDate(cursor.getUTCDate() + 1); }
    } else if (/^\d{4}-\d{2}-\d{2}$/.test(part)) out.push(part);
  }
  return [...new Set(out)].sort();
}
const batchDates = parseDates(value('dates', ''));
const runDaily = only.has('traffic') || only.has('trafficDaily');
const runRange = only.has('traffic') || only.has('trafficRange');
const runPlg = only.has('plg');
const runActive = only.has('active');
const runOrders = only.has('orders');
const runPriority = only.has('priority');
const runPlp = only.has('plp');

// PLP 走 campaign 页，必须知道具体活动 ID；配空了会「0 个任务、退出码 0」，
// 用户以为下过了其实什么也没下（2026-11-10 实测踩到）。没有活动就直接明确失败。
if (runPlp && !plpTasks.length) {
  abort('PLP 报表要在 campaign 页按活动生成，当前没有可用活动：'
    + '先在控制台「优先促刊 → 活动范围」点「刷新活动列表」扫出本店活动（各店铺活动 ID 不同），'
    + '或在 my-shop.json 的 plpCampaigns 里填本店活动 ID，或用 --campaigns <活动ID>,<活动ID> 指定');
}

// ---------- 运行目录 ----------
const stamp = new Date().toLocaleString('sv-SE', { hour12: false }).replace(' ', '_').replace(/:/g, '-');
const runDir = join(value('out', RUNS_DIR), stamp);
for (const folder of Object.values(FOLDERS)) mkdirSync(join(runDir, folder), { recursive: true });
const inbox = join(runDir, FOLDERS.inbox);

// 逐日批量下载时每天之间的间隔。
// 2026-11-10 实测：一天真正的成本是「2 秒换页 + 8 秒下载」，原来固定停 20 秒等于白等一倍时间
// （11 天光等待就 3.5 分钟）。eBay 限速是「短时间反复提交同类请求」触发，不是「隔得不够久」，
// 而真被限速时 grabTraffic 的 50 秒无响应判定会立刻抛错。所以常态放到 5 秒，
// 一旦有某天失败（任何原因）就升回 20 秒，宁可慢一点也不连累后面的天。
const BATCH_GAP_MS = Number(process.env.EBAY_BATCH_GAP_MS || 5000);
const BATCH_GAP_SLOW_MS = Number(process.env.EBAY_BATCH_GAP_SLOW_MS || 20000);

const results = [];
const timings = {};
const warnings = [];
const errors = [];
const startedAt = Date.now();
const openPages = [];

// 被控制台的「停止」或系统信号打断时，先把已经下好的文件记成结果清单。
// 否则归档那一步会因为「没有 结果.json」直接报错，用户白等二十分钟。
function writeInterimSummary(reason) {
  try {
    const summaryPath = join(runDir, '结果.json');
    if (existsSync(summaryPath)) return;                  // 正常收尾已经写过，别覆盖
    const files = [];
    for (const item of results) {
      if (!item || !item.path) continue;
      files.push({
        name: item.name, path: item.path, task: item.task,
        valid: item.valid !== false && !item.problem,
        problem: item.problem || null, rowCount: item.rowCount
      });
    }
    writeFileSync(summaryPath, JSON.stringify({
      startedAt: new Date(startedAt).toISOString(),
      interrupted: reason,
      files
    }, null, 2), 'utf8');
    console.log(`\n[中断] ${reason}：已把下好的 ${files.length} 份记进结果清单，归档不会丢`);
  } catch { /* 写不进去也不影响退出 */ }
}
process.on('SIGTERM', () => { writeInterimSummary('收到停止信号'); process.exit(143); });
process.on('SIGINT', () => { writeInterimSummary('按了 Ctrl+C'); process.exit(130); });

// 下载目录按文件名前缀归属到任务：不同类型的报表不会串台，可以并行落盘
const NAME = {
  traffic: /ListingsTrafficReport/i,
  plg: /promoted-listing-general-listing-report/i,
  active: /listings-report/i,
  orders: /orders?-report|order-report/i,
  priority: /priority|PLP_/i,
  plp: /CSGP_(Listing|Keyword|Search-query)/i
};
const pickFiles = (before, match) => readdirSync(inbox)
  .filter(name => !before.has(name) && !/\.crdownload$/i.test(name) && match.test(name));

function folderFor(kind, task) {
  // 空报表没有任何列名，只能按任务判断归属
  if (kind === 'empty') {
    if (task === 'orders') return FOLDERS.orders;
    if (task === 'priority') return FOLDERS.priority;
    if (task === 'plg') return FOLDERS.plg;
    if (task === 'plp') return FOLDERS.plpListing;
    if (task === 'trafficDaily') return FOLDERS.trafficDaily;
    if (task === 'trafficRange') return FOLDERS.trafficRange;
    if (task === 'active') return FOLDERS.active;
    return FOLDERS.pending;
  }
  if (kind === 'traffic') return task === 'trafficDaily' ? FOLDERS.trafficDaily : FOLDERS.trafficRange;
  if (kind === 'plg') return FOLDERS.plg;
  if (kind === 'active') {
    if (activeType === 'unsold') return FOLDERS.activeUnsold;
    if (activeType === 'scheduled') return FOLDERS.activeScheduled;
    return FOLDERS.active;
  }
  if (kind === 'listing') return FOLDERS.plpListing;
  if (kind === 'keyword') return FOLDERS.plpKeyword;
  if (kind === 'search') return FOLDERS.plpSearch;
  if (kind === 'orders') return FOLDERS.orders;
  if (String(kind).startsWith('priority')) return FOLDERS.priority;
  return FOLDERS.pending;
}

function recordFiles(task, names, meta = {}) {
  const recorded = [];
  for (const name of names) {
    const src = join(inbox, name);
    let info;
    try { info = inspectCsv(src, task === 'orders' ? 'orders' : task === 'priority' ? 'priority' : null); }
    catch { info = { kind: 'unknown', label: '无法解析', valid: false, missingHeader: [], rowCount: 0, period: null, coverage: null, dates: [], header: '' }; }
    const endForCheck = task === 'trafficRange'
      ? rangeEnd
      : (meta.targetDate || (task === 'plp' ? plpEnd : date));
    let problem = task === 'any'
      ? (info.valid ? null : `结构不合格：缺字段 ${info.missingHeader.join(',') || '未识别表头'}，行数 ${info.rowCount}`)
      : checkExpected(info, task, endForCheck, meta.rangeStart || rangeStart, plpStart, {
          plgRange, plgCustomStart, plgCustomEnd
        });
    // 0 行不是错误：这类状态下确实可能没有数据，但要记一条警告，免得以为是漏抓
    if (!problem && info.empty) warnings.push(`${meta.requestLabel || task}：0 行（该状态下确实没有数据）`);
    // 0 条记录的空报表没有列名，跳过类型比对（这是合法结果，不是抓错文件）
    const isEmptyReport = info.kind === 'empty';
    if (isEmptyReport) problem = null;
    if (!isEmptyReport) {
      if (task === 'plp' && !['listing', 'keyword', 'search'].includes(info.kind)) problem = problem || '不是 PLP 三类报表';
      if (task === 'plg' && info.kind !== 'plg') problem = problem || `类型不符：${info.label || info.kind}`;
      if (task === 'active' && info.kind !== 'active') problem = problem || `类型不符：${info.label || info.kind}`;
      if (task === 'orders' && info.kind !== 'orders') problem = problem || `类型不符：${info.label || info.kind}`;
      if (task === 'priority' && !String(info.kind).startsWith('priority')) problem = problem || `类型不符：${info.label || info.kind}`;
      if (['trafficDaily', 'trafficRange'].includes(task) && info.kind !== 'traffic') problem = problem || `类型不符：${info.label || info.kind}`;
    }
    // 直接按类型归档（只有完全无法识别的才进 99-待核验），问题只记在结果里不拦文件
    const dest = join(runDir, info.kind === 'unknown' ? FOLDERS.pending : folderFor(info.kind, task), name);
    copyFileSync(src, dest);
    if (info.kind === 'unknown' && problem) writeFileSync(`${dest}.原因.txt`, `${problem}\n`, 'utf8');
    let hash = null;
    try { hash = sha256File(src); } catch { /* ignore */ }
    const item = {
      task, ...meta, name, path: dest, kind: info.kind, label: info.label,
      valid: info.valid && !problem, problem,
      period: info.period, coverage: info.coverage, dates: info.dates,
      rowCount: info.rowCount, itemCount: info.itemCount, size: info.size,
      campaign: info.campaign, header: info.header, headerTemplate: info.headerTemplate,
      missingHeader: info.missingHeader, sha256: hash
    };
    results.push(item);
    recorded.push(item);
  }
  return recorded;
}

async function runTask(name, fn) {
  const t0 = Date.now();
  if (fatalReason()) {
    timings[name] = { ...(timings[name] || {}), ms: 0, ok: false, skipped: true };
    errors.push({ task: name, message: `未执行：${fatalReason()}` });
    console.log(`[跳过] ${name}：${fatalReason()}`);
    return null;
  }
  try {
    const out = await fn();
    timings[name] = { ...(timings[name] || {}), ms: Date.now() - t0, ok: true };
    return out;
  } catch (error) {
    timings[name] = { ...(timings[name] || {}), ms: Date.now() - t0, ok: false };
    errors.push({ task: name, message: error.message });
    console.log(`[失败] ${name}: ${error.message}`);
    return null;
  }
}

// 连接看门狗：每 4 秒探一次活。桥进程挂了自动重拉；Chrome 调试端口断了（Chrome 被关/重启）
// 无法自愈，连续两次确认后熔断，让剩余任务秒退，而不是在超时里空转好几分钟。
let watchdogTimer = null;
let probeFails = 0;
function startWatchdog() {
  if (watchdogTimer) return;
  watchdogTimer = setInterval(async () => {
    if (fatalReason()) return;
    const state = await probe();
    if (state.ok) { probeFails = 0; return; }
    if (state.kind === 'bridge') {
      console.log(`[看门狗] ${state.reason}，尝试重拉桥…`);
      const back = await ensureBridge({ timeoutMs: 12000 }).catch(error => ({ error: error.message }));
      if (!back.error) { probeFails = 0; console.log('[看门狗] 桥已恢复，继续执行'); return; }
    }
    probeFails += 1;
    if (probeFails >= 2) {
      const reason = `${state.reason}（Chrome 远程调试已断开，需完全退出 Chrome 后重跑）`;
      markFatal(reason);
      drainTabQueue(reason);
      console.log(`[熔断] ${reason} —— 剩余任务立即终止`);
    }
  }, 4000);
}
function stopWatchdog() { if (watchdogTimer) { clearInterval(watchdogTimer); watchdogTimer = null; } }

// 开跑前清掉历史遗留的 /sh 页面。先确保窗口里还有别的标签页（没有就补一个空白页），
// 再把 /sh 页全关：既不会让 Chrome 收回远程调试授权，也不会留一个 eBay 页占 MAX_TABS 配额。
async function trimOldTabs() {
  // 两路并行下载（控制台「首次初始化」）时绝不能清标签页：
  // 另一路正在用那些页面，清掉就让对方 35 秒等不到就绪 → 整步失败（实测踩过）。
  if (process.env.EBAY_KEEP_TABS === '1') return;
  const { targetInfos } = await cdp('Target.getTargets');
  const pages = targetInfos.filter(t => t.type === 'page');
  const stale = pages.filter(t => /ebay\.com\/sh\//i.test(t.url || ''));
  if (!stale.length) return;
  if (pages.length === stale.length) {
    await cdp('Target.createTarget', { url: 'about:blank', background: true }).catch(() => {});
  }
  for (const t of stale) await cdp('Target.closeTarget', { targetId: t.targetId }).catch(() => {});
  console.log(`[标签页] 收敛历史页面：关闭 ${stale.length} 个 /sh 页，保留空白页保住调试授权`);
}

// 收尾保证至少留一个标签页：全关会让 Chrome 收回远程调试授权
async function ensureOneTab() {
  const { targetInfos } = await cdp('Target.getTargets');
  if (!targetInfos.some(t => t.type === 'page')) {
    await cdp('Target.createTarget', { url: 'about:blank', background: true }).catch(() => {});
  }
}

// 标签页按需打开 + 数量上限：eBay 的 /sh 页面很重，一次开七八个会把浏览器和电脑拖死，
// 所以同一时刻最多 MAX_TABS 个在用，其余排队；任务结束关掉标签页，槽位立刻让给下一个。
const MAX_TABS = Math.max(1, Math.min(10, Number(value('max-tabs', '4')) || 4));
const opened = new Map();
const planUrl = new Map();
let aliveTabs = 0;
const tabQueue = [];

// 任务可以很多，排队等待不能按「单个任务耗时」计时：只要有槽位被释放，等待计时就从头开始。
// 真正卡死时靠看门狗 markFatal → drainTabQueue，或本轮结束 drain，保证 Promise.all 有出口。
const TAB_WAIT_MS = 15 * 60 * 1000;
async function acquireTab() {
  if (aliveTabs < MAX_TABS) { aliveTabs++; return; }
  await new Promise((resolve, reject) => {
    let timer;
    const fail = () => {
      const i = tabQueue.indexOf(item);
      if (i >= 0) tabQueue.splice(i, 1);
      reject(new Error(`等待标签页槽位超时（${Math.round(TAB_WAIT_MS / 60000)} 分钟）`));
    };
    const arm = () => setTimeout(fail, TAB_WAIT_MS);
    const item = {
      resolve: () => { clearTimeout(timer); resolve(); },
      reject: err => { clearTimeout(timer); reject(err); },
      refresh: () => { clearTimeout(timer); timer = arm(); }
    };
    timer = arm();
    tabQueue.push(item);
  });
}
function releaseTab() {
  const next = tabQueue.shift();
  if (next) {
    next.resolve();                       // 直接把槽位转交，不改变 aliveTabs
    for (const it of tabQueue) it.refresh?.();  // 队列在推进，其余任务继续等，不算超时
  } else aliveTabs = Math.max(0, aliveTabs - 1);
}
function drainTabQueue(reason) {
  while (tabQueue.length) tabQueue.shift().reject(new Error(`标签页队列已终止：${reason}`));
  aliveTabs = 0;
}

let loginChecked = false;
async function newPage(key) {
  const cached = opened.get(key);
  if (cached && !cached.closed) return cached;
  const url = planUrl.get(key);
  if (!url) throw new Error(`没有为「${key}」规划标签页`);
  await acquireTab();
  let page;
  try {
    page = await openTab(key, url);
  } catch (error) {
    releaseTab();
    throw error;
  }
  // 关页即释放槽位；不依赖调用方一定走 finally
  const rawClose = page.close.bind(page);
  let released = false;
  page.close = async () => {
    try { await rawClose(); }
    finally { if (!released) { released = true; releaseTab(); } }
  };
  opened.set(key, page);
  openPages.push(page);
  if (!loginChecked) {
    loginChecked = true;
    try {
      await assertLoggedIn(page);
    } catch (error) {
      // 登录态失败时页面已经占了槽位，必须关掉，否则并发度永久 -1
      await page.close().catch(() => {});
      throw error;
    }
  }
  console.log(`[标签页] ${key} 已就绪（在用 ${aliveTabs}/${MAX_TABS}）`);
  return page;
}

// 中断清理：child.kill() 与 Ctrl+C 会绕过主流程 finally，必须单独兜住，
// 否则 eBay 标签页残留、Chrome 下载目录永久停在本轮 inbox。
let cleanupDone = false;
async function cleanupAll(reason) {
  if (cleanupDone) return;
  cleanupDone = true;
  stopWatchdog();
  drainTabQueue(reason);
  await Promise.all(openPages.filter(p => !p.closed).map(p => p.close().catch(() => {})));
  await ensureOneTab().catch(() => {});
  await setDownloadDir(DEFAULT_DOWNLOAD_DIR).catch(() => {});
}
for (const sig of ['SIGINT', 'SIGTERM']) {
  process.on(sig, async () => {
    console.log(`[中断] 收到 ${sig}，清理标签页与下载目录…`);
    await cleanupAll(sig).catch(() => {});
    process.exit(130);
  });
}

// ---------- 页面表达式 ----------
const LABEL = `(n => (n.innerText || n.getAttribute('aria-label') || '').trim().replace(/\\s+/g, ' '))`;

const TRAFFIC_STATE = `(() => {
  const v = n => n.getClientRects().length > 0;
  const label = ${LABEL};
  const periodBtn = [...document.querySelectorAll('button[aria-haspopup], button.menu-button__button')]
    .filter(v).find(n => /past \\d+ days|\\b20\\d{2}\\b/i.test((n.innerText || '').trim()));
  const downloads = [...document.querySelectorAll('button')].filter(v)
    .filter(n => /download (active |all )?listings traffic report|download report/i.test(label(n)));
  return { url: location.href, periodText: periodBtn ? (periodBtn.innerText || '').trim() : '',
    downloadLabels: downloads.map(label), ready: downloads.length === 1 };
})()`;

const TRAFFIC_CLICK = `(() => {
  const v = n => n.getClientRects().length > 0;
  const label = ${LABEL};
  const b = [...document.querySelectorAll('button')].filter(v)
    .find(n => /download (active |all )?listings traffic report|download report/i.test(label(n)));
  if (!b) return { ok: false, reason: 'button-missing' };
  // 按钮常在首屏之外，先滚到可见区再点，避免点到覆盖层或空白
  try { b.scrollIntoView({ block: 'center', inline: 'center' }); } catch {}
  b.click();
  return { ok: true, label: label(b) };
})()`;

// 点击后校验「下载请求真的发出去了」：记录 createreporttask 的 taskId，再查任务状态
const TRAFFIC_HOOK = `(() => {
  if (window.__trafficHooked) return true;
  window.__trafficHooked = true;
  window.__trafficTask = null;
  // 同时监听 fetch 与 XHR：eBay 两套都可能用，只盯一个会误判成「没发请求」
  const of = window.fetch;
  window.fetch = function (input, init) {
    const url = typeof input === 'string' ? input : (input && input.url) || '';
    const p = of.apply(this, arguments);
    if (/createreporttask/.test(url)) {
      p.then(r => r.clone().json()).then(j => { if (j && j.taskId) window.__trafficTask = j.taskId; }).catch(() => {});
    }
    return p;
  };
  const oo = XMLHttpRequest.prototype.open, os = XMLHttpRequest.prototype.send;
  XMLHttpRequest.prototype.open = function (m, u) { this.__u = String(u); return oo.apply(this, arguments); };
  XMLHttpRequest.prototype.send = function (b) {
    if (/createreporttask/.test(this.__u)) {
      this.addEventListener('load', () => { try { window.__trafficTask = JSON.parse(this.responseText).taskId; } catch {} });
    }
    return os.apply(this, arguments);
  };
  return true;
})()`;

const TRAFFIC_TASK_STATE = `(async () => {
  const id = window.__trafficTask;
  if (!id) return { taskId: null };
  try {
    const r = await fetch('/sh/fpp/gettask?client=SellerHubPerformance_SalesAndCost&taskId=' + id, { credentials: 'include' });
    const j = await r.json();
    return { taskId: id, status: j.status, recordCount: j.recordCount };
  } catch (error) {
    return { taskId: id, status: 'UNKNOWN', error: error.message };
  }
})()`;

// eBay 改版后：报表生成完才弹提示条「Your report is ready / Preparing download.. / download」，
// 必须再点一次 download 文件才落盘。提示条标题与外层是分开的两块 DOM，所以按「祖先链里含 ready」来认领。
const TRAFFIC_READY_CLICK = `(() => {
  const v = n => n.getClientRects().length > 0;
  const label = ${LABEL};
  const all = [];
  const collect = root => {
    root.querySelectorAll('*').forEach(el => {
      if (el.shadowRoot) collect(el.shadowRoot);
      if (/^download$/i.test(label(el))) all.push(el);
    });
  };
  if (document.body) collect(document);
  const ready = !!(document.body && /your report is ready/i.test(document.body.innerText));
  if (!all.length) return { ok: false, toast: ready };
  const visible = all.filter(v);
  const pool = visible.length ? visible : all;
  const inToast = pool.find(n => {
    let p = n;
    for (let i = 0; i < 6 && p; i++) { if (/your report is ready/i.test(p.innerText || '')) return true; p = p.parentElement; }
    return false;
  });
  const link = inToast || (ready ? pool[pool.length - 1] : null);
  if (!link) return { ok: false, toast: ready };
  try { link.scrollIntoView({ block: 'center' }); } catch {}
  link.click();
  return { ok: true, text: label(link), tag: link.tagName, cls: String(link.className || '').slice(0, 40) };
})()`;

// 点一次并等到文件；顺带区分「没发出请求 / 任务失败 / 只是慢 / 被风控拦住」
// 点「Download report」→ 等 eBay 生成报表（实测 8~60 秒）→ 提示条里的 download 要再点一次 → 等文件
// timeoutMs 从 150 秒缩到 80 秒：正常 8~14 秒就出，等 150 秒只会让人以为卡死。
// 循环里每 4 秒看一眼是不是被风控页顶掉了：是就立刻抛（BlockedError），不在超时里白等。
async function grabTraffic(page, label, { timeoutMs = 80000, clickGapMs = 12000 } = {}) {
  await page.eval(TRAFFIC_HOOK).catch(() => {});
  await page.eval('(() => { window.__trafficTask = null; return true; })()').catch(() => {});
  const before = new Set(readdirSync(inbox));
  const clicked = await page.eval(TRAFFIC_CLICK);
  if (!clicked.ok) throw new Error('页面上没有下载按钮（可能被风控或页面未渲染完）');
  const started = Date.now();
  const pick = () => readdirSync(inbox)
    .filter(name => !before.has(name) && !/\.crdownload$/i.test(name) && NAME.traffic.test(name));
  let lastClickAt = 0, sawToast = false, lastBlockCheck = 0, sawTaskState = false;
  // 点了按钮以后，eBay 正常会在 3~8 秒内出提示条 / 进入生成中；如果 40 秒页面一点反应都没有，
  // 说明它根本没受理这次请求（实测：短时间内提交太多次，traffic 报表会进入无响应状态）。
  // 这时别再等到 80 秒超时，也别反复重试——直接抛出去，让上层停手。
  const noResponseMs = Number(process.env.EBAY_NO_RESPONSE_MS || 50000);
  while (Date.now() - started < timeoutMs) {
    await sleep(1000);
    const fresh = pick();
    if (fresh.length) return fresh;
    if (Date.now() - lastBlockCheck > 4000) {
      lastBlockCheck = Date.now();
      if (await isBlocked(page)) {
        throw new BlockedError(`${label}：页面被 eBay 风控拦住了（等一会儿自动恢复，已下载的不会重复）`);
      }
    }
    // 提示条一出现立刻点 download；万一没触发，隔 clickGapMs 再补一次
    if (!lastClickAt || Date.now() - lastClickAt > clickGapMs) {
      const r = await page.eval(TRAFFIC_READY_CLICK).catch(() => null);
      if (r && r.ok) {
        lastClickAt = Date.now();
        console.log(`[Traffic] ${label}：提示条已出（${Math.round((Date.now() - started) / 1000)}s），点了 download，等文件落盘…`);
      } else if (r && r.toast) {
        sawToast = true;
      }
    }
    const state = await page.eval(TRAFFIC_TASK_STATE).catch(() => null);
    if (state && /FAILED|ERROR/i.test(state.status || '')) throw new Error(`报表任务失败：${state.status}`);
    if (state && state.status) sawTaskState = true;
    if (!sawToast && !sawTaskState && Date.now() - started > noResponseMs) {
      const error = new Error(`${label}：点了下载，eBay 50 秒内没有任何反应（多半是短时间内提交太多次，它在排队/限速）`);
      error.code = 'EBAY_NO_RESPONSE';
      throw error;
    }
  }
  const fresh = pick();
  if (fresh.length) return fresh;
  const waited = Math.round((Date.now() - started) / 1000);
  throw new Error(sawToast
    ? `${waited} 秒内提示条出现但没拿到文件（已点 download，文件未落盘）`
    : `${waited} 秒内没有文件落盘，也没等到「Your report is ready」提示条`);
}

