async function pickStep(page, step) {
  const has = await waitUntil(page, rcHasCard(step.card), v => v?.ok, 20000);
  if (!has?.ok) throw new Error(`${step.card} 卡片未出现`);
  // flyout 异步渲染，卡片点击偶发被保留的旧面板吞掉（旧面板没关时点新卡片无效）。
  // 所以按「本卡片的 pane 有没有就绪」来驱动：没就绪就再点一次卡片，总预算 30 秒。
  // 键片段取 fragment 里冒号前的部分：\"CAMPAIGN_TIME_UNIT\":\"DAILY\" → \"CAMPAIGN_TIME_UNIT\":
  const keyFrag = step.fragment.slice(0, step.fragment.lastIndexOf(':') + 1);
  const deadline = Date.now() + 30000;
  let lastClick = 0;
  let picked = null;
  let paneText = '';
  while (Date.now() < deadline) {
    picked = await page.eval(rcPickRadio(step.fragment)).catch(() => null);
    if (picked?.ok) break;
    const ready = await page.eval(rcPaneHas(keyFrag)).catch(() => null);
    paneText = ready?.text || paneText;
    if (!ready?.ok) {
      if (Date.now() - lastClick > 2000) {
        await page.eval(rcOpenCard(step.card)).catch(() => {});
        lastClick = Date.now();
        await sleep(900);
      } else {
        await sleep(400);
      }
    } else {
      await sleep(500);
    }
  }
  if (!picked?.ok) {
    // 只报「可见」的选项：之前把隐藏面板里的 radio 也打出来，看着像「明明有却选不上」，误导排查
    const diag = await page.eval(`(() => {
      const v = n => n.getClientRects().length > 0;
      const panes = [...document.querySelectorAll('.flyout-pane')].filter(v);
      const vis = [...document.querySelectorAll('input[type=radio]')].filter(v).map(n => n.value);
      return { panes: panes.length, vis };
    })()`).catch(() => null);
    throw new Error(`${step.card} 未找到选项 ${step.fragment}`
      + `（30 秒，可见面板 ${diag?.panes ?? '?'} 个${paneText ? '，面板内容：' + paneText : ''}）`
      + `，可见选项：${JSON.stringify(diag?.vis || []).slice(0, 600)}`);
  }
  await sleep(300);
  // 选完确认这张卡片的 pane 收起了；没收起会吞掉下一张卡片的点击
  for (let i = 0; i < 3; i++) {
    const ready = await page.eval(rcPaneHas(keyFrag)).catch(() => null);
    if (!ready?.ok) break;
    await page.eval(rcDoneIn(keyFrag)).catch(() => {});
    await sleep(600);
  }
  await sleep(400);
}

// 只跑部分活动：先取消「全选」，再逐个勾上目标活动（不传 ids 就保持全选）
async function pickCampaigns(page, ids, tag) {
  if (!ids.length) return;
  const has = await waitUntil(page, rcHasCard('Campaigns'), v => v?.ok, 20000);
  if (!has?.ok) throw new Error('Campaigns 卡片未出现');
  // 与 pickStep 同款自愈：点击偶发被 React 重渲染吞掉（pane 没弹出），重新点卡片直到面板就绪
  const deadline = Date.now() + 30000;
  let reopenAt = 0;
  let before = null;
  while (Date.now() < deadline) {
    before = await page.eval(RC_CAMPAIGNS_STATE).catch(() => null);
    if (before?.ok) break;
    if (Date.now() - reopenAt > 2000) {
      await page.eval(rcOpenCard('Campaigns')).catch(() => {});
      reopenAt = Date.now();
    }
    await sleep(800);
  }
  if (!before?.ok) throw new Error('Campaigns 面板 30 秒内没弹出来');
  await sleep(600);
  await page.eval(RC_CAMPAIGNS_CLEAR);
  await sleep(700);
  const available = (before.boxes || []).map(b => b.id);
  const missing = ids.filter(id => !available.includes(id));
  if (missing.length) throw new Error(`活动不在列表里：${missing.join(',')}（可选 ${available.join(',')}）`);
  await page.eval(rcCampaignsCheck(ids));
  await sleep(700);
  const after = await page.eval(RC_CAMPAIGNS_STATE);
  const on = (after.boxes || []).filter(b => b.on).map(b => b.id);
  await page.eval(rcDoneIn(null, true));
  await sleep(600);
  if (on.length !== ids.length || ids.some(id => !on.includes(id))) {
    throw new Error(`活动勾选不完整，实际选中 ${on.join(',') || '无'}，期望 ${ids.join(',')}`);
  }
  console.log(`[报表中心] ${tag} 只跑 ${on.length} 个活动：${on.join(',')}`);
}

// 自定义区间：选 CUSTOM 后弹层保持打开，直接在日历里点起止日（点完再收起）
async function pickCustomRange(page, startIso, endIso) {
  // 与 pickStep 同款自愈：pane 没弹出就重新点 Date range 卡片，总预算 30 秒
  const deadline = Date.now() + 30000;
  let reopenAt = 0;
  let picked = null;
  while (Date.now() < deadline) {
    picked = await page.eval(RC_PICK_CUSTOM).catch(() => null);
    if (picked?.ok) break;
    const pane = await page.eval(rcPaneHas('"DATE_RANGE":')).catch(() => null);
    const gap = Date.now() - reopenAt;
    // 面板没开就重开卡片；面板开着却只有预设、没有自定义，隔 10 秒再点一次（可能是上一张卡的旧面板）
    if ((!pane?.ok && gap > 2000) || (pane?.ok && gap > 10000)) {
      await page.eval(RC_OPEN_DATE_CARD).catch(() => {});
      reopenAt = Date.now();
      await sleep(900);
    } else {
      await sleep(500);
    }
  }
  if (!picked?.ok) {
    const vis = await page.eval(`(() => {
      const v = n => n.getClientRects().length > 0;
      return [...document.querySelectorAll('input[type=radio]')].filter(v).map(n => String(n.value).slice(-40));
    })()`).catch(() => []);
    throw new Error(`自定义范围选项没找到${picked?.why ? '：' + picked.why : ''}`
      + `（30 秒），可见选项：${JSON.stringify(vis).slice(0, 400)}`);
  }
  await sleep(1500);
  const s = await page.eval(rcPickCalendarDate('start', startIso));
  if (!s.ok) throw new Error(`开始日期没选上：${s.why}`);
  const e = await page.eval(rcPickCalendarDate('end', endIso));
  if (!e.ok) throw new Error(`结束日期没选上：${e.why}`);
  const back = await page.eval(RC_READ_RANGE);
  const slash = d => d.replace(/-/g, '/');
  if (back.start !== slash(startIso) || back.end !== slash(endIso)) {
    throw new Error(`自定义区间回读不符：${back.start} ~ ${back.end}，期望 ${startIso} ~ ${endIso}`);
  }
  await page.eval(rcDoneIn('"DATE_RANGE":'));
  await sleep(700);
  console.log(`[报表中心] 自定义区间 ${back.start} ~ ${back.end}`);
}

// 优先促刊是一个 kind 带四种类型，行名与标签要跟着本次选的类型走，
// 不能用固定的关键词那条定义（行名不同会导致等不到已完成的行）。
function reqDef(kind, priorityDef) {
  if (kind === 'orders') {
    // 九种订单共用一个 kind，标签要跟本次选的类型走。
    // 行名必须逐种精确匹配（Orders Awaiting shipment 是 - overdue 的前缀），
    // 用通配会把队列里别人遗留的订单请求当成自己的结果领走。
    return {
      label: orderTypeDef.label,
      rowMatch: orderTypeDef.rowMatch || RC_REQUESTS.orders.rowMatch,
      steps: RC_REQUESTS.orders.steps,
      reportId: orderTypeDef.reportId
    };
  }
  if (kind === 'active') {
    // 名单三种（在售 / 非在售 / 预定）行名完全不同，标签和行名都要跟着所选类型走。
    // 之前这里直接返回 RC_REQUESTS.active（固定「全部在售」），选非在售/预定时
    // 提交是对的，但等待时拿「all active listings」去比对，永远匹配不到 → 必然超时。
    const at = ACTIVE_TYPES[activeType];
    return { ...RC_REQUESTS.active, label: at.label, rowMatch: at.rowMatch };
  }
  if (kind !== 'priority') return RC_REQUESTS[kind];
  // 多类型时每个任务带自己的定义：行名、Type、是否有 Campaigns 卡片都不同
  const pd = priorityDef || priorityTypeDefs[0];
  const report = getReport(pd.reportId);
  const steps = pd.hasCampaigns === false
    ? RC_REQUESTS.priority.steps.filter(s => s.card !== 'Campaigns')  // 「活动」级别没有这张卡
    : RC_REQUESTS.priority.steps;
  return {
    label: pd.label,
    rowMatch: new RegExp(report.rowMatch || 'Advertising', 'i'),
    looseMatch: /advertising/i,
    steps,
    reportId: report.id,
    type: pd.type,
    hasCampaigns: pd.hasCampaigns
  };
}

// 各类报表的选项覆盖规则；CUSTOM 区间统一走日历，其余按 radio value 选。
// rangeOverride：同一类要提交多个预设时（如 PLG 上周+本周），每个预设传自己的值。
function stepsFor(kind, priorityDef, rangeOverride) {
  const cfg = reqDef(kind, priorityDef);
  const plgRangeNow = rangeOverride || plgRange;
  const priorityRangeNow = rangeOverride || priorityRange;
  return cfg.steps.map(step => {
    if (kind === 'plg') {
      if (step.card === 'Time unit') return { ...step, fragment: `"CAMPAIGN_TIME_UNIT":"${plgUnit}"` };
      if (step.card === 'Date range' && plgRangeNow && plgRangeNow !== 'CUSTOM') {
        return { ...step, fragment: `"DATE_RANGE":"${plgRangeNow}"` };
      }
    }
    if (kind === 'active' && step.card === 'Type') {
      return { ...step, fragment: `"TYPE":"${ACTIVE_TYPES[activeType].type}"` };
    }
    if (kind === 'orders') {
      if (step.card === 'Type') return { ...step, fragment: `"TYPE":"${orderTypeDef.type}"` };
      if (step.card === 'Date range' && orderRange !== 'CUSTOM') {
        return { ...step, fragment: `"DATE_RANGE":"${orderRange}"` };
      }
    }
    if (kind === 'priority') {
      if (step.card === 'Type') return { ...step, fragment: `"TYPE":"${cfg.type}"` };
      if (step.card === 'Time unit') return { ...step, fragment: `"CAMPAIGN_TIME_UNIT":"${priorityUnit}"` };
      if (step.card === 'Date range' && priorityRangeNow && priorityRangeNow !== 'CUSTOM') {
        return { ...step, fragment: `"DATE_RANGE":"${priorityRangeNow}"` };
      }
    }
    return step;
  });
}

async function configureReportCenter(page, kind, priorityDef, rangeOverride) {
  const cfg = RC_REQUESTS[kind];
  await page.eval(RC_CLOSE).catch(() => {});
  let hasOpen = await waitUntil(page, RC_HAS_OPEN, v => v?.ok, 20000);
  if (!hasOpen?.ok) {
    // 页面可能停在别的状态，刷一次再等
    await page.reload();
    await sleep(3000);
    hasOpen = await waitUntil(page, RC_HAS_OPEN, v => v?.ok, 20000);
  }
  if (!hasOpen?.ok) throw new Error('未找到 Download report 按钮');
  const opened = await page.eval(RC_OPEN);
  if (!opened.ok) throw new Error('未点击到 Download report 按钮');
  await sleep(1500);

  for (const step of stepsFor(kind, priorityDef, rangeOverride)) {
    if (step.card === 'Campaigns') {
      // 活动级（优先促刊 CAMPAIGN）没有这张卡，没有 ids 时直接跳过
      if (kind === 'plg') await pickCampaigns(page, plgCampaignIds, 'PLG');
      else if (kind === 'priority') await pickCampaigns(page, priorityCampaignIds, '优先促刊');
      continue;
    }
    if (step.card === 'Date range') {
      if (kind === 'plg' && (rangeOverride || plgRange) === 'CUSTOM') { await pickCustomRange(page, plgCustomStart, plgCustomEnd); continue; }
      if (kind === 'orders' && orderRange === 'CUSTOM') { await pickCustomRange(page, orderCustomStart, orderCustomEnd); continue; }
      if (kind === 'priority' && (rangeOverride || priorityRange) === 'CUSTOM') { await pickCustomRange(page, priorityCustomStart, priorityCustomEnd); continue; }
    }
    await pickStep(page, step);
  }
  const submitted = await page.eval(RC_SUBMIT);
  if (!submitted.ok) throw new Error(`提交失败：${submitted.reason || '未知'}`);
  await sleep(1000);
  await page.eval(RC_CLOSE).catch(() => {});
}

// 报表中心任务完成后取文件。
// 各类型的真实文件名不一样（前缀、日期都不同），靠猜必踩坑，
// 所以直接点这一行的 Download，从页面自己发出的请求里抄真实地址，再按原样取回。
const rcHarvestExpr = ref => `(async () => {
  const v = n => n.getClientRects().length > 0;
  const urls = [];
  const isFile = u => /getfiledetails/i.test(String(u || ''));
  // 记录页面发出的取文件请求
  const oxOpen = XMLHttpRequest.prototype.open;
  XMLHttpRequest.prototype.open = function (m, u, ...rest) {
    try { if (isFile(u)) urls.push(String(u)); } catch {}
    return oxOpen.call(this, m, u, ...rest);
  };
  const ofFetch = window.fetch;
  window.fetch = function (...args) {
    try {
      const u = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url);
      if (isFile(u)) urls.push(String(u));
    } catch {}
    return ofFetch.apply(this, args);
  };
  // 拦住页面自己的保存动作，避免同一份文件落两次
  const oaClick = HTMLAnchorElement.prototype.click;
  let blocked = 0;
  HTMLAnchorElement.prototype.click = function () {
    if (this.download || /^blob:/i.test(this.href || '')) { blocked++; return; }
    return oaClick.call(this);
  };
  const restore = () => {
    XMLHttpRequest.prototype.open = oxOpen;
    window.fetch = ofFetch;
    HTMLAnchorElement.prototype.click = oaClick;
  };
  try {
    const row = [...document.querySelectorAll('tr')].filter(v)
      .find(r => (r.innerText || '').includes(${JSON.stringify(ref)}));
    if (!row) return { ok: false, why: '找不到该 requestId 的行' };
    const btn = [...row.querySelectorAll('button')].filter(v)
      .find(b => /^(Download|下载)$/i.test((b.innerText || '').trim()));
    if (!btn) return { ok: false, why: '该行没有 Download 按钮' };
    if (btn.disabled) return { ok: false, why: 'Download 按钮处于禁用态' };
    btn.click();
    const deadline = Date.now() + 12000;
    while (!urls.length && Date.now() < deadline) await new Promise(r => setTimeout(r, 150));
    if (!urls.length) return { ok: false, why: '点了 Download 也没发出取文件请求' };
    const url = urls[urls.length - 1];
    const res = await fetch(url, { credentials: 'include' });
    const text = await res.text();
    const m = url.match(/[?&]fileName=([^&]+)/);
    const name = m ? decodeURIComponent(m[1]) : '';
    // 0 条记录时 eBay 会返回一份 49 字节的合法空报表：表头是一整行逗号 + 一行「0,」。
    // 它没有列名，但确实不是错误页，不能按「太小」误杀；后续 inspectCsv 会识别成 empty 并记警告。
    // 注意：整段是模板字符串，正则里的反斜杠会被外层吃掉，这里一律不用带转义的正则
    const firstLine = text.split(String.fromCharCode(10))[0] || '';
    const onlyCommas = firstLine.split('').every(c => c === ',' || c === '"' || c.trim() === '');
    const badWords = /html|doctype|access denied|error|exception|downloadFileError/i.test(text.slice(0, 300));
    const looksEmpty = text.length < 500 && firstLine.includes(',') && onlyCommas && !badWords;
    if (!res.ok || !text || (!looksEmpty && text.length < 100)
        || /downloadFileError/i.test(text.slice(0, 200))) {
      return { ok: false, why: '取回内容不合格（' + res.status + ' / ' + (text ? text.length : 0) + ' 字节）', url };
    }
    if (looksEmpty) console.log('[报表中心] 这份是 0 条记录的空报表，按合法结果处理');
    return { ok: true, url, name, size: text.length, blocked, empty: looksEmpty, text };
  } finally {
    restore();
  }
})()`;

async function downloadReportRow(page, task, ref, label, kind = task) {
  const got = await retry(`取文件 ${label} ref=${ref}`, async () => {
    const res = await page.eval(rcHarvestExpr(ref));
    if (!res.ok) throw new Error(res.why || '取文件失败');
    return res;
  }, { tries: 3, delayMs: 2500 });
  const name = got.name || `${kind}-${ref}.csv`;
  const existing = join(inbox, name);
  writeFileSync(existing, got.text, 'utf8');
  console.log(`[报表中心] ${label} 取到 ${name}（${(got.size / 1024).toFixed(0)} KB）`);
  return recordFiles(task, [name], { refId: ref, requestLabel: label });
}

// 已完成请求列表里，按当前报表类型找到对应那一行（各类型的行名不同）
function rowMatchFor(kind, priorityDef) {
  if (kind === 'active') return ACTIVE_TYPES[activeType].rowMatch;
  return reqDef(kind, priorityDef).rowMatch;
}

async function runReportCenter(kind, priorityDef, rangeOverride) {
  const page = await newPage(`rc_${kind}`);
  // 名单类三种类型的行名不同，日志里要写清楚是哪一种；多预设时标出当前这份的范围
  const label = reqDef(kind, priorityDef).label + (rangeOverride ? `（${rangeOverride}）` : '');
  try {
    return await retry(`报表中心 ${label}`, async attempt => {
      if (attempt > 1) {
        // 只在失败后重载，正常路径不刷新，避免打断下载
        await page.eval(`(() => { location.href = ${JSON.stringify(REPORTS_URL)}; return true; })()`).catch(() => {});
        await sleep(3500);
      }
      if (!(await recoverIfBlocked(page, { tries: 2, backoffMs: [20000, 60000] }))) {
        throw new BlockedError(`报表中心 ${label}：页面被 eBay 风控拦住`);
      }
      const t0 = Date.now();
      const knownRefs = new Set(await page.eval(RC_REFS));

      if (latest) {
        const rows = await page.eval(RC_ROWS);
        const row = rows.find(r => r.status === 'Completed' && rowMatchFor(kind, priorityDef).test(r.text));
        if (!row) throw new Error('最新已完成请求未找到');
        const out = await downloadReportRow(page, 'any', row.ref, `最新${label}`, kind);
        console.log(`[报表中心] ${label} 最新 ref=${row.ref}：${out[0].name}，${out[0].rowCount} 行`);
        return out;
      }

      await configureReportCenter(page, kind, priorityDef, rangeOverride);
      const submittedAt = Date.now();
      console.log(`[报表中心] ${label} 已提交，窗口等待生成…`);

      let row = null;
      const def = reqDef(kind, priorityDef);
      const deadline = submittedAt + RC_POLL.timeoutMs;
      const lenientAt = submittedAt + 45000;
      let round = 0;
      let lastRefresh = Date.now();
      let failedRow = null;
      let lastFresh = [];
      let diagShown = false;
      // 报表中心列表不会自己刷新（2026-11-08 实测），所以按 refreshEveryMs 软刷新；
      // 同时把「新行 = Failed」当成硬失败立刻报错，不再空等整段超时。
      while (Date.now() < deadline && !row) {
        round++;
        const rows = await page.eval(RC_ROWS).catch(() => []);
        const fresh = rows.filter(r => !knownRefs.has(r.ref));
        lastFresh = fresh;
        failedRow = fresh.find(r => r.status === 'Failed' && def.rowMatch.test(r.text)) || null;
        if (failedRow) break;
        row = fresh.filter(r => r.status === 'Completed').find(r => def.rowMatch.test(r.text)) || null;
        // 等了一分钟还没命中，而列表里确实冒出了别的请求行：把真实行名打出来。
        // 只报「超时未发现新请求」那种话会让人以为 eBay 没生成，实际多半是行名对不上。
        if (!row && fresh.length && !diagShown && Date.now() - submittedAt > 60000) {
          diagShown = true;
          console.log(`[诊断] 新出现 ${fresh.length} 条请求，但行名都不匹配「${def.rowMatch.source}」：`);
          for (const r of fresh.slice(0, 6)) console.log(`         · [${r.status}] ${r.text.slice(0, 90)}`);
        }
        // 兜底：行名与预期不符时，若这一轮只新出现一条广告类请求，且唯一，就认它
        if (!row && def.looseMatch && Date.now() > lenientAt) {
          const loose = fresh.filter(r => r.status === 'Completed' && def.looseMatch.test(r.text));
          if (loose.length === 1) {
            row = loose[0];
            warnings.push(`${label}：行名与预期「${def.rowMatch.source}」不一致，按唯一新请求落盘（${row.text.slice(0, 60)}）`);
          }
        }
        if (!row && Date.now() - lastRefresh > RC_POLL.refreshEveryMs) {
          await page.eval(`(() => { location.href = ${JSON.stringify(REPORTS_URL)}; return true; })()`).catch(() => {});
          lastRefresh = Date.now();
          await sleep(RC_POLL.reloadSettleMs + 1500);
          continue;
        }
        if (!row) await sleep(RC_POLL.intervalMs);
      }
      if (failedRow) {
        throw new Error(`eBay 侧生成失败（状态 Failed，ref=${failedRow.ref}）：换日期范围或过一会儿再试`);
      }
      if (!row) {
        const seen = lastFresh.length
          ? `；这一轮新出现的行：${lastFresh.slice(0, 4).map(r => `[${r.status}] ${r.text.slice(0, 50)}`).join(' / ')}`
          : '；这一轮没有任何新请求行（eBay 可能没收到提交，或被限速）';
        throw new Error(`等待生成超时（${Math.round(RC_POLL.timeoutMs / 1000)} 秒），未发现匹配「${def.rowMatch.source}」的完成请求${seen}`);
      }
      timings[`${kind}Generate${rangeOverride ? '@' + rangeOverride : ''}`] = { ms: Date.now() - submittedAt, ok: true, round };

      const out = await downloadReportRow(page, kind, row.ref, label, kind);
      const bad = out.filter(item => !item.valid);
      if (bad.length) throw new Error(`校验不合格：${bad[0].problem}`);
      console.log(`[报表中心] ${label} ref=${row.ref}：${out[0].name}，${out[0].rowCount} 行，提交后 ${Math.round((Date.now() - submittedAt) / 1000)} 秒`);
      return out;
    }, { tries: 3, delayMs: 4000 });
  } finally {
    if (!keepWindows) await page.close().catch(() => {});
  }
}

// ---------- 任务 5：PLP（三个 campaign，各自标签页）----------
// 三个 campaign 同时生成容易撞车，提交动作串行、间隔 2.5 秒
let plpSubmitChain = Promise.resolve();
const queuePlpSubmit = fn => {
  const result = plpSubmitChain.then(fn, fn);
  plpSubmitChain = result.then(() => {}, () => {});
  return result;
};

async function configureAndGenerate(page, id, startIso, endIso) {
  const usStart = toUsPeriodStart(startIso);
  const usEnd = toUsPeriodStart(endIso);
  const shaped = await waitUntil(page, PLP_SHAPE, v => v?.dialogOpen && (v.selects?.length || 0) >= 2, 15000);
  if (!shaped?.dialogOpen) throw new Error('Generate report 弹窗未出现');
  const configured = await page.eval(plpConfigureExpr(usStart, usEnd, plpTypes));
  if (!configured.ok) throw new Error(`配置弹窗失败：${configured.error}`);
  await sleep(700);
  const shape = await page.eval(PLP_SHAPE);
  const expectChecked = Math.min(plpTypes.length, shape.totalChecks || plpTypes.length);
  const good = shape.dialogOpen && shape.selects?.includes('CUSTOM') && shape.selects?.includes('ALL')
    && shape.dates?.length === 2
    && shape.dates[0] === usStart && shape.dates[1] === usEnd
    && shape.checked === expectChecked && !shape.disabled;
  if (!good) throw new Error(`弹窗配置未达预期：${JSON.stringify({ ...shape, 期望日期: [usStart, usEnd], 期望勾选: expectChecked, 实际类型: configured.kinds })}`);
  const clicked = await page.eval(PLP_GENERATE);
  if (!clicked.ok) throw new Error('Generate 按钮不可点');
  await sleep(1200);
  const status = await page.eval(PLP_STATUS).catch(() => ({ downloadNow: false }));
  if (status.downloadNow) warnings.push(`campaign ${id} 提交后仍显示 Download now，可能残留上一次生成结果`);
  return Date.now();
}

async function submitPlp(page, id, startIso, endIso) {
  await page.eval(PLP_CLOSE).catch(() => {});
  const hasOpen = await waitUntil(page, PLP_HAS_OPEN, v => v?.ok, 25000);
  if (!hasOpen?.ok) throw new Error('未找到 Generate report 按钮');
  const opened = await page.eval(PLP_OPEN);
  if (!opened.ok) throw new Error('未点击到 Generate report 按钮');
  await sleep(600);
  const at = await configureAndGenerate(page, id, startIso, endIso);
  const usStart = toUsPeriodStart(startIso);
  const usEnd = toUsPeriodStart(endIso);
  const periodText = usStart === usEnd ? `${usStart} 单日` : `${usStart} ~ ${usEnd}`;
  console.log(`[PLP] ${id} 已提交（${periodText} / All / ${plpTypes.join('+')}）`);
  return at;
}

async function runPlpCampaign(task) {
  const { id, start, end } = task;
  const tag = task.label || id;
  // PLP 偶发「We couldn't process your download」，整条任务自动再走一遍
  return retry(`PLP ${tag}`, async attempt => {
    if (attempt > 1) {
      const page = await newPage(`plp_${id}`);
      await page.eval(`(() => { location.href = ${JSON.stringify(CAMPAIGN_URL(id))}; return true; })()`).catch(() => {});
      await sleep(5000);
    }
    return runPlpCampaignOnce(task);
  }, { tries: 2, delayMs: 6000 });
}

async function runPlpCampaignOnce(task) {
  const { id, start, end } = task;
  const tag = task.label || id;
  const page = await newPage(`plp_${id}`);
  try {
    let submittedAt = await queuePlpSubmit(async () => {
      const at = await submitPlp(page, id, start, end);
      await sleep(2500);
      return at;
    });
    const firstCheck = submittedAt + PLP_POLL.firstWaitMs;
    const peek = async () => page.eval(PLP_STATUS).catch(() => null);
    const isReady = s => Boolean(s?.downloadNow || s?.tryAgain);
    // 静等期只读 DOM（不刷新页面、不产生网络请求）：实测 2026-11-10 三个 campaign
    // 分别在第 64 / 124 / 132 秒就绪，原来死等满 120 秒才首查，第一个白等近一分钟。
    // 轻查不会打扰 eBay 的生成队列（打扰它的只有刷新），所以从提交后就开始看。
    if (firstCheck > Date.now()) {
      console.log(`[PLP] ${tag} 已提交，先每 ${Math.round(PLP_POLL.earlyPollMs / 1000)} 秒轻查一次（不刷新页面，不打扰生成队列）`);
      while (Date.now() < firstCheck) {
        await sleep(Math.max(300, Math.min(PLP_POLL.earlyPollMs, firstCheck - Date.now())));
        const early = await peek();
        if (isReady(early)) {
          console.log(`[PLP] ${tag} 第 ${Math.round((Date.now() - submittedAt) / 1000)} 秒已就绪，不再等满 ${Math.round(PLP_POLL.firstWaitMs / 1000)} 秒`);
          break;
        }
      }
    }

    let deadline = firstCheck + PLP_POLL.timeoutMs;
    let round = 0;
    let retries = 0;
    let lastReloadAt = 0;
    while (Date.now() < deadline) {
      round++;
      // 先看当前页面：已经就绪就直接用，不再多刷一次
      let status = await peek();
      if (!isReady(status)) {
        // 刷新间隔上限：每 intervalMs 最多刷新一次（刷新是唯一会打扰生成队列的动作）
        if (!lastReloadAt || Date.now() - lastReloadAt >= PLP_POLL.intervalMs) {
          lastReloadAt = Date.now();
          await page.reload();
        }
        // 刷新后最多等 settleMs：每 settlePollMs 读一次 DOM，按钮一渲染出来就立刻抓
        const settleUntil = Date.now() + PLP_POLL.settleMs;
        while (!isReady(status) && Date.now() < settleUntil) {
          await sleep(PLP_POLL.settlePollMs);
          status = await peek();
        }
        // 距下次刷新还有空档：只读 DOM 轻查（不刷新、无网络请求），页面自己更新也能立刻抓住
        const watchUntil = lastReloadAt + PLP_POLL.intervalMs;
        while (!isReady(status) && Date.now() < watchUntil && Date.now() < deadline) {
          await sleep(PLP_POLL.watchMs);
          status = await peek();
        }
      }
      if (!status?.downloadNow && status?.tryAgain) {
        if (retries >= 3) throw new Error('多次 Try again 仍未生成成功');
        retries++;
        const clicked = await page.eval(PLP_TRY_AGAIN).catch(() => ({ ok: false }));
        console.log(`[PLP] ${id} 提示「We couldn't process your download」，${clicked.ok ? '已点 Try again 并重新填写' : '未点到 Try again'}（第 ${retries} 次）`);
        if (clicked.ok) {
          await sleep(1200);
          try {
            await configureAndGenerate(page, id, start, end);
            submittedAt = Date.now();
            deadline = submittedAt + PLP_POLL.retryWaitMs + PLP_POLL.timeoutMs;
          } catch (error) {
            console.log(`[PLP] ${id} 重试配置失败：${error.message}`);
          }
        }
        // 重新提交后同样静等 60 秒，避免立刻刷新又读到上一轮的失败状态反复点 Try again
        console.log(`[PLP] ${id} 重新提交完成，静等 ${Math.round(PLP_POLL.retryWaitMs / 1000)} 秒后再查`);
        await sleep(PLP_POLL.retryWaitMs);
        lastReloadAt = 0; // 重试后强制重新读一次页面状态
        continue;
      }
      if (!status?.downloadNow) {
        // 这一轮已经按 30 秒节奏刷过、也轻查过，直接进入下一轮（节奏由 lastReloadAt 控制）
        console.log(`[PLP] ${id} 第 ${round} 轮未就绪（提交后 ${Math.round((Date.now() - submittedAt) / 1000)} 秒）`);
        continue;
      }
      const t0 = Date.now();
      const grabbed = await withDownloadLock('all', () => clickDownload(page, {
        clickExpr: PLP_DOWNLOAD_NOW, match: NAME.plp, inbox,
        label: `PLP ${id}`, tries: 2, timeoutMs: PLP_POLL.downloadTimeoutMs, gapMs: 5000, expected: 3
      }));
      const fresh = grabbed.files;
      if (!fresh.length) { warnings.push(`campaign ${id} Download now 后未等到文件`); await sleep(PLP_POLL.intervalMs); continue; }
      const recorded = recordFiles('plp', fresh, { campaignId: id });
      // 空报表（0 条记录）在 CSV 里认不出类型，按文件名回推它属于哪一类，
      // 否则会误报「只拿到 keyword,listing,unknown」——其实三份都拿到了。
      const plpKindOf = name => (/search-?query/i.test(name) ? 'search'
        : /keyword/i.test(name) ? 'keyword'
        : /listing/i.test(name) ? 'listing' : null);
      const kinds = new Set(recorded.map(r => (r.kind === 'empty' ? (plpKindOf(r.name) || 'empty') : r.kind)));
      if (!plpTypes.every(k => kinds.has(k))) {
        warnings.push(`campaign ${tag} 只拿到 ${recorded.length} 份：${[...kinds].join(',')}（期望 ${plpTypes.join(',')}）`);
      }
      timings[`plpReady_${tag}`] = { ms: Date.now() - submittedAt, ok: true, round };
      timings[`plpDownload_${tag}`] = { ms: Date.now() - t0, ok: true, files: fresh.length };
      console.log(`[PLP] ${id} 就绪：提交后 ${Math.round((Date.now() - submittedAt) / 1000)} 秒，第 ${round} 轮，${fresh.length} 份，下载 ${Date.now() - t0}ms`);
      return recorded;
    }
    throw new Error(`等待 Download now 超时（${Math.round(PLP_POLL.timeoutMs / 1000)} 秒）`);
  } finally {
    if (!keepWindows) await page.close().catch(() => {});
  }
}

// ---------- 主流程 ----------
console.log(`=== 运行 ${stamp} | 目标日 ${date} | 累计区间 ${rangeStart} ~ ${rangeEnd} ===`);
console.log(`任务：${[...only].join(',')}${latest ? '（报表中心用最新已完成请求）' : ''}`);
const bridge = await ensureBridge().catch(error => ({ error: error.message }));
if (bridge.error) throw new Error(bridge.error);
if (bridge.started) console.log('[桥] 已自动拉起常驻连接（守护进程会一直保持它在线）');
// 再确认一次桥到浏览器的连接真的可用（桥在但浏览器被关是最常见的失败源）
const pre = await probe();
if (!pre.ok) throw new Error(`浏览器连接不可用：${pre.reason}｜在控制台点右上角「去开开关」把开关拨开一次即可`);
console.log('[预检] 浏览器连接正常');
await setDownloadDir(inbox);
startWatchdog();

// 页面按需打开、用完关掉；任务数可以远大于 MAX_TABS，多出来的在队列里等槽位
const plan = [];
const batchMode = batchDates.length > 0 && (only.has('traffic') || only.has('trafficDaily'));
if (batchMode) plan.push({ key: 'trafficBatch', url: trafficUrl(batchDates[0], batchDates[0]) });
else if (runDaily) plan.push({ key: 'trafficDaily', url: trafficUrl(date, date) });
if (runRange) plan.push({ key: 'trafficRange', url: trafficUrl(rangeStart, rangeEnd) });
if (runPlg) plan.push({ key: 'rc_plg', url: REPORTS_URL });
if (runActive) plan.push({ key: 'rc_active', url: REPORTS_URL });
if (runOrders) plan.push({ key: 'rc_orders', url: REPORTS_URL });
if (runPriority) plan.push({ key: 'rc_priority', url: REPORTS_URL });
if (runPlp) for (const t of plpTasks) plan.push({ key: `plp_${t.id}`, url: CAMPAIGN_URL(t.id) });

for (const { key, url } of plan) planUrl.set(key, url);
await trimOldTabs().catch(e => console.log(`[标签页] 历史页收敛失败（不阻断下载）：${e.message}`));
console.log(`页面计划：${plan.map(p => p.key).join(' / ')}（同屏最多 ${MAX_TABS} 个标签页，按需打开）`);
// 登录态在每个标签页首次打开时校验（见 newPage），不预先全开

// 报表中心是账号级请求队列：4 类同时提交会互相看到对方新完成的请求，
// 而 PLG 的行名 Advertising 又是优先促刊 Advertising Listing/Keyword/... 的前缀，
// 并发时 fresh.find 极易把别人的文件认领下来（静默下错数据）。统一串行提交，
// knownRefs 快照天然隔离；Traffic 与 PLP 仍并行，不牺牲整体吞吐。
let rcChain = Promise.resolve();
let rcQueued = 0;
let rcDone = 0;
function queueReportCenter(kind, priorityDef, rangeOverride) {
  rcQueued++;
  const result = rcChain.then(
    () => runReportCenter(kind, priorityDef, rangeOverride),
    () => runReportCenter(kind, priorityDef, rangeOverride)
  ).finally(() => {
    rcDone++;
    console.log(`[队列] 报表中心 ${rcDone}/${rcQueued} 完成${rcDone < rcQueued ? `，还有 ${rcQueued - rcDone} 个排队` : ''}`);
  });
  rcChain = result.then(() => {}, () => {});
  return result;
}

const jobs = [];
if (batchMode) jobs.push(['trafficBatch', () => runTrafficBatch(batchDates)]);
else if (runDaily) jobs.push(['trafficDaily', () => runTraffic('trafficDaily', date, date)]);
if (runRange) jobs.push(['trafficRange', () => runTraffic('trafficRange', rangeStart, rangeEnd)]);
// PLG 支持多预设（如 LASTWEEK,CURRENTWEEK）：每个预设一个任务，全部进报表中心串行
// 队列依次提交——单进程内完成，不用再「一个预设一个进程」分步跑。
if (runPlg) {
  const many = plgRangeList.length > 1;
  for (const r of plgRangeList) {
    jobs.push([many ? `reportCenter_plg_${r}` : 'reportCenter_plg',
      () => queueReportCenter('plg', null, many ? r : null)]);
  }
}
if (runActive) jobs.push(['reportCenter_active', () => queueReportCenter('active')]);
if (runOrders) jobs.push(['reportCenter_orders', () => queueReportCenter('orders')]);
// 优先促销刊登：每种报表类型 × 每个日期范围一个任务，全部进串行队列，任务数不受标签页上限约束
if (runPriority) {
  const many = priorityRangeList.length > 1;
  for (const pd of priorityTypeDefs) {
    for (const r of priorityRangeList) {
      jobs.push([`reportCenter_priority_${pd.key}${many ? '_' + r : ''}`,
        () => queueReportCenter('priority', pd, many ? r : null)]);
    }
  }
}
// PLP 三个 campaign 默认并发提交（2.5 秒间隔）：实测并发整轮 186 秒，串行要 318 秒，
// 且 eBay 生成速度本身随请求次数变慢，串行并不能提升成功率；真正兜底的是 Try again + 任务级重试。
// 需要排查时可加 --plp-serial 强制逐个跑。
if (runPlp) {
  if (flag('plp-serial')) {
    jobs.push(['plp_serial', async () => {
      const all = [];
      for (const t of plpTasks) {
        const out = await runTask(`plp_${t.key}`, () => runPlpCampaign(t));
        if (out) all.push(...out);
      }
      return all;
    }]);
  } else if (plpRanges.length > 1) {
    // 多天补齐：按天分组——同一天的 3 个 campaign 并行，跨天串行。
    // 实测 2026-11-08：6 个标签同时等 Download now 会互相抢文件（一个任务点击后
    // 文件被别的任务认领，另一个任务等 60 秒拿不到），所以天与天之间必须排队。
    for (const r of plpRanges) {
      const group = plpTasks.filter(t => t.start === r.start);
      jobs.push([`plp_day_${r.start}`, async () => {
        const outs = await Promise.all(group.map(t => runTask(t.key, () => runPlpCampaign(t))));
        return outs.flat().filter(Boolean);
      }]);
    }
  } else {
    for (const t of plpTasks) jobs.push([t.key, () => runPlpCampaign(t)]);
  }
}

console.log(`任务队列：共 ${jobs.length} 个下载任务，单次最多并行 ${MAX_TABS} 个标签页，其余排队（报表中心内部再串行提交，不会认错文件）`);
try {
  await Promise.all(jobs.map(([name, job]) => runTask(name, job)));
} finally {
  stopWatchdog();
  drainTabQueue('本轮结束');
  if (!keepWindows) {
    // 本轮开的页面全部关掉，最后保证浏览器里至少还有一个标签页（空白页即可）。
    // 全关会收回远程调试授权；但也不能每轮都留一个 eBay 页，否则跑多了又攒一堆。
    await Promise.all(openPages.filter(p => !p.closed).map(page => page.close().catch(() => {})));
    await ensureOneTab();
    await sleep(600);
  } else {
    await ensureOneTab().catch(() => {});
  }
  await setDownloadDir(DEFAULT_DOWNLOAD_DIR).catch(() => {});
}

const totalMs = Date.now() - startedAt;
const summary = {
  runId: stamp, runDir, date, rangeStart, rangeEnd, latest, only: [...only],
  plpStart, plpEnd, plpTypes, plgUnit, plgRange: plgRange || null, campaigns,
  plgCustomStart: plgCustomStart || null, plgCustomEnd: plgCustomEnd || null,
  plgCampaigns: plgCampaignIds.length ? plgCampaignIds : 'all',
  activeType,
  orderType: orderTypeDef.key, orderRange, orderCustomStart: orderCustomStart || null, orderCustomEnd: orderCustomEnd || null,
  priorityTypes: priorityTypeKeys, priorityUnit, priorityRange: priorityRange || null,
  priorityCustomStart: priorityCustomStart || null, priorityCustomEnd: priorityCustomEnd || null,
  priorityCampaigns: priorityCampaignIds.length ? priorityCampaignIds : 'all',
  startedAt: new Date(startedAt).toISOString(), totalMs,
  timings, warnings, errors,
  files: results,
  counts: {
    total: results.length,
    valid: results.filter(r => r.valid).length,
    invalid: results.filter(r => !r.valid).length,
    byKind: results.reduce((acc, r) => { acc[r.kind] = (acc[r.kind] || 0) + 1; return acc; }, {})
  }
};
if (shouldApply) {
  const applied = applyFiles(results);
  summary.apply = applied;
  console.log(`[归档] 写入 90-待处理 ${applied.applied.length} 份，跳过重复 ${applied.skipped.length} 份`);
}
if (shouldPublish) {
  const published = publishDashboard();
  summary.publish = published;
  console.log(`[发布] ${published.ok ? '成功' : '失败'}：${(published.stderr || published.stdout || '').slice(-500)}`);
}
summary.dataDirState = dataDirState();

// 收尾清理：已成功按类型归档的文件，把 _inbox 里的同名副本删掉，
// 打开结果目录只剩 7 个分类文件夹，不用在一堆重复文件里找。
// Chrome 偶尔在本进程删完之后才真正写完文件，所以重试几轮，别只删一次。
const classified = new Set(results.filter(item => item.path && !item.problem).map(item => item.name));
let cleaned = 0;
for (let attempt = 0; attempt < 3 && classified.size; attempt++) {
  const left = readdirSync(inbox).filter(name => classified.has(name));
  if (!left.length) break;
  for (const name of left) {
    try { unlinkSync(join(inbox, name)); cleaned++; } catch { /* 下一轮再试 */ }
  }
  if (attempt < 2) await sleep(800);
}
summary.inboxCleaned = cleaned;
writeFileSync(join(runDir, '结果.json'), JSON.stringify(summary, null, 2), 'utf8');


if (fatalReason()) console.log(`\n[熔断] ${fatalReason()}`);
console.log('\n=== 耗时（毫秒 / 秒） ===');
for (const [key, value] of Object.entries(timings)) {
  if (!value || typeof value.ms !== 'number') continue;
  const detail = typeof value.downloadWaitMs === 'number' ? `  落盘等待 ${value.downloadWaitMs}ms` : '';
  console.log(`${key.padEnd(30)} ${String(value.ms).padStart(7)}ms  ${(value.ms / 1000).toFixed(1)}s  ${value.ok ? 'OK' : 'FAIL'}${detail}`);
}
console.log(`\n总计 ${(totalMs / 1000).toFixed(1)} 秒 | 文件 ${summary.counts.total} 份（有效 ${summary.counts.valid}）| 警告 ${warnings.length} | 错误 ${errors.length}`);
console.log(`结果目录：${runDir}`);
if (warnings.length) console.log('警告：' + JSON.stringify(warnings));
if (errors.length) console.log('错误：' + JSON.stringify(errors));
// 有失败就让退出码非 0：控制台才能显示「这几步没成」，不能一边有错一边报「全部成功」。
// 但文件还是照常留在结果目录里，归档步骤不受影响。
if (errors.length) process.exitCode = 1;
