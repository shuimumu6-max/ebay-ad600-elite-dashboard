// ---------- 日期匹配 ----------
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function dayPattern(iso) {
  const [y, m, d] = iso.split('-').map(Number);
  const mon = MONTHS[m - 1];
  return new RegExp(`(?:${mon}\\s+0?${d},?\\s*${y})|(?:0?${m}/0?${d}/${y})`, 'i');
}
function periodMatches(text, start, end) {
  if (!text) return false;
  if (!dayPattern(start).test(text)) return false;
  return start === end ? true : dayPattern(end).test(text);
}
const trafficUrl = (start, end) =>
  `${TRAFFIC_URL}?filter=${encodeURIComponent(`changed_date:startDate,date_range:[${start}..${end}]`)}`;

// ---------- 通用等待：页面渲染慢时先等控件出现，再动作 ----------
async function waitUntil(page, expression, isOk, timeoutMs = 20000, intervalMs = 400) {
  const deadline = Date.now() + timeoutMs;
  let last = null;
  while (Date.now() < deadline) {
    try {
      last = await page.eval(expression);
      if (isOk(last)) return last;
    } catch { last = null; }
    await sleep(intervalMs);
  }
  return last;
}

// ---------- 任务 1/2：Traffic（单日 / 累计，各自标签页）----------
// 等页面把区间切到目标日期；连续取不到状态就刷一次，避免标签页卡死拖死任务
async function waitTrafficReady(page, start, end) {
  let state = null;
  let misses = 0;
  const deadline = Date.now() + FAST.pageTimeoutMs;
  while (Date.now() < deadline) {
    try {
      state = await page.eval(TRAFFIC_STATE);
      misses = 0;
      if (state.ready && periodMatches(state.periodText, start, end)) return { ok: true, state };
    } catch {
      state = null;
      misses++;
      if (misses >= 3) { misses = 0; await page.reload().catch(() => {}); await sleep(2500); }
    }
    await sleep(FAST.pagePollMs);
  }
  return { ok: false, state };
}

async function runTraffic(task, start, end) {
  const startAt = Date.now();
  const page = await newPage(task);
  const target = trafficUrl(start, end);
  try {
    return await retry(`Traffic ${task}`, async attempt => {
      if (attempt > 1) {
        // 重试时整页重新加载回目标区间，拿到干净页面（原地补点成功率低）
        await page.navigate(target, { settleMs: 2500 });
      }
      if (!(await recoverIfBlocked(page, { tries: 2, backoffMs: [20000, 60000] }))) {
        throw new BlockedError(`Traffic ${task}：页面被 eBay 风控拦住`);
      }

      const ready = await waitTrafficReady(page, start, end);
      if (!ready.ok) throw new Error(`页面区间未就绪：${JSON.stringify(ready.state)}`);

      const t0 = Date.now();
      const files = await withDownloadLock('all', () => grabTraffic(page, `Traffic ${task}`));

      const mark = results.length;
      const recorded = recordFiles(task, files, {
        periodExpected: `${start} ~ ${end}`, pagePeriod: ready.state.periodText
      });
      const bad = recorded.filter(item => !item.valid);
      if (bad.length) {
        // 文件不对就丢掉重下，不能把脏数据混进结果
        discard(inbox, files);
        results.length = mark;
        throw new Error(`校验不合格：${bad[0].problem}`);
      }
      timings[task] = {
        ...(timings[task] || {}),
        pageWaitMs: t0 - startAt, downloadWaitMs: Date.now() - t0, file: files[0]
      };
      console.log(`[Traffic] ${task} ${start}~${end}：${files[0]}，${recorded[0].rowCount} 行，用时 ${Date.now() - t0}ms`);
      return recorded;
    }, { tries: 4, delayMs: 10000, backoff: 3 });
  } finally {
    if (!keepWindows) await page.close().catch(() => {});
  }
}

// 批量单日 Traffic：同一个标签页按日期逐个跑，串行避免文件串台
async function runTrafficBatch(dates) {
  const page = await newPage('trafficBatch');
  const done = [];
  let blockedStreak = 0;
  let stoppedEarly = 0;
  // 常态 5 秒；任何一天失败就切到 20 秒（见 BATCH_GAP_MS 处的说明）
  let gapMs = BATCH_GAP_MS;
  for (let index = 0; index < dates.length; index++) {
    const day = dates[index];
    const startAt = Date.now();
    try {
      await retry(`Traffic ${day}`, async attempt => {
        // 整页导航 + 等区间匹配 + 1.2 秒渲染缓冲：批量模式首点失败主要就是页面还没切干净
        await page.navigate(trafficUrl(day, day), { settleMs: 1200 });
        if (!(await recoverIfBlocked(page, { tries: 2, backoffMs: [20000, 60000] }))) {
          throw new BlockedError(`Traffic ${day}：页面被 eBay 风控拦住`);
        }
        const ready = await waitTrafficReady(page, day, day);
        if (!ready.ok) throw new Error(`页面区间未就绪：${JSON.stringify(ready.state)}`);
        const t0 = Date.now();
        const files = await withDownloadLock('all', () => grabTraffic(page, `Traffic ${day}`));
        const mark = results.length;
        const recorded = recordFiles('trafficDaily', files, { targetDate: day, pagePeriod: ready.state.periodText });
        const bad = recorded.filter(item => !item.valid);
        if (bad.length) {
          discard(inbox, files);
          results.length = mark;
          throw new Error(`校验不合格：${bad[0].problem}`);
        }
        timings[`traffic_${day}`] = { ms: Date.now() - startAt, ok: true, downloadWaitMs: Date.now() - t0 };
        console.log(`[Traffic] ${day}：${recorded[0].rowCount} 行，${((Date.now() - t0) / 1000).toFixed(1)}s`);
        done.push(recorded[0]);
        return recorded;
      }, { tries: 2, delayMs: 60000, backoff: 1 });
      blockedStreak = 0;
    } catch (error) {
      errors.push({ task: `traffic_${day}`, message: error.message });
      const throttled = isBlockedError(error) || error.code === 'EBAY_NO_RESPONSE';
      if (throttled) {
        blockedStreak += 1;
        console.log(`[限速] ${day} 没下下来（连续第 ${blockedStreak} 次）—— eBay 短时间内被我们要太多次了，不是你操作错了`);
        // 一天里已经重试过 2 次都是「点了没反应」，就不要再试下一天了：
        // eBay 的限速是账号级的，换个日期照样不理；继续试只会让人白等十几分钟。
        // 直接停、把结论说清楚，用户过 1 小时再点「补齐缺口」就行。
        stoppedEarly = dates.length - index;
        console.log('');
        console.log(`[停止] 剩下的 ${stoppedEarly} 天先不下了 —— 继续点只会让它更久不理我们。`);
        console.log('       已经下好的报表都在，不会重复。过 1~2 小时再点「补齐缺口」，只补缺的那几天（归档完看板自动生效）。');
        console.log('');
        errors.push({ task: 'traffic_batch', message: `eBay 短时间限速，剩余 ${stoppedEarly} 天改为稍后补齐` });
        break;
      } else {
        console.log(`[失败] Traffic ${day}: ${error.message}`);
        // 出现非限速类失败，说明页面/网络开始不稳，后面的天放慢节奏
        gapMs = Math.max(gapMs, BATCH_GAP_SLOW_MS);
      }
    }
    // 每天之间留一点间隔；失败过就自动放慢
    if (index < dates.length - 1) await sleep(gapMs);
  }
  if (stoppedEarly) timings.trafficBatchStopped = { days: stoppedEarly, reason: 'EBAY_BLOCKED' };
  return done;
}

