/* ---------- 日志 ---------- */
const logEl = $('#log');
let logLines = 0;
function clearLog(){ logEl.innerHTML = ''; logLines = 0; }
function classify(line){
  if (/\[失败\]|\[X\]|错误|Error|超时|不可用/.test(line)) return 'l-err';
  if (/\[重试\]|警告|未就绪|Try again|提示/.test(line)) return 'l-warn';
  if (/就绪|取到|已提交|OK|完成|有效/.test(line)) return 'l-ok';
  if (/^\[控制台\]|^===|^结果目录/.test(line)) return 'l-head';
  return '';
}
function appendLog(line){
  const atBottom = logEl.scrollTop + logEl.clientHeight >= logEl.scrollHeight - 30;
  const span = document.createElement('div');
  span.className = classify(line);
  span.textContent = line;
  logEl.appendChild(span);
  logLines++;
  $('#logCount').textContent = logLines + ' 行';
  if (atBottom) logEl.scrollTop = logEl.scrollHeight;
}

const es = new EventSource('/api/logs');
es.addEventListener('snapshot', e => {
  const { lines } = JSON.parse(e.data);
  if (lines.length){ clearLog(); lines.forEach(appendLog); }
});
es.onmessage = e => {
  const { line } = JSON.parse(e.data);
  if (logLines === 0) logEl.innerHTML = '';
  appendLog(line);
};
// 活动扫描完成：把新扫到的活动名填回界面（不重启控制台）
es.addEventListener('scan-done', e => {
