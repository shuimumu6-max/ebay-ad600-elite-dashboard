/* ---------- 环境状态 ---------- */
async function refreshState(){
  try{
    const s = await (await fetch('/api/state')).json();
    const dot = $('#dotChrome'), txt = $('#txtChrome'), fix = $('#btnFix');
    const b = s.bridge || {};
    if (b.ok){
      dot.className = 'dot ok';
      // 不显示「已连续在线 N 分钟」：那是常驻进程的运行时长，跟"这次装得好不好"无关，
      // 多开一个控制台还会显示同一个老数字，容易被误读成数据不对。
      txt.textContent = '已连接';
      fix.hidden = true;
      txt.title = '常驻连接一直保持，下载不会再要求你点允许';
    } else if (b.needsAuth){
      dot.className = 'dot bad';
      txt.textContent = '需要拨一次开关';
      fix.hidden = false;
      fix.textContent = '去开开关';
      txt.title = b.hint || '浏览器重启后调试开关会自动关闭，拨一次即可';
    } else {
      dot.className = 'dot wait';
      txt.textContent = b.online ? '正在重连…' : '正在启动连接…';
      fix.hidden = true;
      txt.title = b.hint || '';
    }
    // 只在首次填充默认值，避免覆盖用户已改的
    if (!state.defaults && s.defaults){
      state.defaults = s.defaults;
      $('#trafficDate').value = s.defaults.date;
      $('#rangeStart').value = s.defaults.rangeStart;
      $('#plgCustomStart').value = s.defaults.rangeStart;
      $('#plgCustomEnd').value = s.defaults.date;
      $('#orderCustomStart').value = s.defaults.rangeStart;
      $('#orderCustomEnd').value = s.defaults.date;
      $('#priorityCustomStart').value = s.defaults.rangeStart;
      $('#priorityCustomEnd').value = s.defaults.date;
      renderPlgCampaigns(s.defaults.plgCampaignList);
      renderSingleChips('#orderTypes', s.defaults.orderTypes, 'orderType', updateSubLabels);
      renderMultiChips('#priorityTypes', s.defaults.priorityTypes, updateSubLabels);
      renderPriorityCampaigns(s.defaults.priorityCampaignList, s.defaults.priorityDefaultCampaigns);
      syncPlgRange();
      syncOrderRange();
      syncPriorityRange();
      // segVal 是 collectOptions 里的局部函数，这里必须用全局的 segValue，
      // 否则整段状态渲染会抛 ReferenceError 被 catch 吞掉（店铺名/引导/体检全都不显示）
      syncRangeOptions('#plgRange', segValue('segUnit'));
      syncRangeOptions('#priorityRange', segValue('segPriorityUnit'));
      updateSubLabels();
    }
    if (s.outDir && !$('#outDir').value) $('#outDir').placeholder = s.outDir;
    if (s.shop) renderShopName(s.shop.name, s.shop.placeholder);
    if (s.dashboardMode && s.dashboardMode !== dashboardMode){
      dashboardMode = s.dashboardMode;
      applyDashboardMode();
    }
    // 首次使用引导：还没有任何 CSV 时出现；点过「不用」或正在跑就收起
    const fr = $('#firstRun');
    if (fr) fr.hidden = !s.firstRun?.needed || !!s.running || sessionStorage.getItem('firstRunSkip') === '1';
    if (s.dashboard) $('#linkDash').href = dashboardMode === 'local' ? '#' : s.dashboard;
    if (s.dataState) renderDataState(s.dataState);
    $('#dotRun').className = 'dot ' + (s.running ? 'busy' : 'ok');
    $('#txtRun').textContent = s.running ? '下载中…' : '空闲';
    // 刷新页面 / 另开一个控制台窗口时，把「正在跑」同步到按钮与进度条；
    // 否则按钮还是「开始下载」能再点一次（服务端会回 409），进度条也不动。
    if (!!s.running !== !!state.running) setRunning(!!s.running);
    if (!state.running && s.last) renderSummary(s.last);
  } catch (error){
    // 以前这里是空 catch：渲染一抛错，界面就停在「已连接 + 我的店铺」这种半截状态，
    // 控制台里一点痕迹都没有。至少留个可查的痕迹，别再吞掉。
    window.__stateErr = (error && (error.stack || error.message)) || String(error);
    console.warn('[控制台] 状态刷新失败：', error);
  }
}

