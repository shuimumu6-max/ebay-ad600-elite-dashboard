/* ---------- 看板数据体检 ---------- */
function fmtMd(iso){ return iso ? iso.slice(5).replace('-', '/') : '–'; }
function fmtRange(r){ return r.start === r.end ? fmtMd(r.start) : `${fmtMd(r.start)}~${fmtMd(r.end)}`; }
function fmtWhen(iso){
  if (!iso) return '—';
  const d = new Date(iso);
  if (isNaN(d)) return '—';
  const p = n => String(n).padStart(2, '0');
  return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
}

function renderScan(r){
  if (!r || !r.ok){ $('#scanBody').innerHTML = '<div class="empty">扫描失败</div>'; return; }
  const rows = r.rows || [];
  let lastGroup = '';
  const body = rows.map(row => {
    let badge, cover;
    if (row.nothingYet){
      badge = `<span class="badge err">全缺 ${row.missingDays} 天</span>`;
      cover = '还没有任何数据';
    } else if (row.missingDays > 0){
      badge = `<span class="badge warn">缺 ${row.missingDays} 天</span>`;
      cover = `覆盖 ${row.coveredDays} 天 · 最新 ${fmtMd(row.last)}${row.lagDays ? `（滞后 ${row.lagDays} 天）` : ''}`;
    } else {
      badge = '<span class="badge ok">齐全</span>';
      cover = `覆盖 ${row.coveredDays} 天 · 最新 ${fmtMd(row.last)}`;
    }
    const chips = (row.missingRanges || []).map(x => `<span class="gapchip" data-key="${row.key}" data-s="${x.start}" data-e="${x.end}" title="点一下，直接填进上面的下载表单">${fmtRange(x)}${x.days > 1 ? ` (${x.days}天)` : ''}</span>`).join('');
    // PLP 三份报表收在同一个分组标题下，避免重复写三遍「PLP 链接广告」
    const head = row.group && row.group !== lastGroup
      ? `<div class="srow grp"><div class="sl"><span class="sl-name">${row.group}</span><span class="sl-note">优先促销刊登 · 3 份报表</span></div><div class="sm">Listing / Keyword / Search Query</div><div></div><div></div></div>`
      : '';
    if (row.group) lastGroup = row.group;
    return head + `<div class="srow${row.group ? ' sub' : ''}">
      <div class="sl"><span class="sl-name">${row.label}</span>${row.note ? `<span class="sl-note">${row.note}</span>` : ''}</div>
      <div class="sm" title="${cover}">${cover}</div>
      <div>${badge}</div>
      <div class="gaps">${chips || '<span style="color:var(--ink-3)">—</span>'}</div>
    </div>`;
  }).join('');

  const s = r.sync || {};
  let syncHtml;
  if (!s.checked){
    syncHtml = '<span style="color:var(--ink-3)">线上状态没读到（离线或网络不通，本地缺口仍然准）</span>';
  } else if (s.onlineStale){
    syncHtml = '<span style="color:var(--warn);font-weight:600">线上看板落后于本地：点「只更新看板」即可同步</span>';
  } else if (s.localNotRegenerated){
    syncHtml = '<span style="color:var(--warn);font-weight:600">本地有新数据没进看板：点「只更新看板」重新生成</span>';
  } else {
    syncHtml = '<span style="color:var(--ok);font-weight:600">线上看板与本地数据一致</span>';
  }

  $('#scanBody').innerHTML = `
    <div class="stable">
      <div class="srow head"><span>报表</span><span>覆盖情况</span><span>状态</span><span>缺哪几天</span></div>
      ${body}
    </div>
    <div class="scan-foot">
      统计区间 <b>${fmtMd(r.windowStart)} ~ ${fmtMd(r.windowEnd)}</b> · 扫了 ${r.scannedFiles} 份 CSV · 共缺 <b>${r.totalMissing}</b> 天　|　${syncHtml}<br>
      看板数据生成于 ${fmtWhen(s.localBundleAt)} · 线上 ${fmtWhen(s.onlineBundleAt)}
    </div>`;
  $('#scanSub').textContent = r.totalMissing ? `共缺 ${r.totalMissing} 天数据` : '各类报表都不缺';
  const fillBtn = $('#btnGapFill');
  if (fillBtn) fillBtn.disabled = !r.totalMissing || !!state.running;
}

// 一键补齐：只下缺的那些天 → 归档 → 更新看板。PLP 走 campaign 页（区间精确），PLG 走报表中心预设。
