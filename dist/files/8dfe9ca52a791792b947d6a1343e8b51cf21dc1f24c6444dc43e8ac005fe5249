<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>eBay 报表控制台</title>
<style>
  /* ======== Design tokens：TOPDON 深蓝主色 + 极小面积橙点缀 ======== */
  :root{
    --bg:#f3f5f9; --panel:#fff; --sunk:#fafbfd;
    --line:#e8ecf2; --line-2:#dbe1ea; --line-3:#c9d2e0;
    --ink:#0d1726; --ink-2:#465366; --ink-3:#76839a; --ink-4:#9aa5b6;
    --brand:#0b4da2; --brand-2:#083a7d; --brand-3:#0a6bc4;
    --brand-soft:#eff4fc; --brand-line:#d3e1f6;
    --accent:#e06a0d; --accent-soft:#fdf4ea; --accent-line:#f3dcc4;
    --ok:#0f7a52; --ok-soft:#ebf6f1; --ok-line:#cbe8db;
    --warn:#9a6410; --warn-soft:#fdf6e8; --warn-line:#efdcc0;
    --err:#bf3b3b; --err-soft:#fdefef; --err-line:#f3d4d4;
    --r-lg:12px; --r:10px; --r-sm:8px;
    --sh-1:0 1px 2px rgba(13,23,38,.05);
    --sh-2:0 1px 2px rgba(13,23,38,.05),0 10px 26px -22px rgba(13,23,38,.5);
  }
  *{box-sizing:border-box}
  [hidden]{display:none !important}
  html{height:100%;scroll-padding-top:calc(var(--topbar-h,140px) + 12px)}
  body{height:100%}
  body{
    margin:0;background:var(--bg);color:var(--ink);
    font:13px/1.55 -apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
    font-variant-numeric:tabular-nums;
  }
  button{font:inherit;color:inherit;cursor:pointer}
  input,select{font:inherit;color:inherit}
  a{color:var(--brand);text-decoration:none}
  .app{max-width:1400px;margin:0 auto;padding:18px 22px 40px}

  /* ---------- 顶栏：全站唯一深色区块，作为层级锚点 ---------- */
  .top{display:flex;align-items:center;gap:14px;padding:11px 18px;margin-bottom:0;
    background:#0c1f3c;border:1px solid #16304f;border-radius:var(--r-lg);
    box-shadow:0 12px 30px -26px rgba(12,31,60,.9)}
  .brand{display:flex;align-items:center;gap:12px;min-width:0}
  .logo{width:34px;height:34px;border-radius:8px;background:#fff;
    display:grid;place-items:center;color:var(--brand);font-weight:700;font-size:14px;
    letter-spacing:.2px;flex:none}
  .brand h1{margin:0;font-size:15.5px;font-weight:600;line-height:1.35;letter-spacing:.1px;color:#fff;
    display:flex;align-items:center;flex-wrap:wrap;gap:2px}
  .byline{margin-left:9px;padding:1px 8px;border-radius:5px;font-size:11px;font-weight:500;
    color:#ffc08a;background:rgba(224,106,13,.16);border:1px solid rgba(224,106,13,.36);letter-spacing:.2px}
  .top-right{margin-left:auto;display:flex;align-items:center;gap:7px;flex-wrap:wrap}
  .pill{display:inline-flex;align-items:center;gap:7px;height:28px;padding:0 10px;border-radius:6px;
    background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.13);
    font-size:11.5px;color:#d5e0ef;letter-spacing:.1px}
  .dot{width:6px;height:6px;border-radius:50%;background:#7d8ba1;flex:none}
  .dot.ok{background:#3ecf8e;box-shadow:0 0 0 3px rgba(62,207,142,.16)}
  .dot.bad{background:#f4736f;box-shadow:0 0 0 3px rgba(244,115,111,.16)}
  .dot.busy,.dot.wait{background:#f0b357;box-shadow:0 0 0 3px rgba(240,179,87,.16);animation:pulse 1.1s infinite}
  @keyframes pulse{50%{opacity:.3}}
  .link{background:none;border:0;padding:0;color:#9dc0ff;font-size:11.5px;text-decoration:underline;text-underline-offset:2px}
  .tlink{display:inline-flex;align-items:center;gap:4px;height:28px;padding:0 8px;font-size:11.5px;
    color:#b9cdea;font-weight:500;border-radius:6px;transition:.15s}
  .tlink:hover{background:rgba(255,255,255,.09);color:#fff}

  /* ---------- 骨架 ---------- */
  /* 吸顶区：顶栏 + 视图切换一起冻结。负 margin 抵消 .app 顶部留白，
     外层底色不透明 + 底部细线/浅阴影，滚动时内容从下方穿过而不是透出 */
  .topbar{position:sticky;top:0;z-index:30;display:flex;flex-direction:column;gap:10px;
    margin:-10px 0 0;padding:10px 0 10px;background:var(--bg);
    border-bottom:1px solid transparent;transition:border-color .18s,box-shadow .18s}
  .topbar.stuck{border-bottom-color:var(--line);box-shadow:0 10px 22px -26px rgba(13,23,38,.9)}
  .topbar .viewtabs{margin-bottom:0}

  .workspace{display:grid;grid-template-columns:minmax(0,1fr) 412px;gap:16px;align-items:start}

  /* ---------- 首次使用引导：装完第一次打开就能用，不用研究下哪些报表 ---------- */
  .firstrun{display:flex;gap:18px;align-items:center;justify-content:space-between;flex-wrap:wrap;
    margin:0 0 16px;padding:16px 20px;border:1px solid #cfe2f7;border-radius:12px;
    background:linear-gradient(180deg,#f7fbff,#edf5ff)}
  .firstrun[hidden]{display:none}
  .firstrun h3{margin:0 0 7px;font-size:15px;font-weight:600;color:var(--ink);letter-spacing:.01em}
  .firstrun p{margin:0;font-size:12.5px;line-height:1.75;color:var(--ink-3);max-width:780px}
  .firstrun .fr-hint{margin-top:5px;color:var(--ink-4)}
  .firstrun .fr-actions{display:flex;gap:8px;flex:0 0 auto;align-items:center}
  .firstrun .fr-actions .btn.primary{height:38px;padding:0 18px;font-size:13px}
  @media (max-width:1120px){.firstrun{padding:14px 16px}}
  @media (max-width:1360px){.workspace{grid-template-columns:minmax(0,1fr) 388px}}
  @media (max-width:1120px){
    .app{padding:14px 14px 32px}
    .workspace{grid-template-columns:minmax(0,1fr) 364px;gap:13px}
  }
  aside{position:sticky;top:calc(var(--topbar-h,140px) + 12px);display:flex;flex-direction:column;gap:16px;
    max-height:calc(100vh - var(--topbar-h,140px) - 64px);overflow:auto}
  @media (max-width:960px){
    .workspace{grid-template-columns:1fr}
    aside{position:static;max-height:none;overflow:visible}
  }
  aside::-webkit-scrollbar{width:7px}
  aside::-webkit-scrollbar-thumb{background:#d5dce6;border-radius:99px}

  .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:var(--sh-1)}
  .panel + .panel{margin-top:16px}
  aside .panel + .panel{margin-top:0}
  .panel-h{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid var(--line)}
  .panel-h h2{margin:0;font-size:12px;font-weight:600;letter-spacing:.06em;color:#5a6a80}
  .panel-sub{font-size:11.5px;color:var(--ink-4);letter-spacing:.1px}
  .panel-b{padding:14px 16px 16px}
  .wide{margin-top:16px}

  /* ---------- 报表卡片：靠左侧色条与底色分层，不用彩色描边 ---------- */
  .cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;padding:14px 16px 16px}
  .card{border:1px solid var(--line);border-radius:var(--r);background:#fbfcfe;transition:border-color .16s,background .16s,box-shadow .16s}
  .card:not(.off){background:#fff;border-color:#dee5ef;box-shadow:inset 2px 0 0 var(--brand-line),var(--sh-1)}
  .card.span2{grid-column:span 2}
  @media (max-width:960px){.cards{grid-template-columns:minmax(0,1fr)}.card.span2{grid-column:auto}}
  .card-h{display:flex;align-items:center;gap:7px;padding:10px 12px;border-bottom:1px solid #f0f3f8}
  .card-h h2{margin:0;font-size:13px;font-weight:600;color:var(--ink);letter-spacing:.1px;
    flex:none;white-space:nowrap}
  /* 备注标签一律单行：不换行、不被压缩，空间不够时让后面的副标题先截断 */
  .card-h .tag{font-size:10.5px;color:var(--ink-3);border:1px solid var(--line-2);border-radius:4px;
    padding:0 5px;line-height:16px;letter-spacing:.1px;background:#fff;
    flex:none;white-space:nowrap}
  .card-h .sub{font-size:11px;color:var(--ink-4);margin-left:2px;letter-spacing:.1px;
    min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .card-h .sw{margin-left:auto;flex:none}
  .card-b{padding:11px 12px 12px}
  .card.off .card-b{opacity:.42;pointer-events:none;filter:saturate(.2)}
  .card.off{border-color:#eef1f6;background:#fbfcfe}
  .card.off .card-h{background:transparent}
  .card.off .card-h h2{color:var(--ink-3);font-weight:500}
  /* 主路径卡片：顶部细蓝线 + 白底，克制地突出，不做渐变 */
  .card.primary{border-color:#cfdcef;box-shadow:inset 0 2px 0 var(--brand),inset 2px 0 0 var(--brand),var(--sh-2)}
  .card.primary .card-h{background:#fbfdff;border-bottom-color:#e6edf7}
  .card.primary .card-h h2{color:var(--brand)}

  /* 开关 */
  .sw{position:relative;width:32px;height:18px;flex:none}
  .sw input{position:absolute;opacity:0;width:100%;height:100%;margin:0;cursor:pointer;z-index:2}
  .sw i{position:absolute;inset:0;border-radius:999px;background:#d7dee8;transition:.18s}
  .sw i:after{content:"";position:absolute;width:12px;height:12px;border-radius:50%;background:#fff;top:3px;left:3px;
    transition:.18s;box-shadow:0 1px 2px rgba(13,23,38,.25)}
  .sw input:checked + i{background:var(--brand)}
  .sw input:checked + i:after{transform:translateX(14px)}

  /* ---------- 表单：统一 34px 高度与 8px 圆角 ---------- */
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
  .field{display:flex;flex-direction:column;gap:5px;min-width:0}
  .field label{font-size:11px;color:var(--ink-3);letter-spacing:.2px}
  input[type=date],input[type=text],select{
    height:33px;padding:0 9px;border:1px solid var(--line-2);border-radius:var(--r-sm);background:#fff;
    min-width:140px;transition:border-color .15s,box-shadow .15s;font-size:12.5px;color:var(--ink)
  }
  input[type=date]:hover,input[type=text]:hover,select:hover{border-color:var(--line-3)}
  input[type=date]:focus,input[type=text]:focus,select:focus{
    outline:none;border-color:var(--brand-3);box-shadow:0 0 0 3px rgba(10,107,196,.1)}
  input[type=text]{min-width:100%;width:100%}
  .seg{display:inline-flex;background:#f0f3f8;border-radius:var(--r-sm);padding:2px;gap:2px;flex-wrap:wrap;
    border:1px solid #edf1f7}
  .seg button{border:0;background:none;padding:4px 11px;border-radius:6px;font-size:12px;color:var(--ink-2);transition:.14s}
  .seg button:hover{color:var(--ink)}
  .seg button.on{background:#fff;color:var(--brand);font-weight:600;box-shadow:0 1px 2px rgba(13,23,38,.1)}
  #segSync{display:flex;width:100%}
  #segSync button{flex:1;padding:4px 6px}
  .chips{display:flex;gap:6px;flex-wrap:wrap}
  .chip{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border:1px solid var(--line-2);
    border-radius:6px;background:#fff;font-size:12px;color:var(--ink-2);cursor:pointer;user-select:none;transition:.15s}
  .chip:hover{border-color:var(--line-3);color:var(--ink)}
  .chip input{display:none}
  .chip.on{border-color:var(--brand-line);background:var(--brand-soft);color:var(--brand);font-weight:600}
  .chip .m{font-variant-numeric:tabular-nums;color:var(--ink-4);font-size:10.5px;letter-spacing:.2px}
  .chip.dim{color:var(--ink-4);border-style:dashed}
  .chip .todo{font-style:normal;font-size:10px;line-height:1;padding:2px 4px;border-radius:3px;
    background:#f4f6fa;color:var(--ink-4);border:1px solid #e9edf4}
  .chip.on .todo{background:#fff;color:#a8560f;border-color:var(--accent-line)}
  .chip.on .m{color:var(--brand-3)}

  /* 活动多选下拉 */
  .dd{position:relative;width:100%;max-width:560px}
  .dd-btn{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;height:34px;
    padding:0 11px;border:1px solid var(--line-2);border-radius:var(--r-sm);background:#fff;
    font-size:12.5px;font-family:inherit;text-align:left;transition:.15s}
  .dd-btn:hover{border-color:var(--line-3)}
  .dd-btn.on{border-color:var(--brand-3);box-shadow:0 0 0 3px rgba(10,107,196,.1)}
  .dd-sum{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--ink)}
  .dd-caret{color:var(--ink-4);font-size:10px;flex:none;transition:transform .15s}
  .dd-btn.on .dd-caret{transform:rotate(180deg)}
  .dd-panel{position:absolute;z-index:40;top:calc(100% + 6px);left:0;width:100%;min-width:360px;
    background:#fff;border:1px solid var(--line-2);border-radius:var(--r);box-shadow:var(--sh-2);padding:10px}
  .dd-search{height:30px;font-size:12px;width:100%}
  .dd-quick{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0}
  .dd-quick .chip{height:24px;padding:0 8px;font-size:11px}
  .dd-list{max-height:224px;overflow:auto;border:1px solid var(--line);border-radius:6px;padding:3px}
  .dd-opt{display:flex;align-items:flex-start;gap:8px;padding:6px 7px;border-radius:5px;
    font-size:12px;color:var(--ink-2);line-height:1.45;cursor:pointer}
  .dd-opt:hover{background:#f6f9fe}
  .dd-opt.on{background:var(--brand-soft);color:var(--brand)}
  .dd-opt input{margin-top:2px;accent-color:var(--brand);flex:none}
  .dd-opt .nm{overflow-wrap:break-word;word-break:normal}
  .dd-opt .plp{flex:none;font-size:9.5px;font-weight:600;color:#a8560f;
    background:var(--accent-soft);border:1px solid var(--accent-line);border-radius:3px;padding:0 4px;line-height:15px}
  .dd-empty{padding:14px;text-align:center;color:var(--ink-4);font-size:11.5px}
  .dd-foot{display:flex;align-items:center;justify-content:space-between;margin-top:8px;
    font-size:11.5px;color:var(--ink-4)}
  .dd-done{height:26px;padding:0 12px;border:0;border-radius:5px;background:var(--brand);color:#fff;font-size:11.5px}
  .dd-done:hover{background:var(--brand-2)}

  .card.locked{background:#fbfcfe;border-style:dashed;border-color:#e9edf4}
  .card.locked .chip{color:var(--ink-4);border-color:#eceff5;background:#fff;pointer-events:none}
  .soon{font-size:10px;font-weight:600;color:#8a6413;background:var(--warn-soft);border:1px solid var(--warn-line);
    border-radius:4px;padding:0 5px;line-height:16px;white-space:nowrap}
  .hint{font-size:11.5px;color:var(--ink-3);margin:8px 0 0;line-height:1.6;letter-spacing:.1px}
  .hint b{color:var(--ink-2);font-weight:600}
  .mt12{margin-top:12px}
  .mt8{margin-top:8px}

  /* ---------- 按钮 ---------- */
  .btn{height:33px;padding:0 13px;border-radius:var(--r-sm);border:1px solid var(--line-2);background:#fff;
    font-size:12.5px;font-weight:500;transition:.15s;white-space:nowrap;
    display:inline-flex;align-items:center;justify-content:center;gap:6px;color:var(--ink-2)}
  .btn:hover{border-color:var(--line-3);background:#fafbfd;color:var(--ink)}
  .btn:active{transform:translateY(.5px)}
  .btn.primary{background:var(--brand);border-color:var(--brand);color:#fff;font-weight:600}
  .btn.primary:hover{background:var(--brand-2);border-color:var(--brand-2)}
  .btn.lg{height:40px;font-size:13px;font-weight:600;border-radius:var(--r)}
  .btn.danger{color:var(--err);border-color:var(--err-line);background:#fff}
  .btn:disabled{opacity:.42;cursor:not-allowed;transform:none}

  /* ---------- 执行卡 ---------- */
  .run-top{display:flex;gap:8px}
  .run-top .btn.primary{flex:1}
  .bar{height:2px;background:#eef1f6;overflow:hidden;border-radius:99px;margin-top:12px}
  .bar i{display:block;height:100%;width:0%;background:var(--brand);transition:width .4s}
  .runHint{font-size:11.5px;color:var(--ink-3);margin:8px 0 0;min-height:17px;line-height:1.55}
  .sect{margin-top:14px;padding-top:13px;border-top:1px solid var(--line)}
  .sect-t{font-size:10.5px;color:var(--ink-4);letter-spacing:.1em;font-weight:600;margin-bottom:8px}

  /* ---------- 日志 ---------- */
  .log{height:300px;overflow:auto;background:#0c1521;border:1px solid #17233a;border-radius:var(--r);
    padding:11px 13px;font:12px/1.65 "Cascadia Mono",Consolas,"Courier New",monospace;color:#c3cfdf;
    white-space:pre-wrap;word-break:break-all}
  .log .l-ok{color:#62d6a0}
  .log .l-warn{color:#e3b566}
  .log .l-err{color:#f08b8b}
  .log .l-dim{color:#6c7a8d}
  .log .l-head{color:#7fb0f0}
  .log::-webkit-scrollbar{width:7px}
  .log::-webkit-scrollbar-thumb{background:#26334a;border-radius:99px}

  /* ---------- 结果 ---------- */
  .stats{display:flex;gap:8px}
  .stat{flex:1;border:1px solid var(--line);border-radius:var(--r-sm);padding:9px 11px;background:var(--sunk)}
  .stat b{display:block;font-size:19px;font-weight:600;line-height:1.2;color:var(--ink);letter-spacing:-.01em}
  .stat span{font-size:10.5px;color:var(--ink-4);letter-spacing:.2px}
  .files{margin-top:10px;max-height:250px;overflow:auto;border:1px solid var(--line);border-radius:var(--r-sm)}
  .fitem{padding:8px 11px;border-bottom:1px solid #f3f5f9}
  .fitem:last-child{border-bottom:0}
  .fmeta{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--ink-4);flex-wrap:wrap}
  .ftag{background:#f2f5fa;color:#55647a;border-radius:4px;padding:0 5px;font-size:10.5px;line-height:16px}
  .fname{font-size:11.5px;color:var(--ink-2);word-break:break-all;margin-top:2px;line-height:1.5}
  .fproblem{font-size:11px;color:var(--warn);margin-top:2px}
  .okmark{color:var(--ok);font-weight:600}
  .badmark{color:var(--err);font-weight:600}
  .empty{color:var(--ink-4);font-size:12px;padding:18px;text-align:center}

  /* ---------- 数据体检 ---------- */
  .scanbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .stable{margin-top:12px;border:1px solid var(--line);border-radius:var(--r-sm);overflow:hidden}
  .srow{display:grid;grid-template-columns:150px 214px 74px minmax(0,1fr);gap:10px;align-items:center;
    padding:7px 12px;border-bottom:1px solid #f3f5f9;font-size:12px}
  .srow:last-child{border-bottom:0}
  .srow.head{background:var(--sunk);font-size:10.5px;color:var(--ink-4);font-weight:600;letter-spacing:.06em}
  .srow .sl{font-weight:600;color:var(--ink);display:flex;flex-direction:column;align-items:flex-start;gap:1px;line-height:1.35}
  .srow .sl-note{font-size:10px;font-weight:400;color:var(--ink-4);letter-spacing:.1px;white-space:nowrap}
  .srow.grp{background:var(--sunk);padding:6px 12px}
  .srow.grp .sl-note{font-size:10.5px;color:var(--ink-3);font-weight:500}
  .srow.sub .sl{padding-left:13px}
  .srow.sub .sl-name{font-weight:500;color:var(--ink-2)}
  .srow .sm{color:var(--ink-3);font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .badge{font-size:10.5px;font-weight:600;border-radius:4px;padding:0 6px;line-height:17px;white-space:nowrap}
  .badge.ok{color:var(--ok);background:var(--ok-soft)}
  .badge.warn{color:var(--warn);background:var(--warn-soft)}
  .badge.err{color:var(--err);background:var(--err-soft)}
  .gaps{display:flex;gap:4px;flex-wrap:wrap}
  .gapchip{font:11px/1.5 "Cascadia Mono",Consolas,monospace;background:var(--warn-soft);color:#8a5a0c;
    border:1px solid var(--warn-line);border-radius:4px;padding:0 5px;cursor:pointer;transition:.14s}
  .gapchip:hover{background:#fbeed6;border-color:#e5cda2}
  .gapchip.dead{cursor:default;background:#f7f9fc;border-color:var(--line);color:var(--ink-4)}
  .scan-foot{margin-top:10px;font-size:11.5px;color:var(--ink-3);line-height:1.7}
  .scan-foot b{color:var(--ink-2)}
  @media (max-width:980px){.srow{grid-template-columns:110px 1fr;row-gap:4px}.srow .sm{grid-column:2;white-space:normal}}

  /* ---------- 提示 ---------- */
  .toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,14px);opacity:0;pointer-events:none;
    background:#0c1f3c;color:#fff;font-size:12.5px;padding:9px 14px;border-radius:var(--r-sm);transition:.22s;
    z-index:50;max-width:80vw;box-shadow:0 10px 30px -16px rgba(12,31,60,.8)}
  .toast.on{opacity:1;transform:translate(-50%,0)}
  .toast.bad{background:var(--err)}

  /* ---------- 视图切换 ---------- */
  .viewtabs{display:flex;align-items:center;gap:3px;margin:0 0 14px;padding:3px;background:var(--panel);
    border:1px solid var(--line);border-radius:var(--r);width:fit-content;box-shadow:var(--sh-1)}
  .viewtabs button{border:0;background:none;padding:6px 14px;border-radius:6px;font-size:12.5px;font-weight:500;
    color:var(--ink-3);transition:.15s}
  .viewtabs button:hover{color:var(--ink-2)}
  .viewtabs button.on{background:var(--brand);color:#fff;font-weight:600}
  .flink{border:1px solid var(--brand-line);background:var(--brand-soft);border-radius:5px;padding:0 6px;height:20px;
    font-size:11px;color:var(--brand);font-weight:600;margin-right:8px;white-space:nowrap}
  .flink:hover{background:#e4eefb}

  /* ---------- 字段字典 ---------- */
  .fld-wrap{display:grid;grid-template-columns:262px minmax(0,1fr);gap:16px;align-items:start}
  .fld-side .panel-b{padding:10px 10px 12px}
  .fld-search{width:100%;height:32px;border:1px solid var(--line-2);border-radius:var(--r-sm);padding:0 10px;
    font-size:12px;background:#fff;margin-bottom:9px;outline:none}
  .fld-search:focus{border-color:var(--brand-3);box-shadow:0 0 0 3px rgba(10,107,196,.1)}
  .fld-group{display:flex;align-items:center;gap:7px;width:100%;margin:8px 0 2px;padding:5px 6px;
    border:0;border-radius:5px;background:#f4f7fb;font-size:11px;font-weight:600;letter-spacing:.04em;
    color:#56657b;text-align:left}
  .fld-group:hover{background:#ecf2fa}
  .fld-group:first-child{margin-top:2px}
  .fld-group .caret{font-size:9px;color:var(--ink-4);width:9px;flex:none;transition:transform .15s}
  .fld-group.collapsed .caret{transform:rotate(-90deg)}
  .fld-group .gname{flex:1;min-width:0}
  .fld-group .gremark{font-size:9.5px;font-weight:500;color:#8a5a0c;background:var(--warn-soft);
    border:1px solid var(--warn-line);border-radius:3px;padding:0 4px;line-height:15px;flex:none;letter-spacing:0}
  .fld-group .gcnt{font-size:10px;color:var(--ink-4);flex:none}
  .fld-items{padding:1px 0 2px}
  .fld-items[hidden]{display:none !important}
  .fld-cat{font-size:10.5px;font-weight:600;color:var(--ink);margin-bottom:7px;line-height:1.45;letter-spacing:.04em}
  .fld-cat small{display:block;font-weight:400;color:var(--ink-4);font-size:10px;letter-spacing:0}
  .fld-item{display:flex;align-items:center;gap:8px;width:100%;text-align:left;border:0;background:none;
    padding:6px 8px;border-radius:5px;font-size:12px;color:var(--ink-2);transition:.13s}
  .fld-item:hover{background:#f6f9fe;color:var(--ink)}
  .fld-item.on{background:var(--brand-soft);color:var(--brand);font-weight:600}
  .fld-item .n{margin-left:auto;font-size:10.5px;color:var(--ink-4)}
  .fld-item.on .n{color:var(--brand-3)}
  .fld-meta{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}
  .mchip{font-size:11px;padding:1px 7px;border-radius:4px;background:var(--sunk);
    border:1px solid var(--line);color:var(--ink-3);letter-spacing:.1px}
  .mchip b{font-weight:600;color:var(--ink-2)}
  .mchip.ok{background:var(--ok-soft);border-color:var(--ok-line);color:var(--ok)}
  .mchip.todo{background:var(--warn-soft);border-color:var(--warn-line);color:var(--warn)}

  .ftable{width:100%;border-collapse:collapse;font-size:12px;table-layout:fixed}
  .ftable th{position:sticky;top:0;background:#fafbfd;text-align:left;font-size:10.5px;font-weight:600;
    color:var(--ink-4);padding:8px 10px;border-bottom:1px solid var(--line);z-index:1;letter-spacing:.06em}
  .ftable td{padding:6px 10px;border-bottom:1px solid #f4f6fa;vertical-align:top}
  .ftable tr:last-child td{border-bottom:0}
  .ftable tr:hover td{background:#fcfdff}
  .fname{font-weight:500;color:var(--ink);font-family:"Cascadia Mono",Consolas,monospace;font-size:11.5px;
    overflow-wrap:break-word;word-break:normal;line-height:1.5}
  .fgrp{display:inline-block;font-size:10.5px;padding:0 5px;border-radius:4px;background:#f2f5fa;color:var(--ink-3);white-space:nowrap}
  .fcsv{font-family:"Cascadia Mono",Consolas,monospace;font-size:11px;color:var(--ink-2);line-height:1.65}
  .fcsv .c{display:inline-block;background:#f7f9fc;border:1px solid #e9eef6;border-radius:3px;
    padding:0 5px;margin:1px 3px 1px 0;color:#2b4a6f}
  .fcsv .none{color:var(--ink-4)}
  .fnote{margin-top:7px;font-size:11px;color:var(--warn);line-height:1.55}
  .fblock{margin-top:14px;border-top:1px solid var(--line);padding-top:11px}
  .fblock-t{font-size:10.5px;font-weight:600;color:var(--ink-4);margin-bottom:7px;letter-spacing:.08em}
  .scroll{max-height:max(240px,calc(100vh - var(--topbar-h,140px) - 150px));overflow:auto}
  .hits{display:flex;flex-direction:column;gap:8px}
  .hit{border:1px solid var(--line);border-radius:var(--r-sm);padding:9px 11px;background:#fff}
  .hit-h{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;color:var(--ink)}
  .hit-h .fname{font-size:12px}
  .hit-r{margin-top:5px;display:flex;flex-direction:column;gap:3px}
  .hit-r .r{font-size:11.5px;color:var(--ink-2);display:flex;gap:7px;align-items:baseline}
  .hit-r .r b{font-weight:600;color:var(--ink);min-width:132px}
  .gtag{font-size:10.5px;color:var(--ink-4);border:1px solid var(--line);border-radius:4px;padding:0 5px;white-space:nowrap}
  @media (max-width:900px){.fld-wrap{grid-template-columns:1fr}.scroll{max-height:none}}
  /* 归档完成后的提示动画：让「打开看板」这个按钮自己跳出来，不用用户找 */
  .pulse{animation:pulseGlow 1.5s ease-in-out 4}
  @keyframes pulseGlow{0%,100%{box-shadow:0 0 0 0 rgba(11,77,162,0)}50%{box-shadow:0 0 0 5px rgba(11,77,162,.28)}}
</style>
</head>
<body>
<div class="app">

  <!-- 顶栏 + 视图切换：整块吸顶，下滑时随时能切「下载报表 / 字段字典」 -->
  <div class="topbar" id="topbar">
    <div class="top">
      <div class="brand">
        <div class="logo">eB</div>
        <div>
          <h1>eBay 报表控制台<span class="byline">—— 管培长沙项目组</span></h1>
        </div>
      </div>
      <div class="top-right">
        <div class="pill"><span class="dot" id="dotChrome"></span><span id="txtChrome">检查浏览器…</span>
          <button class="link" id="btnFix" hidden>去开开关</button></div>
        <div class="pill"><span class="dot ok" id="dotShop"></span><span id="txtShop">我的店铺</span>
          <button class="link" id="btnShopName" title="只是个显示名，随时能改">改名</button></div>
        <div class="pill"><span class="dot" id="dotRun"></span><span id="txtRun">空闲</span></div>
        <a class="tlink" id="linkDash" href="#" target="_blank" rel="noopener">在线看板 ↗</a>
      </div>
    </div>

    <nav class="viewtabs" id="viewTabs">
      <button data-view="download" class="on">下载报表</button>
      <button data-view="fields">字段字典</button>
    </nav>
  </div>

  <div id="viewDownload">

  <!-- 首次使用引导：只在下载结果里还没有 CSV 时出现，点一次就有 30 天数据 -->
  <div class="firstrun" id="firstRun" hidden>
    <div class="fr-body">
      <h3>第一次用？点一下，自动把最近 30 天的数据下下来</h3>
      <p>会先自动识别你的店铺（只读浏览器里的登录账号，不用填任何东西），然后依次下载：流量报表（逐日 30 份）、在售商品名单、PLG 链接广告与优先促销刊登（本周 + 上周——eBay 的广告「按日」数据只给这两周）。大概 20~30 分钟，全程自动，可以最小化窗口，但别关控制台。</p>
      <p class="fr-hint">下完这些会自动归档，打开看板就能看到数据。eBay 对流量报表有频率限制，偶尔会中途说「先歇一会儿」——已经下好的不会重复，过 1 小时点右侧「补齐缺口 + 更新看板」接着补就行。</p>
    </div>
    <div class="fr-actions">
      <button class="btn primary" id="btnFirstRun">自动下载最近 30 天</button>
      <button class="btn" id="btnFirstRunSkip">不用，我自己选</button>
    </div>
  </div>

  <div class="workspace">

    <!-- 左：选报表 -->
    <main>
      <section class="panel">
        <div class="panel-h">
          <h2>下载哪些报表</h2>
          <span class="panel-sub">右侧开关决定这次下不下，卡片里选时间</span>
        </div>
        <div class="cards">

          <!-- Traffic -->
          <div class="card span2" id="cardTraffic">
            <div class="card-h">
              <h2>流量报表</h2><span class="tag">Traffic</span>
              <span class="sub" id="subTraffic">单日</span>
              <label class="sw"><input type="checkbox" id="enTraffic" checked><i></i></label>
            </div>
            <div class="card-b">
              <div class="row">
                <div class="field">
                  <label>时间模式</label>
                  <div class="seg" id="segTraffic">
                    <button data-v="daily" class="on">单日</button>
                    <button data-v="range">累计区间</button>
                    <button data-v="both">两者都下</button>
                    <button data-v="batch">批量多日</button>
                  </div>
                </div>
                <div class="field" id="fRangeStart" hidden>
                  <label>累计起始日</label>
                  <input type="date" id="rangeStart">
                </div>
                <div class="field" id="fRangeEnd" hidden>
                  <label>累计结束日（留空 = 同统计日期）</label>
                  <input type="date" id="rangeEnd">
                </div>
                <div class="field" id="fTrafficDate">
                  <label id="lbTrafficDate">统计日期（太平洋时间）</label>
                  <input type="date" id="trafficDate">
                </div>
                <div class="field" id="fBatch" hidden style="flex:1">
                  <label>日期范围或列表</label>
                  <input type="text" id="batchDates" placeholder="2026-11-01..2026-11-05">
                  <div class="chips mt8">
                    <button class="chip" data-quick="3">最近 3 天</button>
                    <button class="chip" data-quick="7">最近 7 天</button>
                  </div>
                </div>
              </div>
              <p class="hint" id="hintTraffic">下载指定单日的流量明细（一条记录一天）。</p>
            </div>
          </div>

          <!-- PLG -->
          <div class="card off span2" id="cardPlg">
            <div class="card-h">
              <h2>PLG 链接广告</h2><span class="tag">报表中心 · 常规</span>
              <span class="sub" id="subPlg"></span>
              <label class="sw"><input type="checkbox" id="enPlg"><i></i></label>
            </div>
            <div class="card-b">
              <div class="row">
                <div class="field">
                  <label>时间粒度</label>
                  <div class="seg" id="segUnit">
                    <button data-v="DAILY" class="on">按日</button>
                    <button data-v="SUMMARY">汇总</button>
                  </div>
                </div>
                <div class="field">
                  <label>日期范围</label>
                  <select id="plgRange">
                    <option value="">本周（默认）</option>
                    <option value="TODAY">今天</option>
                    <option value="YESTERDAY">昨天</option>
                    <option value="CURRENTWEEK">本周</option>
                    <option value="LASTWEEK">上周</option>
                    <option value="CURRENTMONTH">本月</option>
                    <option value="PREVIOUSMONTH">上月</option>
                    <option value="LAST90D">过去 90 天</option>
                  </select>
                </div>
                <!-- 自定义区间已从控制台下线：日常用「本周」即可；输入框只留给一键补齐/CLI 回退读值，不显示 -->
                <div hidden>
                  <input type="date" id="plgCustomStart">
                  <input type="date" id="plgCustomEnd">
                </div>
              </div>
              <div class="row mt12">
                <div class="field">
                  <label>活动（默认全选，可只跑其中几个）</label>
                  <div class="chips" id="plgCampaigns"></div>
                </div>
              </div>
              <p class="hint">按日 = 每天一行明细；汇总 = 只有区间合计。日期范围选预设即可，默认「本周」。</p>
            </div>
          </div>

          <!-- 商品名单 -->
          <div class="card off" id="cardActive">
            <div class="card-h">
              <h2>商品名单</h2><span class="tag">报表中心</span>
              <label class="sw"><input type="checkbox" id="enActive"><i></i></label>
            </div>
            <div class="card-b">
              <div class="field">
                <label>名单类型</label>
                <div class="seg" id="segActive">
                  <button data-v="active" class="on">全部在售</button>
                  <button data-v="unsold">非在售</button>
                  <button data-v="scheduled">预定</button>
                </div>
              </div>
              <p class="hint">在售/预定是当前快照；非在售是过去 90 天未售出且已结束的刊登。</p>
            </div>
          </div>

          <!-- 优先促销刊登 = PLP链接广告（替代原 campaign 页三份明细） -->
          <div class="card primary" id="cardPriority">
            <div class="card-h">
              <h2>优先促销刊登</h2><span class="tag remark">备注：PLP链接广告</span>
              <span class="sub" id="subPriority"></span>
              <label class="sw"><input type="checkbox" id="enPriority" checked><i></i></label>
            </div>
            <div class="card-b">
              <div class="row">
                <div class="field">
                  <label>报表类型（可多选 · 多选会自动排队下载）</label>
                  <div class="chips" id="priorityTypes"></div>
                </div>
              </div>
              <div class="row mt12">
                <div class="field">
                  <label>时间粒度</label>
                  <div class="seg" id="segPriorityUnit">
                    <button data-v="DAILY" class="on">按日</button>
                    <button data-v="SUMMARY">汇总</button>
                  </div>
                </div>
                <div class="field">
                  <label>日期范围</label>
                  <select id="priorityRange">
                    <option value="">本周（默认）</option>
                    <option value="TODAY">今天</option>
                    <option value="YESTERDAY">昨天</option>
                    <option value="CURRENTWEEK">本周</option>
                    <option value="LASTWEEK">上周</option>
                    <option value="CURRENTMONTH">本月</option>
                    <option value="PREVIOUSMONTH">上月</option>
                    <option value="LAST90D">过去 90 天</option>
                  </select>
                </div>
                <!-- 同 PLG：自定义区间不再显示，改用它下面的预设（默认「本周」） -->
                <div hidden>
                  <input type="date" id="priorityCustomStart">
                  <input type="date" id="priorityCustomEnd">
                </div>
              </div>
              <div class="row mt12">
                <div class="field">
                  <label>活动范围（不用管：不勾就是后台全部活动）</label>
                  <div class="dd" id="prCampaignDD">
                    <button type="button" class="dd-btn" id="prCampaignBtn" aria-expanded="false">
                      <span class="dd-sum" id="prCampaignSummary">全部活动</span>
                      <span class="dd-caret">▾</span>
                    </button>
                    <div class="dd-panel" id="prCampaignPanel" hidden>
                      <input type="text" class="dd-search" id="prCampaignSearch" placeholder="搜索活动名称" autocomplete="off">
                      <div class="dd-quick">
                        <button type="button" class="chip" id="prPickPlp">PLP 默认</button>
                        <button type="button" class="chip" id="prPickAll">全部活动</button>
                        <button type="button" class="chip" id="prPickNone">清空（= 全部）</button>
                        <button type="button" class="chip" id="prRefresh">刷新活动列表</button>
                      </div>
                      <div class="dd-list" id="priorityCampaigns"></div>
                      <div class="dd-foot">
                        <span id="prCampaignCount">全部活动</span>
                        <button type="button" class="dd-done" id="prCampaignDone">完成</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 订单报表 -->
          <div class="card off span2" id="cardOrders">
            <div class="card-h">
              <h2>订单报表</h2><span class="tag">报表中心</span>
              <span class="sub" id="subOrders"></span>
              <label class="sw"><input type="checkbox" id="enOrders"><i></i></label>
            </div>
            <div class="card-b">
              <div class="field">
                <label>订单类型（单选）</label>
                <div class="chips" id="orderTypes"></div>
              </div>
              <div class="row mt12">
                <div class="field">
                  <label>日期范围</label>
                  <select id="orderRange">
                    <option value="TODAY">今天</option>
                    <option value="YESTERDAY">昨天</option>
                    <option value="CURRENTWEEK">本周</option>
                    <option value="LASTWEEK">上周</option>
                    <option value="CURRENTMONTH">本月</option>
                    <option value="PREVIOUSMONTH">上月</option>
                    <option value="CURRENTYEAR">今年</option>
                    <option value="PREVIOUSYEAR">去年</option>
                    <option value="LAST90D" selected>过去 90 天</option>
                    <option value="CUSTOM">自定义范围</option>
                  </select>
                </div>
                <div class="field" id="fOrderC1" hidden>
                  <label>开始日期</label>
                  <input type="date" id="orderCustomStart">
                </div>
                <div class="field" id="fOrderC2" hidden>
                  <label>结束日期</label>
                  <input type="date" id="orderCustomEnd">
                </div>
              </div>
              <p class="hint">一次一种类型；要多种就分次跑。订单报表最常用于未发货/逾期/24h 内这几类。</p>
            </div>
          </div>

          <!-- PLP campaign 页通道已从控制台下线：PLP 链接广告统一走上方「优先促销刊登」卡片。
               底层 CLI 仍保留 --campaigns / --plp-* 供手动回退，控制台不再暴露该入口。 -->

        </div>
      </section>

      <!-- 数据体检 -->
      <section class="panel" id="cardScan">
        <div class="panel-h">
          <h2>看板数据体检</h2>
          <span class="panel-sub" id="scanSub">看正式目录里每类报表覆盖到哪天</span>
          <button class="btn primary" id="btnGapFill" style="margin-left:auto" title="逐天串行：一天跑完停 90 秒再跑下一天，全部跑完自动归档并推看板" disabled>补齐缺口 + 更新看板</button>
          <button class="btn" id="btnScan" style="margin-left:8px">扫描缺少的报表</button>
        </div>
        <div class="panel-b">
          <p class="hint" style="margin-top:0">看板数据就是从正式目录生成的，这里缺的看板上也没有。日更口径＝流量单日 + PLG 链接广告 + PLP 链接广告（物品刊登 / 关键词 / 搜索词，走 campaign 页区间汇总）。「补齐缺口 + 更新看板」只下缺的那几天：流量按天精确补、PLG 用能盖住缺口的最小预设（今天/昨天/本周/上周）、PLP 按缺口起止区间，跑完自动归档并推送看板。流量累计只用于对账、活动汇总报表不进看板，均不参与体检；在售商品名单同样不参与。统计到太平洋时间「昨天」为止：今天的数据还没出、不算缺；链接上架之前的空白天也不算缺。</p>
          <div id="scanBody"></div>
        </div>
      </section>
    </main>

    <!-- 右：执行 + 结果 + 日志 -->
    <aside>

      <section class="panel">
        <div class="panel-h">
          <h2>执行</h2><span class="panel-sub" id="planSub"></span>
        </div>
        <div class="panel-b">
          <div class="run-top">
            <button class="btn primary lg" id="btnRun" title="快捷键 Ctrl + Enter">开始下载</button>
            <button class="btn danger" id="btnStop" disabled>停止</button>
          </div>
          <div class="bar"><i id="barFill"></i></div>
          <p class="runHint" id="runHint">就绪。选好选项后点开始（Ctrl + Enter 也行）。</p>
          <div class="field mt8">
            <label>单次最多并行标签页（下载任务数不限，超出自动排队；1–10）</label>
            <select id="maxTabs">
              <option value="1">1（最稳，逐个排队）</option>
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4" selected>4（默认）</option>
              <option value="5">5</option>
              <option value="6">6</option>
              <option value="7">7</option>
              <option value="8">8</option>
              <option value="9">9</option>
              <option value="10">10（并行上限）</option>
