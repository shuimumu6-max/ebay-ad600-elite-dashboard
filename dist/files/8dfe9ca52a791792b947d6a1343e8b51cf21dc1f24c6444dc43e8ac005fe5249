<div class="toast" id="toast"></div>

<script>
const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const state = { form: {}, running: false, startedAt: 0, timer: null, defaults: null };

function toast(msg, bad){
  const el = $('#toast');
  el.textContent = msg;
  el.className = 'toast on' + (bad ? ' bad' : '');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.className = 'toast', 3200);
}

/* ---------- 吸顶：量顶栏高度给右侧栏留位，滚动时补分隔线 ---------- */
const topbarEl = $('#topbar');
const rootEl = document.documentElement;
let topbarH = 0;
function measureTopbar(){
  const h = topbarEl.offsetHeight;
  if (h && h !== topbarH){ topbarH = h; rootEl.style.setProperty('--topbar-h', h + 'px'); }
}
function markStuck(){
  topbarEl.classList.toggle('stuck', (window.scrollY || document.documentElement.scrollTop) > 4);
}
measureTopbar(); markStuck();
if (window.ResizeObserver) new ResizeObserver(measureTopbar).observe(topbarEl);
window.addEventListener('scroll', markStuck, { passive: true });
window.addEventListener('resize', () => { measureTopbar(); markStuck(); });

/* ---------- 分段控件 ---------- */
function seg(el, onChange){
  el.addEventListener('click', e => {
    const btn = e.target.closest('button');
    if (!btn) return;
    $$('#' + el.id + ' button').forEach(b => b.classList.toggle('on', b === btn));
    onChange && onChange(btn.dataset.v);
  });
  return () => el.querySelector('button.on')?.dataset.v;
}

/* ---------- 选项状态 ---------- */
const trafficMode = seg($('#segTraffic'), v => {
  $('#fTrafficDate').hidden = v === 'batch';
  const isRange = v === 'range' || v === 'both';
  $('#fRangeStart').hidden = !isRange;
  $('#fRangeEnd').hidden = !isRange;
  $('#fBatch').hidden = v !== 'batch';
  $('#lbTrafficDate').textContent = '统计日期（太平洋时间）';
  const map = {
    daily: '下载指定单日的流量明细（一条记录一天）。',
    range: '下载从起始日到结束日的累计流量明细（每天一行）。',
    both: '单日和累计各下一份，共 2 个文件。',
    batch: '按天逐个下载，每天都单独校验日期，慢一些但最稳。'
  };
  $('#hintTraffic').textContent = map[v];
  $('#subTraffic').textContent = { daily: '单日', range: '累计区间', both: '2 份', batch: '逐日' }[v];
});

// eBay 报表中心的日期范围跟着时间粒度变（2026-11-08 实测）：
//   按日 → 只有 今天 / 昨天 / 本周 / 上周；
//   汇总 → 才放开 本月 / 上月 / 过去 90 天（自定义范围只在汇总粒度下存在，控制台不提供）。
const RANGE_DAILY_ONLY = ['', 'TODAY', 'YESTERDAY', 'CURRENTWEEK', 'LASTWEEK'];
function syncRangeOptions(selId, unit){
  const sel = $(selId);
  if (!sel) return;
  [...sel.options].forEach(o => {
    const ok = unit !== 'DAILY' || RANGE_DAILY_ONLY.includes(o.value);
    o.hidden = !ok;
    o.disabled = !ok;
  });
  if (unit === 'DAILY' && !RANGE_DAILY_ONLY.includes(sel.value)) sel.value = 'CURRENTWEEK';
}

const plgUnit = seg($('#segUnit'), v => syncRangeOptions('#plgRange', v));
const activeTypeSeg = seg($('#segActive'), () => {});
const priorityUnitSeg = seg($('#segPriorityUnit'), v => syncRangeOptions('#priorityRange', v));

// 活动多选：从服务端拿真实活动列表渲染（名称去掉 US.TD.PLG. 前缀，太长）
function renderPlgCampaigns(list){
  const box = $('#plgCampaigns');
  if (!Array.isArray(list) || !list.length){
    box.innerHTML = '<span class="chip on">报表中心默认全部活动</span>';
    return;
  }
  box.innerHTML = list.map(c => {
    const short = String(c.name || c.id).replace(/^US\.TD\.PLG\./i, '');
    return `<label class="chip on" title="${c.name}"><input type="checkbox" value="${c.id}" checked>${short}</label>`;
  }).join('');
  syncChips('plgCampaigns');
}

// 日期范围选择器：控制台只提供预设（今天/昨天/本周/上周/本月/上月/过去 90 天）。
// 自定义区间已下线——日期输入框保留在隐藏容器里，只用于一键补齐回填与 CLI 回退读值。

// 单选 chips（订单类型 / 优先促刊类型）：点哪个哪个亮，只有一个选中
function renderSingleChips(boxSel, items, name, onPick){
  const box = $(boxSel);
  if (!Array.isArray(items) || !items.length) return;
  box.innerHTML = items.map((it, i) => {
    // mvp=false：骨架已接、尚未实测稳定，标出来免得当成已验证的下载项
    const dim = it.mvp === false ? ' dim' : '';
    const tip = it.mvp === false ? ' title="骨架已接，尚未实测稳定，暂不保证下载成功率"' : '';
    return `<label class="chip${i === 0 ? ' on' : ''}${dim}"${tip}><input type="radio" name="${name}" value="${it.key}"${i === 0 ? ' checked' : ''}><span class="lbl">${it.label}</span>${it.mvp === false ? '<i class="todo">待验证</i>' : ''}</label>`;
  }).join('');
  box.addEventListener('change', () => {
    $$(boxSel + ' .chip').forEach(c => c.classList.toggle('on', c.querySelector('input').checked));
    onPick && onPick();
  });
}

// 多选 chips（优先促刊报表类型）：可同时勾多种，选中的会在任务队列里排队逐类下载
function renderMultiChips(boxSel, items, onPick){
  const box = $(boxSel);
  if (!Array.isArray(items) || !items.length) return;
  box.innerHTML = items.map(it => {
    const dim = it.mvp === false ? ' dim' : '';
    return `<label class="chip on${dim}"><input type="checkbox" value="${it.key}" checked><span class="lbl">${it.label}</span></label>`;
  }).join('');
  box.addEventListener('change', () => {
    $$(boxSel + ' .chip').forEach(c => c.classList.toggle('on', c.querySelector('input').checked));
    onPick && onPick();
  });
}

/* ---------- 活动多选下拉：31 个活动不铺开，收起时只显示一行摘要 ---------- */
let prCampaigns = [];
let prDefaultIds = [];
const prBox = $('#priorityCampaigns');
const prPanel = $('#prCampaignPanel');
const prBtn = $('#prCampaignBtn');
const escAttr = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

function shortName(name){
  const s = String(name || '').replace(/^US\.\s*TD\.?\s*/i, '').replace(/\s+/g, ' ').trim();
  return s.length > 34 ? s.slice(0, 33) + '…' : s;
}
function prChecked(){ return $$('#priorityCampaigns input:checked').map(i => i.value); }
function prUpdate(){
  const picked = prChecked();
  const names = prCampaigns.filter(c => picked.includes(c.id)).map(c => shortName(c.name));
  // 一个都不勾 = 不传活动参数 = 报表中心后台的全部活动，这是默认状态
  $('#prCampaignCount').textContent = picked.length ? `已选 ${picked.length} / ${prCampaigns.length}` : '全部活动';
  const isDefault = picked.length === prDefaultIds.length && prDefaultIds.every(id => picked.includes(id));
  $('#prCampaignSummary').textContent = !picked.length
    ? '全部活动（不用选）'
    : isDefault
      ? `已选 ${picked.length} 个活动 · 默认组合`
      : `已选 ${picked.length} 个活动 · ${names.slice(0, 2).join('、')}${names.length > 2 ? ` 等 ${names.length} 个` : ''}`;
  $$('#priorityCampaigns .dd-opt').forEach(l => l.classList.toggle('on', l.querySelector('input').checked));
}
function renderPriorityCampaigns(list, defaultIds){
  prCampaigns = Array.isArray(list) ? list : [];
  prDefaultIds = Array.isArray(defaultIds) ? defaultIds : [];
  prBox.innerHTML = prCampaigns.map(c => `<label class="dd-opt" data-name="${escAttr(String(c.name).toLowerCase())}" title="${escAttr(c.name)}">
      <input type="checkbox" value="${escAttr(c.id)}"${prDefaultIds.includes(c.id) ? ' checked' : ''}>
      ${c.plp ? '<span class="plp">PLP</span>' : ''}<span class="nm">${escAttr(c.name)}</span>
    </label>`).join('') || '<div class="dd-empty">不用选：留空就是报表中心后台的全部活动<br><span class="dim">想让活动显示成名字，点上方「刷新活动列表」（只读扫描，几十秒）</span></div>';
  prUpdate();
}
function prToggle(open){
  const on = typeof open === 'boolean' ? open : prPanel.hidden;
  prPanel.hidden = !on;
  prBtn.classList.toggle('on', on);
  prBtn.setAttribute('aria-expanded', String(on));
}
prBtn.addEventListener('click', () => prToggle());
$('#prCampaignDone').addEventListener('click', () => prToggle(false));

// 刷新活动列表：只读扫描报表中心 Campaigns 卡片，把活动名填进下拉框。
// 不点也完全能用——留空就是后台全部活动；这一步只是让名字好看、方便只挑主力活动。
$('#prRefresh').addEventListener('click', async () => {
  const btn = $('#prRefresh');
  if (btn.dataset.busy) return;
  btn.dataset.busy = '1';
  btn.textContent = '扫描中…';
  toast('正在扫描报表中心的活动列表（只读，不提交任何下载），约 30 秒');
  try {
    const r = await (await fetch('/api/auto-scan', { method: 'POST' })).json();
    if (!r.ok) throw new Error(r.error || '扫描没启动');
  } catch (error) {
    btn.textContent = '刷新活动列表';
    delete btn.dataset.busy;
    toast(error.message, true);
  }
});

/* ---------- 首次使用：一键下最近 30 天，让看板一打开就有数据 ---------- */
$('#btnFirstRun').addEventListener('click', async () => {
  const btn = $('#btnFirstRun');
  btn.disabled = true;
  btn.textContent = '正在启动…';
  try {
    const r = await (await fetch('/api/first-run', {
      method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ days: 30 })
    })).json();
    if (!r.ok) throw new Error(r.error || '启动失败');
    $('#firstRun').hidden = true;
    toast('已开始下载最近 30 天数据，进度看下方日志（约 20~30 分钟）');
  } catch (error) {
    toast(error.message, true);
    btn.disabled = false;
    btn.textContent = '自动下载最近 30 天';
  }
});
$('#btnFirstRunSkip').addEventListener('click', () => {
  sessionStorage.setItem('firstRunSkip', '1');
  $('#firstRun').hidden = true;
});

/* ---------- 看板模式：online = 维护者本机（能推 GitHub Pages）；local = 发给运营的包 ---------- */
/* local 模式下没有「线上看板」这个概念：数据只在本机，按钮直接打开本地看板 */
let dashboardMode = 'online';
function applyDashboardMode(){
  const local = dashboardMode === 'local';
  const link = $('#linkDash');
  if (link){
    link.textContent = local ? '打开本机看板 ↗' : '在线看板 ↗';
    link.title = local ? '数据只在这台电脑上，点这里打开看板' : '打开线上看板';
  }
  const btnPub = $('#btnPublish');
  if (btnPub){
    btnPub.textContent = local ? '打开看板' : '只更新看板';
    btnPub.title = local
      ? '数据已经在 数据 目录，点这里打开看板（报表会自动加载）'
      : '用正式目录里已归档的数据重新生成 data.js 并推送 GitHub Pages';
  }
  const pub = $('#btnArchivePublish');
  if (pub) pub.textContent = local ? '归档 + 打开看板' : '归档 + 更新看板';
}
async function openLocalDashboard(){
  const r = await (await fetch('/api/open-dashboard', { method: 'POST' })).json();
  if (!r.ok) return toast(r.error || '打开看板失败', true);
  toast('已打开看板，报表会自动加载；想补文件也可以直接拖进页面');
}
// 顶栏「看板」链接：线上模式是普通外链；本地模式改成打开本机看板
$('#linkDash')?.addEventListener('click', e => {
  if (dashboardMode !== 'local') return;
  e.preventDefault();
  openLocalDashboard();
});

/* ---------- 店铺名：不用填，能从浏览器读就读；读不到再随手起个名 ---------- */
let shopPlaceholder = false;
function renderShopName(name, placeholder){
  const txt = $('#txtShop');
  if (!txt) return;
  shopPlaceholder = placeholder === undefined ? (!name || name === '我的店铺') : !!placeholder;
  txt.textContent = name || '我的店铺';
  txt.title = shopPlaceholder
    ? '还没识别店铺名：点右边「识别」从浏览器读（只读，几秒）'
    : `当前店铺：${name}（点右边「改名」可改，只影响显示）`;
  const btn = $('#btnShopName');
  if (btn){
    btn.textContent = shopPlaceholder ? '识别' : '改名';
    btn.title = shopPlaceholder ? '从浏览器读店铺名，不用手填' : '只是个显示名，随时能改';
  }
}
async function saveShopName(name){
  const r = await (await fetch('/api/shop-name', {
    method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name })
  })).json();
  if (!r.ok) throw new Error(r.error || '改名失败');
  renderShopName(r.name, false);
  return r.name;
}
$('#btnShopName').addEventListener('click', async () => {
  // 还没识别过：先只读读一次浏览器（不碰活动、不下载）
  if (shopPlaceholder){
    const btn = $('#btnShopName');
    const label = btn.textContent;
    btn.disabled = true;
    btn.textContent = '识别中…';
    toast('正在从浏览器读取店铺名（只读，几秒）…');
    try {
      const d = await (await fetch('/api/detect-shop', { method: 'POST' })).json();
      if (d.ok && d.name){ renderShopName(d.name, false); toast(`店铺已识别：${d.name}`); return; }
      throw new Error(d.error || '没读到店铺名');
    } catch (error){
      toast(`${error.message}｜也可以直接填一个`, true);
    } finally {
      btn.disabled = false;
      if (shopPlaceholder) btn.textContent = label;
    }
  }
  const cur = $('#txtShop').textContent.trim();
  const next = prompt('店铺名（只是个显示名，随便填，随时能改）', cur === '我的店铺' ? '' : cur);
  if (next === null) return;
  try {
    toast(`店铺名已改为「${await saveShopName(next)}」`);
  } catch (error) { toast(error.message, true); }
});
document.addEventListener('click', e => { if (!e.target.closest('#prCampaignDD')) prToggle(false); });
$('#prCampaignSearch').addEventListener('input', e => {
  const q = e.target.value.trim().toLowerCase();
  $$('#priorityCampaigns .dd-opt').forEach(l => { l.hidden = q ? !l.dataset.name.includes(q) : false; });
});
$('#prPickPlp').addEventListener('click', () => {
  $$('#priorityCampaigns input').forEach(i => { i.checked = prDefaultIds.includes(i.value); });
  prUpdate();
});
$('#prPickAll').addEventListener('click', () => {
  $$('#priorityCampaigns input').forEach(i => { i.checked = true; });
  prUpdate();
});
$('#prPickNone').addEventListener('click', () => {
  $$('#priorityCampaigns input').forEach(i => { i.checked = false; });
  prUpdate();
});
prBox.addEventListener('change', prUpdate);

// 自定义日期区：仅订单卡还在用（eBay 订单页确实有「自定义」选项）。
// 报表中心的 PLG / 优先促刊卡已下线自定义区间，这里容错处理：没有 CUSTOM 选项就直接空转。
function bindCustomRange(selId, f1, f2, startId, endId){
  const sel = $(selId);
  const sync = () => {
    const allowed = !!sel.querySelector('option[value="CUSTOM"]');
    const custom = allowed && sel.value === 'CUSTOM';
    const b1 = $(f1), b2 = $(f2);
    if (b1) b1.hidden = !custom;
    if (b2) b2.hidden = !custom;
    if (!custom) return;
    if (!$(endId).value) $(endId).value = $('#trafficDate').value || '';
    if (!$(startId).value && $(endId).value){
      const d = new Date($(endId).value + 'T00:00:00Z');
      d.setUTCDate(d.getUTCDate() - 6);
      $(startId).value = d.toISOString().slice(0, 10);
    }
  };
  sel.addEventListener('change', sync);
  return sync;
}
const syncOrderRange = bindCustomRange('#orderRange', '#fOrderC1', '#fOrderC2', '#orderCustomStart', '#orderCustomEnd');
const syncPriorityRange = bindCustomRange('#priorityRange', '#fPrC1', '#fPrC2', '#priorityCustomStart', '#priorityCustomEnd');
const syncPlgRange = bindCustomRange('#plgRange', '#fPlgC1', '#fPlgC2', '#plgCustomStart', '#plgCustomEnd');

// 卡片右上角副标题：订单单选、优先促刊多选（显示几类在排队）
function updateSubLabels(){
  const ot = $$('#orderTypes input:checked')[0];
  $('#subOrders').textContent = ot ? ot.closest('.chip').textContent.trim() : '';
  const pts = $$('#priorityTypes input:checked');
  $('#subPriority').textContent = pts.length === 0 ? '未选类型'
    : pts.length === 1 ? pts[0].closest('.chip').textContent.trim()
    : `${pts.length} 类排队下载`;
}

function syncChips(sel){
  $$('#' + sel + ' .chip').forEach(chip => {
