/* ---------- 点缺口标签，直接填进下载表单 ---------- */
function pickSeg(id, value){
  const btn = document.querySelector(`#${id} button[data-v="${value}"]`);
  if (btn && !btn.classList.contains('on')) btn.click();
}

// 缺口补齐只能落到预设范围上（自定义区间已下线）：挑能盖住缺口的最小预设
function gapRange(s, e){
  const fmt = d => d.toISOString().slice(0, 10);
  const shift = (d, n) => { const x = new Date(d); x.setUTCDate(x.getUTCDate() + n); return x; };
  const monday = d => shift(d, -(((d.getUTCDay() + 6) % 7)));
  const base = $('#trafficDate').value || fmt(new Date());
  const today = new Date(base + 'T00:00:00Z');
  const w0 = monday(today);
  const cands = [
    ['TODAY', '今天', today, today],
    ['YESTERDAY', '昨天', shift(today, -1), shift(today, -1)],
    ['CURRENTWEEK', '本周', w0, shift(w0, 6)],
    ['LASTWEEK', '上周', shift(w0, -7), shift(w0, -1)],
    ['CURRENTMONTH', '本月', new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 1)),
      new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() + 1, 0))],
    ['PREVIOUSMONTH', '上月', new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth() - 1, 1)),
      new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), 0))],
    ['LAST90D', '过去 90 天', shift(today, -89), today]
  ];
  for (const [v, label, a, b] of cands){
    const lo = fmt(a), hi = fmt(b);
    if (s >= lo && e <= hi) return { v, label };
  }
  return null;
}

function applyGap(key, start, end){
  const s = start, e = end && end !== 'undefined' ? end : start;
  const turnOn = (id, card) => {
    const en = $(id);
    if (!en.checked){ en.checked = true; en.dispatchEvent(new Event('change')); }
    $(card).classList.remove('off');
  };
  if (key === 'trafficDaily'){
    turnOn('#enTraffic', '#cardTraffic');
    pickSeg('segTraffic', 'batch');
    $('#batchDates').value = s === e ? s : `${s}..${e}`;
    $('#fTrafficDate').hidden = true;
    $('#fRangeStart').hidden = true;
    $('#fBatch').hidden = false;
    toast(`流量已切到批量多日：${s === e ? s : s + ' ~ ' + e}`);
    $('#cardTraffic').scrollIntoView({ behavior: 'smooth', block: 'center' });
  } else if (key === 'trafficRange'){
    turnOn('#enTraffic', '#cardTraffic');
    pickSeg('segTraffic', 'range');
    $('#rangeStart').value = s;
    $('#rangeEnd').value = e;
    $('#fTrafficDate').hidden = false;
    $('#fRangeStart').hidden = false;
    $('#fRangeEnd').hidden = false;
    $('#fBatch').hidden = true;
    toast(`流量已切到累计区间：${s} 起，${e} 止`);
    $('#cardTraffic').scrollIntoView({ behavior: 'smooth', block: 'center' });
  } else if (key === 'plg'){
    turnOn('#enPlg', '#cardPlg');
    const r = gapRange(s, e);
    if (!r) { toast(`缺口 ${s}${e !== s ? ' ~ ' + e : ''} 超出预设范围（最多过去 90 天），请到后台手动选`); return; }
    $('#plgRange').value = r.v;
    $('#plgCustomStart').value = s;
    $('#plgCustomEnd').value = e;
    toast(`PLG 已切到「${r.label}」，覆盖缺口 ${s}${e !== s ? ' ~ ' + e : ''}`);
    $('#cardPlg').scrollIntoView({ behavior: 'smooth', block: 'center' });
  } else if (key.startsWith('plp')){
    // PLP 已并入「优先促销刊登」：一键补齐 = 切到能覆盖缺口的预设范围 + 对应类型
    turnOn('#enPriority', '#cardPriority');
    const r = gapRange(s, e);
    if (!r) { toast(`缺口 ${s}${e !== s ? ' ~ ' + e : ''} 超出预设范围（最多过去 90 天），请到后台手动选`); return; }
    $('#priorityRange').value = r.v;
    $('#priorityCustomStart').value = s;
    $('#priorityCustomEnd').value = e;
    const want = key === 'plpKeyword' ? 'keyword' : key === 'plpSearch' ? 'search' : 'listing';
    $$('#priorityTypes input').forEach(i => { i.checked = i.value === want; });
    $$('#priorityTypes .chip').forEach(c => c.classList.toggle('on', c.querySelector('input').checked));
    updateSubLabels();
    toast(`PLP 已切到「${r.label}」，类型 ${want}，覆盖缺口 ${s}${e !== s ? ' ~ ' + e : ''}`);
    $('#cardPriority').scrollIntoView({ behavior: 'smooth', block: 'center' });
  } else {
    toast('这一类暂不支持一键补齐，按区间手动选一下');
    return;
  }
  updateEstimate();
}

$('#scanBody').addEventListener('click', e => {
  const chip = e.target.closest('.gapchip');
  if (!chip) return;
  applyGap(chip.dataset.key, chip.dataset.s, chip.dataset.e);
});

/* ---------- 本次预计产出多少份 ---------- */
function expandDates(text){
  const s = String(text || '').trim();
  if (!s) return [];
  const out = [];
  for (const part of s.split(/[,，\s]+/).filter(Boolean)){
    const m = /^(\d{4}-\d{2}-\d{2})\s*\.\.\s*(\d{4}-\d{2}-\d{2})$/.exec(part);
    if (m){
      const a = Date.parse(m[1] + 'T00:00:00Z');
      const b = Date.parse(m[2] + 'T00:00:00Z');
      for (let t = a; t <= b && out.length < 400; t += 86400000) out.push(new Date(t).toISOString().slice(0, 10));
    } else if (/^\d{4}-\d{2}-\d{2}$/.test(part)) out.push(part);
  }
  return out;
}

function estimateCount(){
  const f = collect();
  let n = 0;
  if (f.trafficMode === 'daily' || f.trafficMode === 'range') n += 1;
  else if (f.trafficMode === 'both') n += 2;
  else if (f.trafficMode === 'batch') n += Math.max(1, expandDates(f.batchDates).length);
  if (f.plg) n += 1;
  if (f.active) n += 1;
  if (f.orders) n += 1;
  if (f.priority) n += (f.priorityTypes || []).length || 1;
  return n;
}

function updateEstimate(){
  try{
    const n = estimateCount();
    const tabs = Number($('#maxTabs')?.value || 4);
    $('#planSub').textContent = n
      ? `预计 ${n} 份 · 最多并行 ${tabs} 个标签页，多出的任务自动排队`
      : '还没选报表';
    $('#planSub').style.color = n ? '' : 'var(--err)';
  } catch { /* 表单未就绪先不管 */ }
}

document.addEventListener('change', () => setTimeout(updateEstimate, 0));
document.addEventListener('click', () => setTimeout(updateEstimate, 0));
document.addEventListener('keydown', e => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter' && !$('#btnRun').disabled) $('#btnRun').click();
});
updateEstimate();

refreshState();
setInterval(() => { if (!state.running) refreshState(); }, 5000);

/* ==================== 字段字典 ==================== */
let catalog = null;
let curReportId = null;

async function loadCatalog(){
  if (catalog) return catalog;
  const r = await (await fetch('/api/catalog')).json();
  if (!r.ok) throw new Error(r.error || '读不到报表注册表');
  catalog = r;
  return catalog;
}

// 视图切换
function setView(v){
  $$('#viewTabs button').forEach(b => b.classList.toggle('on', b.dataset.view === v));
  $('#viewDownload').hidden = v !== 'download';
  $('#viewFields').hidden = v !== 'fields';
  if (v === 'fields') openFields();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
$$('#viewTabs button').forEach(b => b.addEventListener('click', () => setView(b.dataset.view)));

const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const GSHORT = { traffic: '流量', orders: '订单', listings: '刊登', plg: 'PLG', marketing: '优先' };

function csvChips(list, verified){
  if (!verified) return '<span class="none">—</span>';
  if (!list || !list.length) return '<span class="none">—</span>';
  return list.map(c => `<span class="c">${esc(c)}</span>`).join('');
}

let fieldsReady = false;
function ensureFieldsReady(){
  if (fieldsReady || !catalog) return;
  fieldsReady = true;
  $('#fldCount').textContent = `${DIR_GROUPS.length} 类 / ${catalog.reports.length} 个`;
  renderReportList();
  injectFieldLinks();
  const first = catalog.reports.find(r => r.group === 'orders') || catalog.reports[0];
  selectReport(first.id);
}

async function openFields(){
  try {
    await loadCatalog();
    ensureFieldsReady();
  } catch (e){
    $('#fldBody').innerHTML = `<div class="empty">读不到注册表：${esc(e.message)}</div>`;
  }
}

// 目录口径 = 下载视图的 5 张卡片，名称一一对应；备注写后台里的别名（PLP链接广告等）
// 顺序 = 下载视图 5 张卡片从上到下的顺序（业务优先级），左右对照不用找
const DIR_GROUPS = [
  { key: 'traffic',   name: '流量报表',     remark: 'Traffic',          groups: ['traffic'] },
  { key: 'plg',       name: 'PLG 链接广告', remark: '促销刊登 · 常规',   groups: ['plg'] },
  { key: 'listings',  name: '商品名单',     remark: '物品刊登',          groups: ['listings'] },
  { key: 'marketing', name: '优先促销刊登', remark: 'PLP链接广告',       groups: ['marketing'] },
  { key: 'orders',    name: '订单报表',     remark: '9 种订单',          groups: ['orders'] }
];
const dirCollapsed = new Set();

function renderReportList(){
  const c = catalog;
  let html = '';
  for (const g of DIR_GROUPS){
    const list = c.reports.filter(r => g.groups.includes(r.group));
    if (!list.length) continue;
    const folded = dirCollapsed.has(g.key);
    html += `<button type="button" class="fld-group${folded ? ' collapsed' : ''}" data-g="${g.key}">
        <span class="caret">▾</span><span class="gname">${esc(g.name)}</span>
        ${g.remark ? `<span class="gremark">${esc(g.remark)}</span>` : ''}
        <span class="gcnt">${list.length} 类</span></button>`;
    html += `<div class="fld-items" data-g="${g.key}"${folded ? ' hidden' : ''}>`;
    for (const r of list){
      html += `<button class="fld-item${r.id === curReportId ? ' on' : ''}" data-id="${esc(r.id)}">
        <span>${esc(r.label)}</span><span class="n">${r.columns.length}</span></button>`;
    }
    html += '</div>';
  }
  $('#fldReports').innerHTML = html;
  $$('#fldReports .fld-group').forEach(b => b.addEventListener('click', () => {
    const k = b.dataset.g;
    if (dirCollapsed.has(k)) dirCollapsed.delete(k); else dirCollapsed.add(k);
    const folded = dirCollapsed.has(k);
    b.classList.toggle('collapsed', folded);
    const items = document.querySelector(`#fldReports .fld-items[data-g="${k}"]`);
    if (items) items.hidden = folded;
  }));
  $$('#fldReports .fld-item').forEach(b => b.addEventListener('click', () => selectReport(b.dataset.id)));
}

// 从卡片「N 字段 ›」跳过来时，若目标分组被折叠就自动展开，别让用户找不到
function revealGroupOf(reportId){
  const r = catalog?.reports.find(x => x.id === reportId);
  if (!r) return;
  const g = DIR_GROUPS.find(x => x.groups.includes(r.group));
  if (!g || !dirCollapsed.has(g.key)) return;
  dirCollapsed.delete(g.key);
  const head = document.querySelector(`#fldReports .fld-group[data-g="${g.key}"]`);
  const items = document.querySelector(`#fldReports .fld-items[data-g="${g.key}"]`);
  head?.classList.remove('collapsed');
  if (items) items.hidden = false;
}

function selectReport(id){
  if (!catalog) return;
  const r = catalog.reports.find(x => x.id === id);
  if (!r) return;
  curReportId = id;
  revealGroupOf(id);
  $('#fldSearch').value = '';
  $$('#fldReports .fld-item').forEach(b => b.classList.toggle('on', b.dataset.id === id));
  // 分组名和报表名相同时不重复（如 PLG 链接广告）
  $('#fldTitle').textContent = r.groupLabel === r.label ? r.label : `${r.groupLabel} · ${r.label}`;
  $('#fldSub').textContent = `${r.columns.length} 个字段`;
  $('#btnCopyFields').hidden = false;

  const meta = [
    `<span class="mchip">来源 <b>${esc(r.source)}</b></span>`,
    r.strategy ? `<span class="mchip">策略 <b>${esc(r.strategy)}</b></span>` : '',
    `<span class="mchip">Type <b>${esc(r.type)}</b></span>`,
    r.hasCampaigns ? '<span class="mchip">可选活动</span>' : '',
    r.timeUnit ? '<span class="mchip">粒度 按日/汇总</span>' : '',
    r.rangeKind ? '<span class="mchip">日期范围可选</span>' : '',
    `<span class="mchip">归档 <b>${esc(r.folder)}</b></span>`,
    r.csvVerified
      ? '<span class="mchip ok">CSV 列名已核对</span>'
      : '<span class="mchip todo">CSV 列名待核对</span>'
  ].filter(Boolean).join('');

  const rows = r.columns.map(f => `<tr>
      <td><span class="fname">${esc(f.name)}</span></td>
      <td><span class="fgrp">${esc(f.groupLabel)}</span></td>
      <td><div class="fcsv">${csvChips(f.csv, r.csvVerified)}</div>
        ${f.note ? `<div class="fnote">${esc(f.note)}</div>` : ''}</td>
    </tr>`).join('');

  const extra = r.extraCsv && r.extraCsv.length
    ? `<div class="fblock">
         <div class="fblock-t">文件里还有这些列（页面未列出，报表中心统一写作 Additional columns）</div>
         <div class="fcsv">${r.extraCsv.map(c => `<span class="c">${esc(c)}</span>`).join('')}</div>
       </div>`
    : '';

  $('#fldBody').innerHTML = `
    <div class="fld-meta">${meta}</div>
    ${r.note ? `<p class="hint" style="margin:0 0 10px">${esc(r.note)}</p>` : ''}
    <table class="ftable">
      <thead><tr><th style="width:270px">报表中心字段（${esc(r.columnsTitle)}）</th>
        <th style="width:86px">分组</th><th>对应 CSV 列名</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>
    ${extra}`;
  $('#btnCopyFields').onclick = () => copyReport(r);
}

function copyReport(r){
  const lines = [
    `### ${r.groupLabel} · ${r.label}`,
    '',
    `- 来源：${r.source}${r.strategy ? ` / 策略 ${r.strategy}` : ''} / Type ${r.type}`,
    `- 归档目录：${r.folder}`,
    `- CSV 列名核对：${r.csvVerified ? '已核对' : '待核对'}`,
    '',
    '| 字段 | 分组 | 对应 CSV 列 |',
    '| --- | --- | --- |'
  ];
  for (const f of r.columns){
    const csv = r.csvVerified ? (f.csv.length ? f.csv.join(' + ') : '（无同名裸列）') : '待核对';
    lines.push(`| ${f.name} | ${f.groupLabel} | ${csv} |`);
  }
  if (r.extraCsv && r.extraCsv.length){
    lines.push('', `**文件里还有：** ${r.extraCsv.join(' / ')}`);
  }
  const text = lines.join('\n');
  navigator.clipboard?.writeText(text).then(
    () => toast('已复制该报表的字段表'),
    () => toast('复制失败，检查浏览器权限', true)
  );
}

// 跨报表搜字段：看同一个字段出现在哪些报表、各自对应哪列
function searchFields(q){
  const kw = q.trim().toLowerCase();
  if (!kw){ renderReportList(); return; }
  const hits = catalog.fields.filter(f =>
    f.name.toLowerCase().includes(kw) || f.key.toLowerCase().includes(kw)
  );
  $('#fldTitle').textContent = `搜索结果：${q}`;
  $('#fldSub').textContent = `${hits.length} 个字段`;
  $('#btnCopyFields').hidden = true;
  if (!hits.length){
    $('#fldBody').innerHTML = '<div class="empty">没有匹配的字段</div>';
    return;
  }
  $('#fldBody').innerHTML = '<div class="hits">' + hits.map(f => `
    <div class="hit">
      <div class="hit-h"><span class="fname">${esc(f.name)}</span>
        <span class="fgrp">${esc(f.groupLabel)}</span>
        <span class="n" style="margin-left:auto;font-size:11.5px;color:var(--ink-3)">${f.reports.length} 个报表</span></div>
      <div class="hit-r">${f.reports.map(r => `
        <div class="r"><b>${esc(r.label)}</b><span class="gtag">${esc(GSHORT[r.group] || r.group)}</span><span class="fcsv">${r.verified
          ? (r.csv.length ? r.csv.map(c => `<span class="c">${esc(c)}</span>`).join('') : '<span class="none">无同名裸列</span>')
          : '<span class="none">待核对</span>'}</span></div>`).join('')}</div>
    </div>`).join('') + '</div>';
}

$('#fldSearch').addEventListener('input', e => searchFields(e.target.value));

// 下载页的卡片上加「N 字段」入口
const CARD_REPORT = {
  cardTraffic: 'traffic.daily',
  cardPlg: 'marketing.plg.listing',
  cardActive: 'listings.active',
  cardOrders: 'orders.all',
  cardPriority: 'marketing.priority.listing'
};
function injectFieldLinks(){
  for (const [cardId, reportId] of Object.entries(CARD_REPORT)){
    const card = document.getElementById(cardId);
    const head = card?.querySelector('.card-h');
    const r = catalog?.reports.find(x => x.id === reportId);
    if (!head || !r || head.querySelector('.flink')) continue;
    const btn = document.createElement('button');
    btn.className = 'flink';
    btn.dataset.report = reportId;
    btn.textContent = `${r.columns.length} 字段 ›`;
    btn.title = `查看「${r.groupLabel} · ${r.label}」的字段清单`;
    btn.addEventListener('click', () => {
      const id = btn.dataset.report;
      setView('fields');
      openFields().then(() => selectReport(id));
    });
    const sw = head.querySelector('.sw');
    if (sw) head.insertBefore(btn, sw); else head.appendChild(btn);
  }
}

// 卡片上的字段入口跟着当前选的类型走：换订单类型 / 名单类型 / 优先促刊类型，入口就指到对应报表
function updateFieldLink(cardId, reportId){
  if (!catalog) return;
  const btn = document.getElementById(cardId)?.querySelector('.flink');
  const r = catalog.reports.find(x => x.id === reportId);
  if (!btn || !r) return;
  btn.dataset.report = reportId;
  btn.textContent = `${r.columns.length} 字段 ›`;
  btn.title = `查看「${r.groupLabel} · ${r.label}」的字段清单`;
}
document.addEventListener('change', () => {
  if (!catalog) return;
  const pr = document.querySelector('#cardPriority input[type=radio]:checked');
  if (pr) updateFieldLink('cardPriority', `marketing.priority.${pr.value}`);
  const ac = document.querySelector('#cardActive input[type=radio]:checked');
  if (ac) updateFieldLink('cardActive', `listings.${ac.value}`);
});
// 名单类型是分段按钮，不是 radio
$$('#segActive button').forEach(b => b.addEventListener('click', () => {
  updateFieldLink('cardActive', `listings.${b.dataset.v}`);
}));

// 预加载注册表：切到字段页瞬时可用，下载页卡片也能立刻出现「N 字段」入口
loadCatalog().then(ensureFieldsReady).catch(() => {});
</script>
