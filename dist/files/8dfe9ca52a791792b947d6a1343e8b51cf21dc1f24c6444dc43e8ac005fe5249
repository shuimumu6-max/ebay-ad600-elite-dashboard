/* ---------- 结果渲染 ---------- */
function resetSummary(){
  $('#stats').innerHTML = `
    <div class="stat"><b>–</b><span>文件</span></div>
    <div class="stat"><b>–</b><span>有效</span></div>
    <div class="stat"><b>–</b><span>耗时</span></div>`;
  $('#lastAt').textContent = '';
  $('#files').innerHTML = '<div class="empty">本次还没有结果</div>';
}

function renderSummary(s){
  const c = s.counts || {};
  const secs = Math.round((s.totalMs || 0) / 1000);
  $('#stats').innerHTML = `
    <div class="stat"><b>${c.total ?? '–'}</b><span>文件</span></div>
    <div class="stat"><b>${c.valid ?? '–'}</b><span>有效</span></div>
    <div class="stat"><b>${secs}s</b><span>耗时</span></div>`;
  $('#lastAt').textContent = s.runId || '';
  const files = s.files || [];
  if (!files.length){ $('#files').innerHTML = '<div class="empty">本次没抓到文件</div>'; return; }
  const shortFolder = name => (name || '')
    .replace(/^\d+-/, '')
    .replace('Traffic单日', '流量单日').replace('Traffic累计', '流量累计')
    .replace('PLG链接广告', 'PLG 链接').replace('PLP链接广告', 'PLP 链接')
    .replace('PLP关键词', 'PLP 关键词').replace('PLP搜索词', 'PLP 搜索词')
    .replace('在售商品名单', '在售名单').replace('待核验', '待核验');
  $('#files').innerHTML = files.map(f => `
    <div class="fitem">
      <div class="fmeta">
        ${f.valid ? '<span class="okmark">通过</span>' : '<span class="badmark">注意</span>'}
        <span class="ftag">${escapeHtml(shortFolder(f.folder))}</span>
        ${f.rowCount != null ? `<span>${f.rowCount} 行</span>` : ''}
        ${f.size ? `<span>${Math.round(f.size / 1024)} KB</span>` : ''}
      </div>
      <div class="fname">${escapeHtml(f.name)}</div>
      ${f.problem ? `<div class="fproblem">${escapeHtml(f.problem)}</div>` : ''}
    </div>`).join('');
}
function escapeHtml(s){ return String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

