});

es.addEventListener('run', e => {
  const data = JSON.parse(e.data);
  if (data.phase === 'start'){
    // 新一轮下载开始：上次的结果不是本次的，先清掉，免得上轮文件被当成本轮产出
    if (data.mode !== 'publish') resetSummary();
    return;
  }
  // 逐天补齐：每天之间停一会儿再跑下一天，这期间保持「运行中」，不弹完成提示
  if (data.phase === 'gap'){
    const sec = Math.round((data.waitMs || 0) / 1000);
    $('#txtRun').textContent = `等待中 ${sec}s`;
    $('#runHint').textContent = `第 ${data.index - 1}/${data.total} 步已完成，${sec} 秒后继续：${data.next}`;
    return;
  }
  if (data.phase === 'seq-end'){
    // 多步任务（首次初始化 / 一键补齐）的最后一步是更新看板，没有下载 summary，
    // 所以「有几步没成」由后端单独推过来，这里给出唯一的最终结论。
    const n = (data.failures || []).length;
    if (n) toast(`${data.label}结束：${n} 项没下完，已下好的都已归档。详情看日志；过 1 小时可点「补齐缺口」接着补`, true);
    else toast(`${data.label}完成，数据已归档，可以打开看板了`);
    return;
  }
  if (data.phase === 'end'){
    if (data.queue?.more){
      // 队列里还有下一步：只刷新清单，不停表、不弹「下载完成」
      loadRuns();
      if (data.dataState) renderDataState(data.dataState);
      $('#txtRun').textContent = `已完成 ${data.queue.index}/${data.queue.total} 步`;
      $('#runHint').textContent = `第 ${data.queue.index}/${data.queue.total} 步结束，等一会儿接着跑`;
      return;
    }
    setRunning(false);
    loadRuns();                                   // 跑完 / 归档完都刷新一次运行清单
    if (data.dashboard) $('#linkDash').href = dashboardMode === 'local' ? '#' : data.dashboard;
    if (data.dataState) renderDataState(data.dataState);
    if (data.mode === 'publish'){
      if (dashboardMode === 'local'){
        // 本地看板：没有线上可推，归档完就能看。告诉用户点哪儿，别让他猜。
        if (data.code === 0){
          toast('数据已归档到本机，点右上角「打开看板」就能看到数据');
          const btn = $('#btnPublish');
          if (btn){ btn.classList.add('pulse'); setTimeout(() => btn.classList.remove('pulse'), 6000); }
        } else {
          toast('归档没成功，看日志最后几行', true);
        }
      } else {
        toast(data.code === 0 ? '看板已更新并推送' : '看板更新失败，看日志', data.code !== 0);
      }
      return;
    }
    if (data.summary) renderSummary(data.summary);
    const errs = (data.summary?.errors || []).length;
    const bad = (data.summary?.counts?.invalid || 0);
    if (errs){
      // 只说「有 9 个错误」等于没说：把第一条的核心原因带出来，用户才知道要不要现在处理。
      const first = String((data.summary.errors || [])[0]?.message || '').replace(/^Traffic\s+\S+：/, '');
      const throttled = /限速|没有任何反应|风控/.test(first);
      toast(throttled
        ? `有 ${errs} 项没下完：eBay 在限速，已下的都在。过 1 小时点「补齐缺口」接着补`
        : `有 ${errs} 项没下完：${first.slice(0, 60)}（详情看日志）`, true);
      return;
    }
    toast(bad ? `结束，${bad} 份未通过校验` : '下载完成', !!bad);
  }
});

